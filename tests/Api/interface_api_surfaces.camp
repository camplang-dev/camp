export interface IValue
{
	export int value();
}

export class Counter : IValue
{
	export int value(): IValue
	{
		return 1;
	}
}

export extern class NativeCounter : IValue
{
}

export struct ValueCounter : IValue
{
	export int value(): IValue
	{
		return 2;
	}
}

export int useValue<T: implements IValue>(T* value, vtableof(T: IValue))
{
	return value.value();
}
