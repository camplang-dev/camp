export extern class GenericBox<T: any>
{
	export inline int LIMIT = 8;
	export static int current = 1;

	export extern GenericBox();

	export extern ~GenericBox();

	export extern static int getLimit();

	export extern static nuint sizeOf<U: copyable>(sizeof(U));
}

export struct GenericPair<T: any>
{
	T* value;
	export static int current = 2;
}
