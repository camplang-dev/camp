export interface IJsonArray
{
	export bool tryGet(const this, @index nuint index, overload out int value);
	export bool tryGet(const this, @index nuint index, overload out bool value);
}

export extern class JsonArray: IJsonArray
{
	export extern bool tryGet(const this, @index nuint index, overload out int value): IJsonArray;
	export extern bool tryGet(const this, @index nuint index, overload out bool value): IJsonArray;

	export extern void setElement(@index nuint index, overload int value);
	export extern void setElement(@index nuint index, overload bool value);
	export extern void setElement(@index nuint index, overload string value);
}
