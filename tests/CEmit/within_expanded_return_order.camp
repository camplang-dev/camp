extern void* malloc(nuint size);

struct Allocator
{
	void* alloc(nuint size) => malloc(size);
}

char[] duplicate(const char[] values, within allocator)
{
	char[] copy = new char[values.length];
	return copy;
}

char[] forwardDuplicate(const char[] values, within allocator)
{
	return duplicate(values);
}

export int main()
{
	return 0;
}
