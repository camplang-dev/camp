enum Low { OK = 0, EMPTY }
enum High { OK = 0, BAD }
int trace;
int low(int value, thrown Low error) { trace = trace * 10 + 1; if (value == 0) throw EMPTY; return value; }
int high(int value, thrown High error) { trace = trace * 10 + 2; if (value == 8) throw BAD; return value; }
int sum(int a, int b) { return a + b; }
int outerCall(int value, thrown Low error) { return value; }

int run(int mode, int value, thrown High outward)
{
	try
	{
		switch (mode)
		{
			case 0: return low(3) + high(value);
			case 1: return (int)(low(3) + high(value));
			case 2: return sum(low(3) + high(value), low(4));
			case 3: return value == 0 ? low(3) : high(value);
			case 4: return (low(3) > 0 && high(value) > 0) ? 1 : 0;
			case 5: return (low(3) < 0 || high(value) > 0) ? 1 : 0;
			case 6: return outerCall(high(value));
			case 7: return low(0) + high(value);
			case 8: return high(value) + low(3);
		}
	}
	catch (Low inner) { return -5; }
	return -1;
}

int handled(int value)
{
	try { return low(3) + high(value); }
	catch (Low lowFault) { return -5; }
	catch (High highFault) { return -6; }
}

export int main()
{
	High fault = default;
	for (int mode = 0; mode < 9; mode++)
	{
		trace = 0;
		int result = run(mode, 8, catch fault);
		if (mode == 7) { if (result != -5 || fault != OK || trace != 1) return 1; }
		else if (result != 0 || fault != BAD || trace != ((mode == 3 || mode == 6 || mode == 8) ? 2 : 12)) return 2;
	}
	if (run(0, 4, catch fault) != 7 || fault != OK) return 3;
	if (run(3, 0, catch fault) != 3 || fault != OK) return 4;
	if (run(3, 4, catch fault) != 4 || fault != OK) return 5;
	if (handled(8) != -6 || handled(4) != 7) return 6;
	return 0;
}
