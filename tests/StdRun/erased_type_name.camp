using Std;

class User { }
enum ColorType: int { RED }
alias Integer = int;

export int main()
{
	Console.writeLine(typenameof(void<User>*));
	Console.writeLine(typenameof(nint<ColorType>));
	Console.writeLine(typenameof(int));
	Console.writeLine(typenameof(List<int[]>));
	Console.writeLine(typenameof(void));
	Console.writeLine(typenameof(void<int>));
	Console.writeLine(typenameof(const void<int[]>**));
	Console.writeLine(typenameof(void<int?>[]));
	Console.writeLine(typenameof(void<Integer>));
	Console.writeLine(typenameof(long<ColorType>*));
	return 0;
}
