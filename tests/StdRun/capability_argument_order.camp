interface Reader { int read(); }
struct Box: Reader { int value; int read(): Reader => this.value; }
int a<T>(T* source, vtableof(T: Reader), sizeof(T), typenameof(T)) => source.read();
int b<T>(T* source, vtableof(T: Reader), typenameof(T), sizeof(T)) => source.read();
int c<T>(T* source, sizeof(T), vtableof(T: Reader), typenameof(T)) => source.read();
int d<T>(T* source, sizeof(T), typenameof(T), vtableof(T: Reader)) => source.read();
int e<T>(T* source, typenameof(T), vtableof(T: Reader), sizeof(T)) => source.read();
int f<T>(T* source, typenameof(T), sizeof(T), vtableof(T: Reader)) => source.read();
int forward<T>(T* source, vtableof(T: Reader), typenameof(T), sizeof(T)) => b(source);
int expanded<T>(T* source, int? extra = 3, vtableof(T: Reader), sizeof(T)) => source.read() + extra.value;
export int main()
{
	auto renamed = new CapabilityRenamed<long>() finally delete;
	auto concrete = new CapabilityConcrete() finally delete;
	if (renamed.width() != 8 || concrete.width() != 8) return 5;
	auto shared = new SharedCapabilityDerived<long>() finally delete;
	if (shared.width() != 8 || shared.ownWidth() != 8 || shared.name() != shared.ownName()) return 6;
	auto separate = new SeparateCapabilityDerived<int>() finally delete;
	if (separate.width() != 8 || separate.ownWidth() != 4) return 7;
	auto pointer = new PointerCapabilityDerived<long>() finally delete;
	auto retainedPointer = new RetainedPointerCapabilityDerived<int>() finally delete;
	auto concretePointer = new ConcretePointerCapabilityDerived() finally delete;
	if (pointer.width() != (int)sizeof(long*) || retainedPointer.width() != (int)sizeof(int*)
		|| concretePointer.width() != (int)sizeof(long*) || retainedPointer.ownWidth() != 4) return 8;
	Box box = { 7 };
	if (a(&box) != 7 || b(&box) != 7 || c(&box) != 7) return 1;
	if (d(&box) != 7 || e(&box) != 7 || f(&box) != 7) return 2;
	if (forward(&box) != 7) return 3;
	if (expanded(&box) != 10 || expanded(&box, 5) != 12) return 4;
	return 0;
}

class CapabilityBase<T>
{
	CapabilityBase(sizeof(T)) { }
	int width() { return (int)sizeof(T); }
}
class CapabilityRenamed<U>: CapabilityBase<U>
{
	CapabilityRenamed(sizeof(U)) { int initialized = 1; }
}
class CapabilityConcrete: CapabilityBase<long> { }

sealed class PointerCapabilityDerived<T>: CapabilityBase<T*>
{
	PointerCapabilityDerived() { }
}
sealed class RetainedPointerCapabilityDerived<T>: CapabilityBase<T*>
{
	RetainedPointerCapabilityDerived(sizeof(T)) { }
	int ownWidth() { return (int)sizeof(T); }
}
sealed class ConcretePointerCapabilityDerived: CapabilityBase<long*> { }

class SharedCapabilityBase<T>
{
	SharedCapabilityBase(sizeof(T), typenameof(T)) { }
	int width() { return (int)sizeof(T); }
	string name() { return typenameof(T); }
}
class SharedCapabilityDerived<T>: SharedCapabilityBase<T>
{
	SharedCapabilityDerived(sizeof(T), typenameof(T)) { }
	int ownWidth() { return (int)sizeof(T); }
	string ownName() { return typenameof(T); }
}
class SeparateCapabilityDerived<T>: SharedCapabilityBase<long>
{
	SeparateCapabilityDerived(sizeof(T), typenameof(T)) { }
	int ownWidth() { return (int)sizeof(T); }
}
