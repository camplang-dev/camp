using Std;

int callCount;

export int main()
{
	StringMap<int> map = {};
	auto capacity = map.Capacity;

	map.addItems(56);
	addItems<int>(&map, 57);

	Console.writeLine(callCount + (int)capacity);
	return 0;
}

void addItems<T>(StringMap<T>* this, T item)
{
	callCount++;
}

fixed struct StringMap<T>
{
	string[] keys;
	T[] values;

	export nuint getCapacity() => this.keys.length;
}
