int fileDoubleNegative = - -5;
int fileDoublePositive = + +5;
inline uint LITERAL_BUDGET = 256 * 1024 * 1024;
uint literalReturn() => 4 * 1024;
uint literalArgument(uint value) => value;

export int main()
{
	int value = 5;
	int doubleNegative = - -value;
	int doublePositive = + +value;
	int tripleNegative = - - -value;
	int triplePositive = + + +value;
	if (value != 5)
		return 1;
	if (doubleNegative != 5 || doublePositive != 5)
		return 2;
	if (tripleNegative != -5 || triplePositive != 5)
		return 3;
	if (fileDoubleNegative != 5 || fileDoublePositive != 5)
		return 4;
	uint unsignedValue = 4000000000;
	auto literalFirst = 4 + unsignedValue;
	long observed = literalFirst;
	uint sum = 4 + unsignedValue;
	uint difference = 4 - unsignedValue;
	uint product = 1 * unsignedValue;
	uint bits = 4 | unsignedValue;
	if (observed != 4000000004L || sum != unsignedValue + 4)
		return 5;
	if (difference != 294967300 || product != unsignedValue || bits != sum)
		return 6;
	byte narrow = 1;
	ushort wider = 1;
	long narrowProduct = narrow * unsignedValue;
	long narrowSum = wider + unsignedValue;
	if (narrowProduct != 4000000000L || narrowSum != 4000000001L)
		return 7;
	bool choose = true;
	uint budget = 256 * 1024 * 1024;
	uint selected = choose ? 1 : (5 + 45);
	uint shapedProduct = (choose ? 2 : 3) * unsignedValue;
	if (budget != LITERAL_BUDGET || selected != 1 || shapedProduct != 3705032704)
		return 8;
	if (!(unsignedValue > (choose ? 1 : 2)) || !(2 * 3 < unsignedValue))
		return 9;
	if (literalReturn() != 4096 || literalArgument(8 * 8) != 64)
		return 10;
	float roundedResult = 100000000.0 + 1.0 - 100000000.0;
	if (roundedResult != 1.0f)
		return 11;
	return 0;
}
