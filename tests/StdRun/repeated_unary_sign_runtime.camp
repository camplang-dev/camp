int fileDoubleNegative = - -5;
int fileDoublePositive = + +5;

export int main()
{
	int value = 5;
	int doubleNegative = - -value;
	int doublePositive = + +value;
	int tripleNegative = - - -value;
	int triplePositive = + + +value;
	if (value != 5)
		return 1;
	if (doubleNegative != 5 || doublePositive != 5)
		return 2;
	if (tripleNegative != -5 || triplePositive != 5)
		return 3;
	if (fileDoubleNegative != 5 || fileDoublePositive != 5)
		return 4;
	uint unsignedValue = 4000000000;
	auto literalFirst = 4 + unsignedValue;
	long observed = literalFirst;
	uint sum = 4 + unsignedValue;
	uint difference = 4 - unsignedValue;
	uint product = 1 * unsignedValue;
	uint bits = 4 | unsignedValue;
	if (observed != 4000000004L || sum != unsignedValue + 4)
		return 5;
	if (difference != 294967300 || product != unsignedValue || bits != sum)
		return 6;
	return 0;
}
