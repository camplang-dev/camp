using Std;

export int main()
{
	astring text = "  Alpha, alpha!  ";
	const achar[] span = text[..];
	const achar[] alpha = "Alpha";
	const achar[] alphaLower = "alpha";
	const achar[] ha = "ha";
	const achar[] prefix = "  Al";
	const achar[] suffix = "!  ";
	const achar[] original = "  Alpha, alpha!  ";
	const achar[] upperText = "  ALPHA, ALPHA!  ";
	const achar[] lowerText = "  alpha, alpha!  ";
	const achar[] joinedText = "one,two,three";
	const achar[] concatenatedText = "onetwothree";
	const achar[] comma = ",";

	if (text.indexOf(alpha) != 2)
		return 1;
	if (text.indexOf(alphaLower, true) != 2)
		return 2;
	if (span.lastIndexOf(ha) != 12)
		return 3;
	if (span.indexOf((achar)'A') != 2)
		return 4;
	if (text.indexOf((achar)'p') != 4)
		return 5;
	if (span.lastIndexOf((achar)'a') != 13)
		return 6;

	achar[] any = [(achar)'x', (achar)'A'];
	if (span.indexOfAny(any) != 2)
		return 7;
	achar[] anyLast = [(achar)'!', (achar)'x'];
	if (span.lastIndexOfAny(anyLast) != 14)
		return 8;

	if (!text.startsWith(prefix))
		return 9;
	if (!span.startsWith((achar)' '))
		return 10;
	if (!span.endsWith(suffix))
		return 11;
	if (!span.endsWith((achar)' '))
		return 12;
	if (text.compareTo(original) != 0)
		return 13;

	if (span.trim().length != 13)
		return 14;
	if (span.trimStart().length != 15)
		return 15;
	if (span.trimEnd().length != 15)
		return 16;

	astring copied = span.toAString();
	astring upper = span.toUppercase();
	astring lower = span.toLowercase();
	astring joined = null;
	astring concatenated = null;
	astring[] words = ["one", "two", "three"];
	concatenated = words.join();
	joined = words.join(comma);

	fixed achar[17] explicitUpper = default;
	if (span.toUppercase(buffer: explicitUpper) != 17)
		return 23;
	if (explicitUpper[..].compareTo(upperText) != 0)
		return 24;

	if (copied[..].compareTo(original) != 0)
		return 17;
	if (upper[..].compareTo(upperText) != 0)
		return 18;
	if (lower[..].compareTo(lowerText) != 0)
		return 19;
	if (concatenated[..].compareTo(concatenatedText) != 0)
		return 20;
	if (joined[..].compareTo(joinedText) != 0)
		return 21;

	const achar[] embeddedNull = [(achar)'a', (achar)'b', 0, (achar)'x', (achar)'y'];
	const achar[] ab = "ab";
	if (embeddedNull.compareTo(ab) != 0)
		return 22;

	return 0;
}
