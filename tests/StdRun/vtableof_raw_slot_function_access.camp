using Std;

internal interface IRefCount
{
	void retain();
	void release();
}

void captureRelease<T: implements IRefCount>(T* value, vtableof(T: IRefCount))
{
	value.retain();
	fn void(T* context) capturedRelease = vtableof_T_IRefCount.release;
	fn void(T* context) capturedReleaseFromExpression = vtableof(T: IRefCount).release;
	capturedRelease(value);
	capturedReleaseFromExpression(value);
}

class RefThing: IRefCount
{
	int* retains;
	int* releases;

	RefThing(unscoped int* retains, unscoped int* releases)
	{
		this.retains = retains;
		this.releases = releases;
	}

	void retain(): IRefCount
	{
		(*this.retains)++;
	}

	void release(): IRefCount
	{
		(*this.releases)++;
	}
}

export int main()
{
	int retains = 0;
	int releases = 0;
	auto thing = new RefThing(&retains, &releases) finally delete;
	captureRelease<RefThing>(thing);
	Console.writeLine(retains);
	Console.writeLine(releases);
	return 0;
}
