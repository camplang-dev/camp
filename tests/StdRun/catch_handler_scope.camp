enum Fault { OK = 0, BAD }
enum Other { OK = 0, BAD }
int fail(thrown Fault error) { throw BAD; }

export int main()
{
	int fault = 7;
	int seen = 0;
	try { fail(); }
	catch (Fault fault) { seen = (int)fault; }
	catch (Other fault) { return 1; }
	if (fault != 7 || seen != 1) return 2;
	try { fail(); }
	catch (Fault fault) { if (fault != BAD) return 3; }
	return 0;
}
