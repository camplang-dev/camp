abstract class VirtualDevice
{
	abstract int process();

	virtual ~VirtualDevice()
	{
		destructorLog = destructorLog * 10 + 1;
	}
}

sealed class VirtualFileDevice: VirtualDevice
{
	override int process()
	{
		return 1;
	}

	sealed ~VirtualFileDevice()
	{
		destructorLog = destructorLog * 10 + 2;
	}
}

abstract class AbstractDevice
{
	abstract int process();

	abstract ~AbstractDevice();
}

sealed class AbstractFileDevice: AbstractDevice
{
	override int process()
	{
		return 2;
	}

	override ~AbstractFileDevice()
	{
		destructorLog = destructorLog * 10 + 3;
	}
}

int destructorLog = 0;

export int main()
{
	VirtualDevice* virtualDevice = (VirtualDevice*)new VirtualFileDevice();
	delete virtualDevice;

	AbstractDevice* abstractDevice = (AbstractDevice*)new AbstractFileDevice();
	delete abstractDevice;

	if (destructorLog != 213) return 1;
	auto direct = stackalloc ChainLeaf();
	direct.early = false;
	delete direct;
	if (chainLog != 3421) return 2;
	chainLog = 0;
	auto early = stackalloc ChainLeaf();
	early.early = true;
	ChainRoot* root = early;
	delete root;
	if (chainLog != 321) return 3;
	chainLog = 0;
	ChainRoot* heap = new ChainLeaf();
	delete heap;
	if (chainLog != 3421) return 4;
	chainLog = 0;
	ChainRoot* inherited = new ChainInherited();
	delete inherited;
	return chainLog == 21 ? 0 : 5;
}

int chainLog;
virtual class ChainRoot
{
	virtual ~ChainRoot() { chainLog = chainLog * 10 + 1; }
}
virtual class ChainMiddle: ChainRoot
{
	override ~ChainMiddle() { chainLog = chainLog * 10 + 2; }
}
sealed class ChainLeaf: ChainMiddle
{
	bool early;
	override ~ChainLeaf()
	{
		chainLog = chainLog * 10 + 3;
		if (this.early) return;
		chainLog = chainLog * 10 + 4;
	}
}
sealed class ChainInherited: ChainMiddle { }
