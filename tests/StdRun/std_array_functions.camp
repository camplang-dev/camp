using Std;

int compareInt(in int left, in int right)
{
	if (left < right)
		return -1;
	if (left > right)
		return 1;
	return 0;
}

export int main()
{
	int[] source = [3, 1, 2, 4];
	int[] destination = [0, 0, 0, 0];

	source.copyTo<int>(destination);
	if (destination[0] != 3 || destination[1] != 1 || destination[2] != 2 || destination[3] != 4)
		return 1;

	destination.reverse<int>();
	if (destination[0] != 4 || destination[1] != 2 || destination[2] != 1 || destination[3] != 3)
		return 2;

	destination.sort<int>(compareInt);
	if (destination[0] != 1 || destination[1] != 2 || destination[2] != 3 || destination[3] != 4)
		return 3;

	if (destination.binarySearch<int>(3, compareInt) != 2)
		return 4;
	if (destination.binarySearch<int>(9, compareInt) != -1)
		return 5;

	int[] duplicated;
	duplicated = destination.copyArray<int>();
	if (duplicated.length != 4 || duplicated[0] != 1 || duplicated[3] != 4)
		return 6;
	delete duplicated;

	source.clear<int>();
	if (source[0] != 0 || source[1] != 0 || source[2] != 0 || source[3] != 0)
		return 7;

	source.copyFrom<int>(destination);
	if (source[0] != 1 || source[1] != 2 || source[2] != 3 || source[3] != 4)
		return 8;

	int[] overlap = [1, 2, 3, 4, 5];
	overlap[..4].copyTo<int>(overlap[1..]);
	if (overlap[0] != 1 || overlap[1] != 1 || overlap[2] != 2 || overlap[3] != 3 || overlap[4] != 4)
		return 9;

	overlap[1..].copyTo<int>(overlap[..4]);
	if (overlap[0] != 1 || overlap[1] != 2 || overlap[2] != 3 || overlap[3] != 4 || overlap[4] != 4)
		return 10;

	return 0;
}
