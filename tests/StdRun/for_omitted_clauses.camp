export int main()
{
	int i = 0;
	int total = 0;
	for (; i < 3; i++) total += 10;
	if (total != 30 || i != 3) return 1;
	i = 0;
	for (; i < 5;) i += 2;
	if (i != 6) return 2;
	i = 0;
	for (;;)
	{
		if (i == 3) break;
		i++;
	}
	if (i != 3) return 3;
	for (i = 0;; i++) if (i == 3) break;
	return i == 3 ? 0 : 4;
}
