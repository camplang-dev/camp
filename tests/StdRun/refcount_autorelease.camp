using Std;

export escaped interface IRefCount
{
	void retain();
	void release();
}

List<delegate void()>* pendingReleases;
int released;

export escaped T* autorelease<T: implements IRefCount>(
	escaped T* this,
	vtableof(T: IRefCount))
{
	if (pendingReleases == null)
		pendingReleases = new List<delegate void()>();

	pendingReleases.add(this.release);
	return this;
}

export void emptyAutoreleasePool()
{
	if (pendingReleases != null)
	{
		while (pendingReleases.Length > 0)
		{
			auto last = pendingReleases.Item[^1];
			pendingReleases.remove(^1);
			last();
		}
	}
}

class Thing: IRefCount
{
	void retain(): IRefCount
	{
	}

	void release(): IRefCount
	{
		released++;
	}
}

export int main()
{
	auto thing = new Thing();
	thing.autorelease();
	emptyAutoreleasePool();
	return released - 1;
}
