using Std;

struct ReadResult
{
	const byte[] payload;
	int code;
}

unscoped(image) const byte[] unscopedSlice(const byte[] image, nuint size) => image[0..size];

scoped(image) const byte[] scopedSlice(const byte[] image, nuint size) => image[0..size];

escaped const char[] escapedSlice(escaped const char[] text, nuint size) => text[0..size];

nuint length(const byte[] data) => data.length;

nuint textLength(const char[] text) => text.length;


ReadResult unscopedResult(const byte[] image) => { unscopedSlice(image, 3), 1 };

ReadResult scopedResult(const byte[] image) => { scopedSlice(image, 2), 2 };

void shiftResults(ReadResult[] entries)
{
	entries[1] = entries[0];
	ReadResult current = entries[1];
	entries[0] = current;
}

struct ResultReader
{
	const byte[] bytes;
	bool read(out ReadResult part) { part = { this.bytes, 7 }; return true; }
	bool readFields(out ReadResult part)
	{
		part = default;
		part.payload = this.bytes;
		part.code = 9;
		return true;
	}
}

ReadResult readOut(const byte[] image)
{
	ResultReader reader = { image };
	ReadResult part = default;
	reader.read(out part);
	return part;
}

ReadResult readPointer(ResultReader* reader) => { reader.bytes, 8 };

ReadResult fromPointer(const byte[] image)
{
	ResultReader reader = { image };
	return readPointer(&reader);
}

ReadResult fromFields(const byte[] image)
{
	ResultReader reader = { image };
	ReadResult part = default;
	reader.readFields(out part);
	return part;
}

void collectResults(unscoped(destination) ReadResult[] source, ReadResult[] destination)
{
	destination[0] = source[0];
}

bool collectParameterResults(ReadResult[] source)
{
	fixed ReadResult[2] destination = default;
	collectResults(source, destination[..]);
	return destination[0].payload.length == 3 && destination[0].code == 1;
}

struct InlineName
{
	fixed byte[8] bytes;
	nuint length;
	scoped(this) const byte[] view() => this.bytes[..this.length];
}

void collectInline(unscoped(destination) InlineName[] source, ReadResult[] destination)
{
	destination[0] = { source[0].bytes[..source[0].length], 11 };
	destination[1] = { source[0].view(), 12 };
}

struct InlineSettings
{
	fixed InlineName[2] names;
	void collect(unscoped(destination) this, ReadResult[] destination)
	{
		destination[0] = { this.names[0].bytes[..this.names[0].length], 13 };
		destination[1] = { this.names[0].view(), 14 };
	}
}

bool checkInlineViews()
{
	fixed InlineName[2] names = default;
	names[0].bytes[0] = 42;
	names[0].length = 1;
	fixed ReadResult[2] destination = default;
	collectInline(names[..], destination[..]);
	if ((int)destination[0].payload[0] != 42 || (int)destination[1].payload[0] != 42
		|| destination[0].code != 11 || destination[1].code != 12)
		return false;
	InlineSettings settings = default;
	settings.names[0].bytes[0] = 24;
	settings.names[0].length = 1;
	settings.collect(destination[..]);
	return (int)destination[0].payload[0] == 24 && (int)destination[1].payload[0] == 24
		&& destination[0].code == 13 && destination[1].code == 14;
}

export int main(string[] args)
{
	const byte[] image = [1, 2, 3, 4, 5];
	if (length(unscopedSlice(image, 4)) != 4)
		return 1;
	if (length(scopedSlice(image, 2)) != 2)
		return 2;
	if (textLength(escapedSlice("abc", 1)) != 1)
		return 3;
	ReadResult first = unscopedResult(image);
	if (first.payload.length != 3 || first.code != 1)
		return 4;
	ReadResult second = scopedResult(image);
	if (second.payload.length != 2 || second.code != 2)
		return 5;
	fixed ReadResult[2] entries = default;
	entries[0] = first;
	shiftResults(entries[..]);
	if (entries[1].payload.length != 3 || entries[0].code != 1)
		return 6;
	ReadResult fromOut = readOut(image);
	if (fromOut.payload.length != 5 || (int)fromOut.payload[4] != 5 || fromOut.code != 7)
		return 7;
	ReadResult fromInput = fromPointer(image);
	if (fromInput.payload.length != 5 || (int)fromInput.payload[0] != 1 || fromInput.code != 8)
		return 8;
	ReadResult fromOutputFields = fromFields(image);
	if (fromOutputFields.payload.length != 5 || (int)fromOutputFields.payload[1] != 2 || fromOutputFields.code != 9)
		return 9;
	if (!collectParameterResults(entries[..]))
		return 10;
	if (!checkInlineViews())
		return 11;
	return 0;
}
