using Std;
alias Integer = int;

struct Point { int x; int y; }
newtype delegate int Predicate(int n);
int plusOne(int n) => n + 1;
int read(in void<int> value) => value;
void write(out void<int> value) { value = 23; }
int evaluations;
nuint nextIndex() { evaluations++; return 1; }

enum Kind: int { RED, GREEN, BLUE }
enum SmallKind: byte { LOW, HIGH }
newtype Idx: ushort;
struct CarrierHolder
{
	long<Kind> kind;
	byte<SmallKind> small;
	uint<Idx> index;
	nint<byte*> address;
}
struct CarrierSlot<T: long> { T value; T get() => this.value; }
long<Kind> carrierGlobal;
int pickKind(overload Kind value) => 1;
int pickKind(overload int value) => 2;
int nextKind(Kind this) => 7;
long<Kind> echoKind(long<Kind> value) => value;

int carrierStorage()
{
	long<Kind> local = GREEN;
	Kind read = local;
	if (read != GREEN) return 101;
	int<byte> narrow = 200;
	byte narrowRead = narrow;
	if (narrowRead != 200) return 102;
	long<Kind>* address = &local;
	*address = BLUE;
	if (local != BLUE) return 103;
	CarrierHolder holder = default;
	holder.kind = GREEN;
	holder.small = HIGH;
	holder.index = (Idx)9;
	byte* bytes = default;
	holder.address = bytes;
	Kind heldKind = holder.kind;
	if (heldKind != GREEN || holder.small != HIGH || (ushort)holder.index != 9) return 104;
	long<Kind>* fieldAddress = &holder.kind;
	if (*fieldAddress != GREEN) return 105;
	carrierGlobal = RED;
	Kind globalKind = carrierGlobal;
	if (globalKind != RED) return 106;
	long<Kind>[] kinds = stackalloc long<Kind>[3];
	kinds[0] = BLUE;
	kinds[1] = local;
	Kind first = kinds[0];
	if (first != BLUE || kinds.length != 3) return 107;
	if (sizeof(long<Kind>) != sizeof(long) || sizeof(int<byte>) != sizeof(int) || sizeof(byte<SmallKind>) != 1) return 108;
	if (sizeof(nint<byte*>) != sizeof(nint)) return 109;
	if (pickKind(local) != 1 || local.nextKind() != 7) return 110;
	if (echoKind(GREEN) != GREEN) return 111;
	CarrierSlot<long<Kind>> slot = default;
	slot.value = BLUE;
	Kind slotKind = slot.get();
	if (slotKind != BLUE) return 112;
	auto inferred = local;
	Kind inferredKind = inferred;
	if (inferredKind != BLUE) return 113;
	if (typenameof(long<Kind>*).Length != typenameof(Kind).Length || typenameof(long<Kind>*)[0] != 'K') return 114;
	CarrierSlot<Kind>* slotPointer = stackalloc CarrierSlot<Kind>();
	slotPointer.value = GREEN;
	delegate long<Kind>() carrierGetter = slotPointer.get;
	delegate Kind() adapted = () => slotPointer.get();
	Kind viaGetter = carrierGetter();
	if (viaGetter != GREEN || adapted() != GREEN) return 115;
	return 0;
}

interface Reader { int read(); }
struct Counter: Reader { int n; int read(): Reader => this.n; }
int pointerCalls;
int storageEvaluations;
int nextValue() { storageEvaluations++; return storageEvaluations; }
int readOptional(in void<int?> value) { int? read = value; return read.specified ? read.value : -1; }
int sumOptional(const int?* source) { int? read = *source; return read.specified ? read.value : -1; }
void fillOptional(int?* target, int value) { *target = value; }
void fillArray(int[]?* target, int[] data) { *target = data; }
void<int?>* countedPointer(void<int?>* slot) { pointerCalls++; return slot; }
int sameStorageAcrossLoop<T>(T[] values, sizeof(T))
{
	nuint previous = 0;
	for (nuint i = 0; i < values.length; i++)
	{
		stackalloc T scratch = values[i];
		T* address = &scratch;
		if (i > 0 && (nuint)address != previous) return 0;
		previous = (nuint)address;
	}
	return 1;
}
int interfaceStorage<T>(T* source, sizeof(T), vtableof(T: Reader))
{
	return source.read();
}

int erasedStackAllocForms()
{
	stackalloc void<int?> cast = (void<int?>)42;
	if (readOptional(cast) != 42 || readOptional((void<int?>)5) != 5) return 201;
	cast = (void<int?>)6;
	if (readOptional(cast) != 6) return 202;
	storageEvaluations = 0;
	int total = 0;
	for (int i = 0; i < 3; i++)
	{
		stackalloc void<int?> inLoop = (void<int?>)nextValue();
		total += readOptional(inLoop);
	}
	if (storageEvaluations != 3 || total != 6) return 203;
	int[] numbers = [4, 5, 6];
	if (sameStorageAcrossLoop(numbers) != 1) return 204;
	Counter counter = { 17 };
	if (interfaceStorage(&counter) != 17) return 205;

	stackalloc void<int?> expanded = default;
	fillOptional(&expanded, 12);
	if (readOptional(expanded) != 12 || sumOptional(&expanded) != 12) return 206;
	pointerCalls = 0;
	fillOptional(countedPointer(&expanded), 13);
	if (pointerCalls != 1 || readOptional(expanded) != 13) return 207;
	int?* direct = &expanded;
	*direct = 14;
	int?* assigned = direct;
	assigned = countedPointer(&expanded);
	*assigned = 15;
	if (pointerCalls != 2 || readOptional(expanded) != 15) return 208;
	void<int?>[] slots = stackalloc void<int?>[2];
	slots[0] = default;
	slots[1] = default;
	fillOptional(&slots[1], 31);
	int? lastSlot = slots[1];
	if (slots[0].specified || !lastSlot.specified || lastSlot.value != 31) return 209;
	stackalloc void<int[]?> arraySlot = default;
	int[] data = [1, 2, 3];
	fillArray(&arraySlot, data);
	int[]? readBack = arraySlot;
	if (!readBack.specified || readBack.length != 3 || readBack[2] != 3) return 210;
	return 0;
}

// Integer carriers: deterministic encoding, bit-preserving floating payloads and whole-carrier equality.
newtype EncSingle: float;
newtype EncHandle: byte*;
enum EncShade: byte { DARK = 1, LIGHT = 200 }
interface EncSource { int next(); }
class EncCell: EncSource
{
	int value;
	EncCell(int value) { this.value = value; }
	int next(): EncSource => this.value;
}
T encThroughNint<T: nint>(T value) { return value; }
T encThroughLong<T: long>(T value) { return value; }
T encThroughUint<T: uint>(T value) { return value; }
T encThroughByte<T: byte>(T value) { return value; }
bool encSame<T: long>(T left, T right) { return left == right; }
bool encDiffer<T: long>(T left, T right) { return left != right; }
T encDefault<T: long>() { T value = default; return value; }
void encStore<T: long>(T* target, T value) { *target = value; }
T encLoad<T: long>(T* source) { return *source; }
T encInput<T: long>(in T source) { return source; }
void encCopy<T: long>(in T source, out T destination) { destination = source; }
class EncBox<T: nint>
{
	T value;
	EncBox(T value) { this.value = value; }
	T read() { return this.value; }
	void write(T replacement) { this.value = replacement; }
	bool isDefault() { return this.value == default; }
}
struct EncRecord { int<float> single; long<double> wide; nint<string> text; }
int<float> encGlobal = 1.5f;
nuint encSize<T: long>(T value, sizeof(T)) { return sizeof(T); }
float encDouble(int<float> value) { float read = value; return (float)(read * 2.0f); }

int carrierEncoding()
{
	// Signed payloads sign-extend, unsigned payloads, booleans and characters zero-extend.
	long<short> negative = (short)-3;
	long<ushort> large = (ushort)65535;
	ulong<int> extended = -1;
	long<char> character = (char)200;
	long<bool> truth = true;
	if (*(long*)&negative != -3 || *(long*)&large != 65535 || *(ulong*)&extended != 0xffffffffffffffff) return 301;
	if (*(long*)&character != 200 || *(long*)&truth != 1) return 302;
	// Floating payloads keep their exact bits and zero-fill the rest of a wider carrier.
	long<float> wideSingle = 1.0f;
	long<double> wideDouble = 1.0;
	uint<float> sameWidth = 2.0f;
	if (*(long*)&wideSingle != 0x3f800000 || *(ulong*)&wideDouble != 0x3ff0000000000000 || *(uint*)&sameWidth != 0x40000000) return 303;
	float singleRead = wideSingle;
	double doubleRead = wideDouble;
	if (singleRead != 1.0f || doubleRead != 1.0) return 304;
	// Equality compares every carrier bit: signed zeros differ and NaN payloads decide equality.
	float positive = 0.0f;
	float negativeZero = -positive;
	uint<float> zero = positive;
	uint<float> minusZero = negativeZero;
	if (zero == minusZero || !(zero != minusZero)) return 305;
	float comparedZero = zero;
	float comparedMinusZero = minusZero;
	if (comparedZero != comparedMinusZero) return 306;
	uint quietBits = 0x7fc00000;
	uint payloadBits = 0x7fc00001;
	uint<float>* quiet = (uint<float>*)&quietBits;
	uint<float>* payload = (uint<float>*)&payloadBits;
	uint<float> quietCopy = *quiet;
	float readQuiet = *quiet;
	if (*quiet != quietCopy || *quiet == *payload || !(*quiet != *payload) || readQuiet == readQuiet) return 307;
	// The same representation copies all bits, including initialized unused ones; a conversion re-encodes.
	ulong wideBits = 0xffff000000000000UL | 0x3f800000;
	ulong<float>* wideStored = (ulong<float>*)&wideBits;
	ulong<float> wideCopy = *wideStored;
	long<float> reencoded = *wideStored;
	if (*(ulong*)&wideCopy != wideBits || wideCopy != *wideStored || *(long*)&reencoded != 0x3f800000) return 308;
	// Defaults encode the whole carrier.
	long<float> defaulted = default;
	if (*(long*)&defaulted != 0 || defaulted != default) return 309;
	// Nominal payloads, casts, aggregates, globals, arrays and callbacks use the same transport.
	float nominalSource = 2.5f;
	EncSingle nominal = (EncSingle)nominalSource;
	int<EncSingle> carriedNominal = nominal;
	int<float> cast = (int<float>)3.25f;
	EncRecord record = { 2.5f, 4.5, "text" };
	EncRecord blank = default;
	int<float>[] values = [1.0f, 2.0f, 3.0f];
	float total = 0.0f;
	for (nuint index = 0; index < values.length; index++) total = total + values[index];
	string recordText = record.text;
	float recordSingle = record.single;
	float blankSingle = blank.single;
	float globalRead = encGlobal;
	if ((float)(EncSingle)carriedNominal != 2.5f || cast != 3.25f) return 310;
	if (recordSingle != 2.5f || record.wide != 4.5 || recordText[1] != 'e' || blankSingle != 0.0f) return 311;
	if (total != 6.0f || globalRead != 1.5f || encDouble(cast) != 6.5f) return 312;

	// Generic bodies treat a represented parameter as its carrier: copy, default and equality only.
	float generic = encThroughNint<float>(1.25f);
	double genericWide = encThroughLong<double>(-2.5);
	if (generic != 1.25f || genericWide != -2.5) return 313;
	double genericZero = 0.0;
	double genericMinusZero = -genericZero;
	if (!encSame<double>(2.5, 2.5) || encSame<double>(2.5, 2.75) || !encDiffer<double>(2.5, 2.75)) return 314;
	if (encSame<double>(genericZero, genericMinusZero) || !encDiffer<double>(genericZero, genericMinusZero)) return 315;
	ulong nanBits = 0x7ff8000000000000;
	ulong otherNanBits = 0x7ff8000000000001;
	long<double>* genericNan = (long<double>*)&nanBits;
	long<double>* genericOtherNan = (long<double>*)&otherNanBits;
	double firstNan = *genericNan;
	double secondNan = *genericOtherNan;
	if (!encSame<double>(firstNan, firstNan) || encSame<double>(firstNan, secondNan)) return 316;
	if (encDefault<double>() != 0.0 || encThroughUint<float>(7.5f) != 7.5f) return 317;
	long<double> slot = default;
	encStore<double>(&slot, 9.5);
	if (encLoad<double>(&slot) != 9.5 || slot != 9.5) return 318;
	// Pointers, strings, interface pointers and scalar newtypes round-trip through nint.
	int pointee = 41;
	int* original = &pointee;
	int* roundTripped = encThroughNint<int*>(original);
	string text = "carrier";
	string textRoundTrip = encThroughNint<string>(text);
	EncCell* cell = new EncCell(9);
	EncSource* source = cell;
	EncSource* sourceRoundTrip = encThroughNint<EncSource*>(source);
	byte marker = 7;
	EncHandle handle = (EncHandle)&marker;
	EncHandle handleRoundTrip = encThroughNint<EncHandle>(handle);
	nint<int*> stored = original;
	nint<int*>* storedAddress = &stored;
	int next = sourceRoundTrip.next();
	delete cell;
	if (roundTripped != original || *roundTripped != 41 || *(*storedAddress == original ? original : null) != 41) return 319;
	if (textRoundTrip[0] != 'c' || textRoundTrip[6] != 'r' || next != 9 || (byte*)handleRoundTrip != &marker) return 320;
	if (encThroughByte<EncShade>(EncShade.LIGHT) != EncShade.LIGHT || encThroughLong<bool>(true) != true) return 321;
	if (encThroughLong<char>((char)200) != (char)200 || encThroughLong<long>(-5000000000) != -5000000000) return 322;
	// Pointers, inputs and outputs use storage of the destination representation.
	long<short> source16 = (short)6;
	long<short> destination16 = (short)0;
	short plain16 = (short)5;
	encCopy<short>(source16, out destination16);
	if (destination16 != 6 || encInput<short>(plain16) != 5 || encInput<short>(source16) != 6) return 323;
	EncBox<float>* box = new EncBox<float>(7.5f);
	float boxed = box.read();
	box.write(-1.5f);
	bool boxedDefault = box.isDefault();
	float boxedReplacement = box.read();
	delete box;
	if (boxed != 7.5f || boxedReplacement != -1.5f || boxedDefault) return 324;
	// A field of a represented parameter is carrier storage, so its equality is bitwise too.
	EncBox<float>* zeroBox = new EncBox<float>(positive);
	EncBox<float>* minusZeroBox = new EncBox<float>(negativeZero);
	bool fieldsEqual = zeroBox.value == minusZeroBox.value;
	bool fieldsDiffer = zeroBox.value != minusZeroBox.value;
	bool fieldsAlike = zeroBox.value == zeroBox.value;
	delete zeroBox;
	delete minusZeroBox;
	if (fieldsEqual || !fieldsDiffer || !fieldsAlike) return 325;
	short narrow = (short)3;
	double wide = 1.0;
	if (encSize<short>(narrow) != sizeof(long) || encSize(narrow) != sizeof(long) || encSize(wide) != sizeof(long)) return 326;
	return 0;
}

export int main()
{
	stackalloc void<int> scalar = 7;
	void<int>* scalarPtr = &scalar;
	int* ordinary = scalarPtr;
	void<int>* roundtrip = ordinary;
	*roundtrip = 11;
	if (scalar != 11 || read(scalar) != 11) return 1;
	write(out scalar);
	if (scalar != 23) return 2;
	int** ordinaryAddress = &ordinary;
	void<int>** erasedAddress = ordinaryAddress;
	int** recoveredAddress = erasedAddress;
	if (**recoveredAddress != 23) return 18;
	void* raw = scalarPtr;
	void<int>* recoveredRaw = (void<int>*)raw;
	if (*recoveredRaw != 23) return 19;

	stackalloc void<Point> point = { 3, 4 };
	void<Point>* pointPtr = &point;
	pointPtr.x = 8;
	Point wholePoint = *pointPtr;
	if (wholePoint.x != 8 || wholePoint.y != 4) return 3;

	stackalloc void<int?> optional = 5;
	void<int?>* optionalPtr = &optional;
	if (!optionalPtr.specified || optionalPtr.value != 5) return 4;
	*optionalPtr = 9;
	int? wholeOptional = *optionalPtr;
	if (!wholeOptional.specified || wholeOptional.value != 9) return 5;

	int[] original = stackalloc int[3];
	original[0] = 31;
	original[1] = 41;
	original[2] = 59;
	stackalloc void<int[]> arraySlot = original;
	void<int[]>* arrayPtr = &arraySlot;
	int[] wholeArray = *arrayPtr;
	if (wholeArray.length != 3 || wholeArray[1] != 41 || arrayPtr.length != 3) return 6;
	void<int>[] erasedInts = original;
	int[] recoveredInts = erasedInts;
	erasedInts[2] = 60;
	if (recoveredInts[2] != 60) return 7;

	void<int?>[] items = stackalloc void<int?>[4];
	items[0] = 13;
	items[1] = 17;
	items[2] = default;
	items[3] = 19;
	void<int?>* last = &items[3];
	if (!last.specified || last.value != 19) return 8;
	int? second = items[1];
	if (!second.specified || second.value != 17 || items[2].specified) return 9;
	evaluations = 0;
	items[nextIndex()] = 29;
	if (evaluations != 1) return 11;
	int? evaluated = items[nextIndex()];
	if (evaluations != 2 || !evaluated.specified || evaluated.value != 29) return 12;
	stackalloc void<int?> copied = items[nextIndex()];
	if (evaluations != 3 || !copied.specified || copied.value != 29) return 20;
	stackalloc void<int?*> distributiveSlot = &wholeOptional;
	void<int?*>* distributiveHolder = &distributiveSlot;
	int?* recoveredDistributive = *distributiveHolder;
	(*recoveredDistributive).value = 37;
	if (wholeOptional.value != 37) return 14;
	void<int?>[] slice = items[1..3];
	if (slice.length != 2 || slice[0].value != 29 || slice[1].specified) return 16;

	stackalloc void<Predicate> callable = plusOne;
	void<Predicate>* callablePtr = &callable;
	Predicate wholeCallable = *callablePtr;
	if (wholeCallable(71) != 72 || callable(81) != 82) return 10;
	int carrierResult = carrierStorage();
	if (carrierResult != 0) return carrierResult;
	int stackAllocResult = erasedStackAllocForms();
	if (stackAllocResult != 0) return stackAllocResult;
	int encodingResult = carrierEncoding();
	if (encodingResult != 0) return encodingResult;
	Console.writeLine("erased storage passed");
	if (typenameof(void<int?>).Length != typenameof(int).Length || typenameof(void<int?>)[0] != 'I') return 13;
	if (typenameof(void<Integer>).Length != typenameof(int).Length || typenameof(void<Integer>)[0] != 'I') return 21;
	return 0;
}
