using Std;
alias Integer = int;

struct Point { int x; int y; }
newtype delegate int Predicate(int n);
int plusOne(int n) => n + 1;
int read(in void<int> value) => value;
void write(out void<int> value) { value = 23; }
int evaluations;
nuint nextIndex() { evaluations++; return 1; }

enum Kind: int { RED, GREEN, BLUE }
enum SmallKind: byte { LOW, HIGH }
newtype Idx: ushort;
struct CarrierHolder
{
	long<Kind> kind;
	byte<SmallKind> small;
	uint<Idx> index;
	nint<byte*> address;
}
struct CarrierSlot<T: long> { T value; T get() => this.value; }
long<Kind> carrierGlobal;
int pickKind(overload Kind value) => 1;
int pickKind(overload int value) => 2;
int nextKind(Kind this) => 7;
long<Kind> echoKind(long<Kind> value) => value;

int carrierStorage()
{
	long<Kind> local = GREEN;
	Kind read = local;
	if (read != GREEN) return 101;
	int<byte> narrow = 200;
	byte narrowRead = narrow;
	if (narrowRead != 200) return 102;
	long<Kind>* address = &local;
	*address = BLUE;
	if (local != BLUE) return 103;
	CarrierHolder holder = default;
	holder.kind = GREEN;
	holder.small = HIGH;
	holder.index = (Idx)9;
	byte* bytes = default;
	holder.address = bytes;
	Kind heldKind = holder.kind;
	if (heldKind != GREEN || holder.small != HIGH || (ushort)holder.index != 9) return 104;
	long<Kind>* fieldAddress = &holder.kind;
	if (*fieldAddress != GREEN) return 105;
	carrierGlobal = RED;
	Kind globalKind = carrierGlobal;
	if (globalKind != RED) return 106;
	long<Kind>[] kinds = stackalloc long<Kind>[3];
	kinds[0] = BLUE;
	kinds[1] = local;
	Kind first = kinds[0];
	if (first != BLUE || kinds.length != 3) return 107;
	if (sizeof(long<Kind>) != sizeof(long) || sizeof(int<byte>) != sizeof(int) || sizeof(byte<SmallKind>) != 1) return 108;
	if (sizeof(nint<byte*>) != sizeof(nint)) return 109;
	if (pickKind(local) != 1 || local.nextKind() != 7) return 110;
	if (echoKind(GREEN) != GREEN) return 111;
	CarrierSlot<long<Kind>> slot = default;
	slot.value = BLUE;
	Kind slotKind = slot.get();
	if (slotKind != BLUE) return 112;
	auto inferred = local;
	Kind inferredKind = inferred;
	if (inferredKind != BLUE) return 113;
	if (typenameof(long<Kind>*).Length != typenameof(Kind).Length || typenameof(long<Kind>*)[0] != 'K') return 114;
	CarrierSlot<Kind>* slotPointer = stackalloc CarrierSlot<Kind>();
	slotPointer.value = GREEN;
	delegate long<Kind>() carrierGetter = slotPointer.get;
	delegate Kind() adapted = () => slotPointer.get();
	Kind viaGetter = carrierGetter();
	if (viaGetter != GREEN || adapted() != GREEN) return 115;
	return 0;
}

interface Reader { int read(); }
struct Counter: Reader { int n; int read(): Reader => this.n; }
int pointerCalls;
int storageEvaluations;
int nextValue() { storageEvaluations++; return storageEvaluations; }
int readOptional(in void<int?> value) { int? read = value; return read.specified ? read.value : -1; }
int sumOptional(const int?* source) { int? read = *source; return read.specified ? read.value : -1; }
void fillOptional(int?* target, int value) { *target = value; }
void fillArray(int[]?* target, int[] data) { *target = data; }
void<int?>* countedPointer(void<int?>* slot) { pointerCalls++; return slot; }
int sameStorageAcrossLoop<T>(T[] values, sizeof(T))
{
	T* previous = null;
	for (nuint i = 0; i < values.length; i++)
	{
		stackalloc T scratch = values[i];
		T* address = &scratch;
		if (i > 0 && address != previous) return 0;
		previous = address;
	}
	return 1;
}
int interfaceStorage<T>(T* source, sizeof(T), vtableof(T: Reader))
{
	return source.read();
}

int erasedStackAllocForms()
{
	stackalloc void<int?> cast = (void<int?>)42;
	if (readOptional(cast) != 42 || readOptional((void<int?>)5) != 5) return 201;
	cast = (void<int?>)6;
	if (readOptional(cast) != 6) return 202;
	storageEvaluations = 0;
	int total = 0;
	for (int i = 0; i < 3; i++)
	{
		stackalloc void<int?> inLoop = (void<int?>)nextValue();
		total += readOptional(inLoop);
	}
	if (storageEvaluations != 3 || total != 6) return 203;
	int[] numbers = [4, 5, 6];
	if (sameStorageAcrossLoop(numbers) != 1) return 204;
	Counter counter = { 17 };
	if (interfaceStorage(&counter) != 17) return 205;

	stackalloc void<int?> expanded = default;
	fillOptional(&expanded, 12);
	if (readOptional(expanded) != 12 || sumOptional(&expanded) != 12) return 206;
	pointerCalls = 0;
	fillOptional(countedPointer(&expanded), 13);
	if (pointerCalls != 1 || readOptional(expanded) != 13) return 207;
	int?* direct = &expanded;
	*direct = 14;
	int?* assigned = direct;
	assigned = countedPointer(&expanded);
	*assigned = 15;
	if (pointerCalls != 2 || readOptional(expanded) != 15) return 208;
	void<int?>[] slots = stackalloc void<int?>[2];
	slots[0] = default;
	slots[1] = default;
	fillOptional(&slots[1], 31);
	int? lastSlot = slots[1];
	if (slots[0].specified || !lastSlot.specified || lastSlot.value != 31) return 209;
	stackalloc void<int[]?> arraySlot = default;
	int[] data = [1, 2, 3];
	fillArray(&arraySlot, data);
	int[]? readBack = arraySlot;
	if (!readBack.specified || readBack.length != 3 || readBack[2] != 3) return 210;
	return 0;
}

export int main()
{
	stackalloc void<int> scalar = 7;
	void<int>* scalarPtr = &scalar;
	int* ordinary = scalarPtr;
	void<int>* roundtrip = ordinary;
	*roundtrip = 11;
	if (scalar != 11 || read(scalar) != 11) return 1;
	write(out scalar);
	if (scalar != 23) return 2;
	int** ordinaryAddress = &ordinary;
	void<int>** erasedAddress = ordinaryAddress;
	int** recoveredAddress = erasedAddress;
	if (**recoveredAddress != 23) return 18;
	void* raw = scalarPtr;
	void<int>* recoveredRaw = (void<int>*)raw;
	if (*recoveredRaw != 23) return 19;

	stackalloc void<Point> point = { 3, 4 };
	void<Point>* pointPtr = &point;
	pointPtr.x = 8;
	Point wholePoint = *pointPtr;
	if (wholePoint.x != 8 || wholePoint.y != 4) return 3;

	stackalloc void<int?> optional = 5;
	void<int?>* optionalPtr = &optional;
	if (!optionalPtr.specified || optionalPtr.value != 5) return 4;
	*optionalPtr = 9;
	int? wholeOptional = *optionalPtr;
	if (!wholeOptional.specified || wholeOptional.value != 9) return 5;

	int[] original = stackalloc int[3];
	original[0] = 31;
	original[1] = 41;
	original[2] = 59;
	stackalloc void<int[]> arraySlot = original;
	void<int[]>* arrayPtr = &arraySlot;
	int[] wholeArray = *arrayPtr;
	if (wholeArray.length != 3 || wholeArray[1] != 41 || arrayPtr.length != 3) return 6;
	void<int>[] erasedInts = original;
	int[] recoveredInts = erasedInts;
	erasedInts[2] = 60;
	if (recoveredInts[2] != 60) return 7;

	void<int?>[] items = stackalloc void<int?>[4];
	items[0] = 13;
	items[1] = 17;
	items[2] = default;
	items[3] = 19;
	void<int?>* last = &items[3];
	if (!last.specified || last.value != 19) return 8;
	int? second = items[1];
	if (!second.specified || second.value != 17 || items[2].specified) return 9;
	evaluations = 0;
	items[nextIndex()] = 29;
	if (evaluations != 1) return 11;
	int? evaluated = items[nextIndex()];
	if (evaluations != 2 || !evaluated.specified || evaluated.value != 29) return 12;
	stackalloc void<int?> copied = items[nextIndex()];
	if (evaluations != 3 || !copied.specified || copied.value != 29) return 20;
	stackalloc void<int?*> distributiveSlot = &wholeOptional;
	void<int?*>* distributiveHolder = &distributiveSlot;
	int?* recoveredDistributive = *distributiveHolder;
	(*recoveredDistributive).value = 37;
	if (wholeOptional.value != 37) return 14;
	void<int?>[] slice = items[1..3];
	if (slice.length != 2 || slice[0].value != 29 || slice[1].specified) return 16;

	stackalloc void<Predicate> callable = plusOne;
	void<Predicate>* callablePtr = &callable;
	Predicate wholeCallable = *callablePtr;
	if (wholeCallable(71) != 72 || callable(81) != 82) return 10;
	int carrierResult = carrierStorage();
	if (carrierResult != 0) return carrierResult;
	int stackAllocResult = erasedStackAllocForms();
	if (stackAllocResult != 0) return stackAllocResult;
	Console.writeLine("erased storage passed");
	if (typenameof(void<int?>).Length != typenameof(int).Length || typenameof(void<int?>)[0] != 'I') return 13;
	if (typenameof(void<Integer>).Length != typenameof(int).Length || typenameof(void<Integer>)[0] != 'I') return 21;
	return 0;
}
