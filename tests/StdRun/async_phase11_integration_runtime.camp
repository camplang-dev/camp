using Std;

int posts;
int frees;
int observed;
int observedError;
int rethrowError;

class Resumer
{
	void resumeAsync(escaped once void() continuation)
	{
		posts++;
		continuation();
	}
}

Resumer resumer;

async int lengthAsync<T: any>(const T[] values, sizeof(T), @awaitwith Resumer* resumer)
{
	return (int)values.length;
}

async int failAsync(thrown int error, @awaitwith Resumer* resumer)
{
	throw 9;
}

async int parentAsync(const int[] values, @awaitwith Resumer* resumer)
{
	int count = await lengthAsync(values, resumer);
	int ignored = await failAsync(resumer, catch auto err);
	observedError = err;
	return count + observedError;
}

async int rethrowAsync(@awaitwith Resumer* resumer, thrown int error)
{
	int ignored = await failAsync(resumer);
	return ignored;
}

void complete(void* context, int value)
{
	observed = value;
}

void completeRethrow(void* context, int value, int error)
{
	rethrowError = error;
}

export int main()
{
	auto values = [1, 2, 3, 4];
	parentAsync(values, &resumer, complete, null);
	rethrowAsync(&resumer, completeRethrow, null, catch _);
	Console.write(posts);
	Console.write(frees);
	Console.write(observed);
	Console.write(observedError);
	Console.write(rethrowError);
	return posts == 3 && frees == 0 && observed == 13 && observedError == 9 && rethrowError == 9 ? 0 : 1;
}
