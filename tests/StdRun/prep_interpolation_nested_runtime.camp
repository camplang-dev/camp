using Std;

export void main()
{
	Console.writeLine($"{writeText()[1..3]}");
}

nuint writeText(prep char[] buffer = default)
{
	if (buffer.length > 0)
		buffer[0] = 'a';
	if (buffer.length > 1)
		buffer[1] = 'b';
	if (buffer.length > 2)
		buffer[2] = 'c';
	if (buffer.length > 3)
		buffer[3] = 'd';
	return 4;
}
