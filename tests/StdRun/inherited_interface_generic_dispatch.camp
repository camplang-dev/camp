using Std;

interface IRootPet
{
	int tally(int amount);
	int twice(int amount) = defaultTwice;
}

int defaultTwice(IRootPet* this, int amount)
{
	return this.tally(amount) + this.tally(amount);
}

interface IPet: IRootPet
{
	void feed(int amount);
}

class Pet: IPet
{
	int total;

	int tally(int amount): IRootPet
	{
		this.total += amount;
		return this.total;
	}

	void feed(int amount): IPet
	{
		Console.writeLine(amount);
	}
}

class Dog: Pet
{
}

struct Bird: IPet
{
	int total;

	int tally(int amount): IRootPet
	{
		this.total += amount;
		return this.total;
	}

	void feed(int amount): IPet
	{
	}
}

int twiceGeneric<T>(T* value, vtableof(T: IPet))
{
	return value.twice(2);
}

void feedNonGeneric(IPet* pet, int amount)
{
	pet.feed(amount);
}

this feedGeneric<T>(T* this, int amount, vtableof(T: IPet))
{
	this.feed(amount);
	return this;
}

export void main()
{
	auto dog = new Dog().feedGeneric(1);
	dog.feed(2);
	feedNonGeneric(dog, 3);
	dog.feedGeneric(4);
	IPet* pet = dog;
	pet.feed(5);
	Console.writeLine(twiceGeneric<Dog>(dog));
	IRootPet* dogRoot = dog;
	Console.writeLine(dogRoot.twice(1));
	Bird bird = default;
	Console.writeLine(twiceGeneric<Bird>(&bird));
	IRootPet* birdRoot = &bird;
	Console.writeLine(birdRoot.twice(1));
	IRootPet birdTable = *birdRoot;
	Console.writeLine(birdTable.twice(birdRoot, 1));
	ManyValue value = default;
	Many* valueView = &value;
	checkMany(valueView);
	Console.writeLine(manyGeneric<ManyValue>(&value));
	auto object = new ManyObject() finally delete;
	Many* objectView = object;
	checkMany(objectView);
	Console.writeLine(manyGeneric<ManyObject>(object));
	ManyRight* directRight = object;
	Console.writeLine(directRight.right());
	Many* absent = null;
	ManyRight* absentRight = absent;
	Console.writeLine(absentRight == null);
	auto retained = new EscapedManyValue() finally delete;
	EscapedMany* retainedView = retained;
	Console.writeLine(retainedRight(retainedView).right());
	auto retainedObject = new EscapedManyObject() finally delete;
	EscapedMany* retainedObjectView = retainedObject;
	Console.writeLine(retainedRight(retainedObjectView).right());
	StaticDefaultValue staticDefaults = default;
	StaticDefaultSink* staticView = &staticDefaults;
	Console.writeLine(staticView.fromStruct(10));
	Console.writeLine(staticView.fromClass(10));
	Console.writeLine(staticView.fromStaticClass(10));
	Console.writeLine(vtableof(StaticDefaultValue: StaticDefaultSink).fromStaticClass(&staticDefaults, 10));
	RemarkedBird remarked = default;
	IPet* remarkedView = &remarked;
	Console.writeLine(remarkedView.tally(3));
	IRootPet* remarkedRoot = remarkedView;
	Console.writeLine(remarkedRoot.tally(1));
	Console.writeLine(remarkedView.twice(1));
}

struct RemarkedBird: IPet
{
	int total;
	int tally(int amount): IPet { this.total += amount; return this.total; }
	void feed(int amount): IPet { }
}

interface ManyCommon { int common(); }
interface ManyLeft: ManyCommon { int left(); }
interface ManyRight: ManyCommon
{
	int right();
	int twiceRight() = twiceRight;
}
interface ManyThird { int third(); }
interface Many: ManyLeft, ManyRight, ManyThird { int own(); }

int twiceRight(ManyRight* value) { return value.right() * 2; }

struct ManyValue: Many
{
	int common(): ManyCommon { return 1; }
	int left(): ManyLeft { return 10; }
	int right(): ManyRight { return 20; }
	int third(): ManyThird { return 25; }
	int own(): Many { return 30; }
}

sealed class ManyObject: Many
{
	int padding;
	int common(): ManyCommon { return 1; }
	int left(): ManyLeft { return 10; }
	int right(): ManyRight { return 20; }
	int third(): ManyThird { return 25; }
	int own(): Many { return 30; }
}

Many* onceView(Many* value, int* count)
{
	*count += 1;
	return value;
}

void checkMany(Many* value)
{
	Console.writeLine(value.left());
	Console.writeLine(value.right());
	Console.writeLine(value.third());
	Console.writeLine(value.own());
	ManyRight* right = value;
	Console.writeLine(right.common());
	Console.writeLine(right.right());
	Console.writeLine(value.twiceRight());
	delegate int() saved = value.right;
	Console.writeLine(saved());
	int count = 0;
	Console.writeLine(onceView(value, &count).right());
	Console.writeLine(count);
}

int manyGeneric<T>(T* value, vtableof(T: Many)) { return value.twiceRight(); }

escaped interface EscapedLeft { int left(); }
escaped interface EscapedRight { int right(); }
escaped interface EscapedMany: EscapedLeft, EscapedRight { }
struct EscapedManyValue: EscapedMany
{
	int left(): EscapedLeft { return 10; }
	int right(): EscapedRight { return 20; }
}
escaped class EscapedManyObject: EscapedMany
{
	int left(): EscapedLeft { return 10; }
	int right(): EscapedRight { return 20; }
}
EscapedRight* retainedRight(EscapedMany* value) { return value; }

interface StaticDefaultSink
{
	int write(int value);
	int fromStruct(int value) = DefaultHelpers::StructHelper.twice;
	int fromClass(int value) = ClassHelper.twice;
	int fromStaticClass(int value) = StaticHelper.twice;
}
namespace DefaultHelpers
{
	struct StructHelper
	{
		static int twice(StaticDefaultSink* sink, int value) { return sink.write(value) * 2; }
	}
}
class ClassHelper
{
	static int twice(StaticDefaultSink* sink, int value) { return sink.write(value) * 2; }
}
static class StaticHelper
{
	static int twice(StaticDefaultSink* sink, int value) { return sink.write(value) * 2; }
}
struct StaticDefaultValue: StaticDefaultSink
{
	int write(int value): StaticDefaultSink { return value + 1; }
}
