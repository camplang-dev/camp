using Std;

export int main()
{
	const char[] cafeUtf8 = [(char)'c', (char)'a', (char)'f', (char)0xC3, (char)0xA9];
	const wchar[] cafeUtf16 = "caf\U000000E9";
	const achar[] plainAscii = "plain";

	string copiedUtf8 = null;
	wstring wideFromUtf8 = null;
	astring asciiFromUtf8 = null;
	string utf8FromWide = null;
	wstring copiedWide = null;
	astring asciiFromWide = null;
	string utf8FromAscii = null;
	wstring wideFromAscii = null;
	astring copiedAscii = null;

	copiedUtf8 = cafeUtf8.toString();
	wideFromUtf8 = cafeUtf8.toWString();
	asciiFromUtf8 = cafeUtf8.toAString();

	utf8FromWide = cafeUtf16.toString();
	copiedWide = cafeUtf16.toWString();
	asciiFromWide = cafeUtf16.toAString();

	utf8FromAscii = plainAscii.toString();
	wideFromAscii = plainAscii.toWString();
	copiedAscii = plainAscii.toAString();

	if (cafeUtf16.toString(buffer: default) != 5)
		return 15;
	fixed char[5] exactUtf8 = default;
	if (cafeUtf16.toString(buffer: exactUtf8) != 5)
		return 16;
	if (exactUtf8[..].compareTo(cafeUtf8) != 0)
		return 17;

	if (copiedUtf8[..].compareTo(cafeUtf8) != 0)
		return 1;
	if (wideFromUtf8[..].compareTo(cafeUtf16) != 0)
		return 2;
	if (wideFromUtf8[..].countUChars() != 4)
		return 3;
	if (wideFromUtf8[..].getUChar(3) != (uchar)233)
		return 4;
	if (asciiFromUtf8[..].compareTo("caf?") != 0)
		return 5;

	if (utf8FromWide[..].compareTo(cafeUtf8) != 0)
		return 6;
	if (copiedWide[..].compareTo(cafeUtf16) != 0)
		return 7;
	if (asciiFromWide[..].compareTo("caf?") != 0)
		return 8;

	if (utf8FromAscii[..].compareTo("plain") != 0)
		return 9;
	if (wideFromAscii[..].compareTo("plain") != 0)
		return 10;
	if (copiedAscii[..].compareTo("plain") != 0)
		return 11;

	wstring faceWide = "a\U0001F600b";
	const wchar[] faceSpan = { (const wchar*)faceWide, faceWide.Length };
	string faceUtf8 = null;
	astring faceAscii = null;
	faceUtf8 = faceSpan.toString();
	faceAscii = faceSpan.toAString((achar)'?');

	if (faceUtf8[..].countUChars() != 3)
		return 12;
	if (faceUtf8[..].getUChar(1) != (uchar)128512)
		return 13;
	if (faceAscii[..].compareTo("a?b") != 0)
		return 14;

	return 0;
}
