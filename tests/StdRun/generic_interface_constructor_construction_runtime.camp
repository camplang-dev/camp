sealed class CountingAllocator: Allocator
{
	int allocations;
	int deallocations;

	CountingAllocator()
	{
		this.allocations = 0;
		this.deallocations = 0;
	}

	~CountingAllocator()
	{
	}

	escaped void* alloc(nuint size): Allocator
	{
		this.allocations++;
		return malloc(size);
	}

	escaped void* realloc(void* ptr, nuint newSize): Allocator
	{
		return null;
	}

	void free(void* ptr): Allocator
	{
		this.deallocations++;
		free(ptr);
	}
}

int destroyed = 0;

interface Counted
{
	Counted(int start, within allocator);
	~Counted(within allocator);
}

sealed class CountedBox: Counted
{
	int value;

	CountedBox(int start, within allocator)
	{
		this.value = start;
	}

	~CountedBox(within allocator)
	{
		destroyed++;
	}
}

struct CountedStruct: Counted
{
	int value;

	CountedStruct(int start, within allocator)
	{
		this.value = start;
	}

	~CountedStruct(within allocator)
	{
		destroyed += 10;
	}
}

escaped T* createCounted<T: implements Counted>(Allocator* allocator, int start, vtableof(T: Counted))
{
	return within (allocator) new T(start);
}

void destroyCounted<T: implements Counted>(Allocator* allocator, escaped T* value, vtableof(T: Counted))
{
	within (allocator) delete value;
}

export int main()
{
	CountingAllocator* counting = stackalloc CountingAllocator();
	Allocator* allocator = counting;
	CountedBox* box = createCounted<CountedBox>(allocator, 41);
	if (box == null)
		return 1;
	if (counting.allocations != 1)
		return 2;
	if (box.value != 41)
		return 3;
	within (allocator) delete box;
	if (counting.deallocations != 1)
		return 4;

	fn CountedBox*(int, Allocator*) createSlot = vtableof(CountedBox: Counted).create;
	fn void(CountedBox*, Allocator*) destroySlot = vtableof(CountedBox: Counted).destroy;
	CountedBox* direct = createSlot(57, allocator);
	if (direct == null || direct.value != 57 || counting.allocations != 2)
		return 5;
	destroySlot(direct, allocator);
	if (counting.deallocations != 2)
		return 6;

	fn CountedStruct*(int, Allocator*) structCreate = vtableof(CountedStruct: Counted).create;
	fn void(CountedStruct*, Allocator*) structDestroy = vtableof(CountedStruct: Counted).destroy;
	CountedStruct* structValue = structCreate(72, allocator);
	if (structValue == null || structValue.value != 72 || counting.allocations != 3)
		return 7;
	structDestroy(structValue, allocator);
	if (counting.deallocations != 3)
		return 8;

	destroyed = 0;
	CountedBox* generic = createCounted<CountedBox>(allocator, 7);
	destroyCounted(allocator, generic);
	if (destroyed != 1 || counting.deallocations != 4)
		return 11;
	CountedStruct* genericStruct = createCounted<CountedStruct>(allocator, 8);
	destroyCounted(allocator, genericStruct);
	if (destroyed != 11 || counting.deallocations != 5)
		return 12;
	return 0;
}
