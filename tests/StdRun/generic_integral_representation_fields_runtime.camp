struct Slot<T: uint>
{
	T value;
}

struct Pair<T: long>
{
	T first;
	T second;
}

class Box<T: int>
{
	T value;
	int size() { return (int)sizeof(T); }

	Box(T value)
	{
		this.value = value;
	}
}

export int main()
{
	if (implicitIntegerSize<short>() != 4) return 5;
	auto sized = new Box<short>(123) finally delete;
	if (sized.size() != 4) return 6;
	auto carried = new CarriedSize<byte>(250) finally delete;
	if (carried.width() != 4) return 7;
	Slot<uint>* slot = stackalloc Slot<uint>();
	slot.value = 9;
	uint stored = slot.value;
	if (stored != 9)
		return 1;
	slot.value += 3;
	if (slot.value != 12)
		return 2;

	Pair<long>* pair = stackalloc Pair<long>();
	pair.first = 5000000000;
	pair.second = pair.first + 1;
	if (pair.second != 5000000001)
		return 3;

	Box<int>* box = new Box<int>(17);
	int boxed = box.value;
	delete box;
	if (boxed != 17)
		return 4;

	return 0;
}

int implicitIntegerSize<T: int>() { return (int)sizeof(T); }
virtual class CarriedSizeBase<T: int>
{
	CarriedSizeBase(T seed, sizeof(T)) { }
	int width() { return (int)sizeof(T); }
}
sealed class CarriedSize<T: int>: CarriedSizeBase<T>
{
	CarriedSize(T seed) { base(seed); }
}
