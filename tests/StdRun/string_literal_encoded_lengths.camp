using Std;

export int main()
{
	const char[] box = "┌";
	fixed char[3] boxBytes = [(char)0xE2, (char)0x94, (char)0x8C];
	if (box.length != 3)
		return 1;
	if (box.compareTo(boxBytes[..]) != 0)
		return 2;

	const char[] mixed = "A┌é";
	fixed char[6] mixedBytes = ['A', (char)0xE2, (char)0x94, (char)0x8C, (char)0xC3, (char)0xA9];
	if (mixed.length != 6)
		return 3;
	if (mixed.compareTo(mixedBytes[..]) != 0)
		return 4;

	fixed char[3] interpolatedBox = $"┌";
	if (interpolatedBox[..].compareTo(boxBytes[..]) != 0)
		return 5;

	const wchar[] wide = "Aé\U0001F600";
	if (wide.length != 4)
		return 6;
	if (wide[0] != (wchar)'A' || wide[1] != (wchar)0x00E9 || wide[2] != (wchar)0xD83D || wide[3] != (wchar)0xDE00)
		return 7;

	const achar[] ascii = "ABC";
	if (ascii.length != 3)
		return 8;
	if (ascii[0] != (achar)'A' || ascii[1] != (achar)'B' || ascii[2] != (achar)'C')
		return 9;

	return 0;
}
