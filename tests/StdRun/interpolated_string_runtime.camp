using Std;

export int main()
{
	int count = 42;
	bool ok = true;
	string name = "Camp";

	Console.writeLine($"hello {name}");
	Console.writeLine($"count={count}; ok={ok}; bang={'!'}");
	CharFormatter literalOnly = $"literal only";
	Console.writeLine(literalOnly);
	Console.writeLine($"");

	CharFormatter direct = count.format;
	Console.writeLine($"direct {direct}");

	int counter = 0;
	Console.writeLine($"next={next(&counter)}, then={next(&counter)}, total={counter}");

	CharFormatter sized = $"abc{count}";
	auto buffer = init char[4];
	Console.writeLine(sized(buffer));
	Console.writeLine(makeLiteral());
	Console.writeLine($"{$"Shape is: {name}".getSelf()}");

	return 0;
}

CharFormatter makeLiteral()
{
	return $"returned";
}

this getSelf(CharFormatter this) => this;

int next(int* counter)
{
	(*counter)++;
	return *counter;
}
