using Std;

nuint escapedLength(const char[] this, prep char[] buffer = default)
{
	nuint count = min(this.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return this.length;
}

export int main()
{
	if ("abc".escapedLength() != 3)
		return 1;

	char[] copied = prep "abc".escapedLength();
	if (copied.length != 3)
		return 2;
	if (copied[0] != 'a' || copied[1] != 'b' || copied[2] != 'c')
		return 3;

	return 0;
}
