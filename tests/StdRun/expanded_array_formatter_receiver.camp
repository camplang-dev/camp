using Std;

nuint escapedLength(const char[] this, overload char[] buffer) : CharFormatter
{
	nuint count = min(this.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return this.length;
}

export int main()
{
	CharFormatter formatter = "abc".escapedLength;
	if (formatter() != 3)
		return 1;

	string copied = "abc".escapedLength.copyString() finally delete;
	if (copied.Length != 3)
		return 2;
	if (copied[0] != 'a' || copied[1] != 'b' || copied[2] != 'c')
		return 3;

	return 0;
}
