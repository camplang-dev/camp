export int main()
{
	auto items = [1, 2, 3];
	int total = 0;
	foreach (int value in items) total += value;
	foreach (int value in items) total += value;
	int value = 10;
	foreach (int outer in items)
	{
		foreach (int inner in items) total += inner;
		total += outer;
	}
	foreach (int item in items)
	{
		if (item == 1) continue;
		total += item;
		break;
	}
	return total == 38 && value == 10 ? 0 : 1;
}
