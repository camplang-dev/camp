export int main()
{
	auto items = [1, 2, 3];
	int total = 0;
	foreach (int value in items) total += value;
	foreach (int value in items) total += value;
	int value = 10;
	foreach (int value in items)
	{
		foreach (int value in items) total += value;
		total += value;
	}
	foreach (int items in items)
	{
		if (items == 1) continue;
		total += items;
		break;
	}
	return total == 38 && value == 10 ? 0 : 1;
}
