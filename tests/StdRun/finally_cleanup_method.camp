using Std;

int total;

struct CleanupProbe
{
	void add(int value)
	{
		total = total + value;
	}
}

void runCleanup()
{
	int value = 2;
	CleanupProbe probe = default;
	auto guarded = probe finally add(value);
	value = 5;
	if (total != 0)
		total = 100;
}

export int main()
{
	total = 0;
	runCleanup();
	if (total != 5)
		return total;
	return 0;
}
