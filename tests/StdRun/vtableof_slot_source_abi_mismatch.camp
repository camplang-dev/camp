using Std;

internal interface IRefCount
{
	void retain();
	void release();
}

fn void(RefThing* context)[] releaseFunctions;
nuint usedReleaseFunctions;

void addReleaseFunction(fn void(RefThing* context) releaseFunction)
{
	releaseFunctions[usedReleaseFunctions] = releaseFunction;
	usedReleaseFunctions++;
}

void captureRelease<T: implements IRefCount>(T* value, out fn void(T*) release, vtableof(T: IRefCount))
{
	release = vtableof_T_IRefCount.release;
}

class RefThing: IRefCount
{
	int* releases;

	RefThing(unscoped int* releases)
	{
		this.releases = releases;
	}

	void retain(): IRefCount
	{
	}

	void release(): IRefCount
	{
		(*this.releases)++;
	}
}

export int main()
{
	int releases = 0;
	releaseFunctions = new fn void(RefThing*)[1];
	auto thing = new RefThing(&releases) finally delete;
	fn void(RefThing*) release = null;
	captureRelease<RefThing>(thing, out release);
	addReleaseFunction(release);

	fn void(RefThing*)[] copiedReleaseFunctions = new fn void(RefThing*)[1];
	releaseFunctions.copyTo<fn void(RefThing*)>(copiedReleaseFunctions);
	delete releaseFunctions;
	releaseFunctions = copiedReleaseFunctions;

	releaseFunctions[0](thing);
	delete releaseFunctions;
	Console.writeLine(releases);
	return 0;
}
