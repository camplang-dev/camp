struct View { const char[] text; }
const char[] span(View view) { return view.text; }
struct iter int lengths(View this)
{
	const char[] value = span(this);
	yield (int)value.length;
	value = this.text[..2];
	yield (int)value.length;
}
struct iter int copied(const char[] text)
{
	const char[] value = text;
	yield (int)value.length;
	yield (int)value.length;
}
class iter int pointed(const int* pointer)
{
	const int* value = pointer;
	yield *value;
	value = pointer;
	yield *value;
}
struct W { int n; }
int scratchLength(const char[] text) { return (int)text.length; }
struct iter int scratchBeforeYield()
{
	char[] scratch = stackalloc char[16];
	scratch[0] = 'a';
	int value = (int)scratch[0];
	yield value;
}
struct iter int scratchHelper()
{
	char[] scratch = stackalloc char[16];
	yield scratchLength(scratch);
}
class iter int scratchPointer()
{
	W* value = stackalloc W();
	value.n = 3;
	int copy = value.n;
	yield copy;
}
struct iter int scratchReassigned()
{
	char[] scratch = stackalloc char[16];
	scratch[0] = 'a';
	yield (int)scratch[0];
	scratch = stackalloc char[16];
	scratch[0] = 'b';
	yield (int)scratch[0];
}
struct iter const char[] resetView(bool first)
{
	char[] scratch = stackalloc char[16];
	const char[] view = scratch;
	if (first) view = "a";
	else view = "b";
	yield view;
}
export int main()
{
	View view = { "abcdef" };
	int number = 7;
	int total = 0;
	foreach (int viewLength in view.lengths()) total += viewLength;
	foreach (int copiedLength in copied(view.text)) total += copiedLength;
	foreach (int pointedValue in pointed(&number)) total += pointedValue;
	foreach (int value in scratchBeforeYield()) total += value;
	foreach (int value in scratchHelper()) total += value;
	foreach (int value in scratchPointer()) total += value;
	foreach (int value in scratchReassigned()) total += value;
	foreach (const char[] value in resetView(true)) total += (int)value.length;
	foreach (const char[] value in resetView(false)) total += (int)value.length;
	return total == 347 ? 0 : 1;
}
