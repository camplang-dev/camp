using Std;

int created;
int numbers;
int signs;

export int main()
{
	string text = $"Value: {makeGreeter()}!";
	Console.writeLine(text);
	Console.writeLine(created);
	Console.writeLine($"Number: {makeNumber().toString(nextSign())}");
	Console.writeLine(numbers);
	Console.writeLine(signs);
	fixed char[4] fixedText = $"{makeNumber().toString(nextSign())}";
	Console.write(fixedText[0]);
	Console.writeLine(fixedText[1]);
	Console.writeLine(numbers);
	Console.writeLine(signs);
	return 0;
}

Greeter makeGreeter()
{
	created++;
	Greeter value = default;
	value.name = "Camp";
	return value;
}

struct Greeter
{
	string name;
}

enum Sign
{
	NONE = 0,
	PLUS
}

Number makeNumber()
{
	numbers++;
	Number value = default;
	value.value = 7;
	return value;
}

Sign nextSign()
{
	signs++;
	return Sign.PLUS;
}

struct Number
{
	int value;
}

nuint toString(in Greeter this, prep char[] buffer = default)
{
	if (buffer.length > 0)
		buffer[0] = 'H';
	if (buffer.length > 1)
		buffer[1] = 'i';
	if (buffer.length > 2)
		buffer[2] = ',';
	if (buffer.length > 3)
		buffer[3] = ' ';

	char[] tail = { &buffer[4], buffer.length > 4 ? buffer.length - 4 : 0 };
	this.name.toString(tail);
	return 4 + this.name.Length;
}

nuint toString(in Number this, Sign sign = Sign.NONE, prep char[] buffer = default)
{
	nuint offset = 0;
	if (sign == Sign.PLUS)
	{
		if (buffer.length > 0)
			buffer[0] = '+';
		offset = 1;
	}

	char[] tail = default;
	if (buffer.length > offset)
		tail = { &buffer[offset], buffer.length - offset };
	this.value.toString(tail);
	return offset + this.value.toString(default);
}
