T? maybe<T: copyable>(fn T?(int) look, int index, sizeof(T)) => look(index);
T produce<T: copyable>(fn T(int) look, int index, sizeof(T)) => look(index);
int? intOpt(int index)
{
	if (index > 0) return index;
	return default;
}
void<int> scalarWritten(int index) => index + 1;
struct Point { int x; int y; }
Point? pointOpt(int index)
{
	if (index <= 0) return default;
	Point value = { index, index + 1 };
	return value;
}
int?? optionalOpt(int index)
{
	if (index <= 0) return default;
	int? inner = index;
	return inner;
}
export int main()
{
	int? present = maybe<int>(i => intOpt(i), 6);
	int? absent = maybe<int>(i => intOpt(i), -1);
	if (!present.specified || present.value != 6) return 1;
	if (absent.specified || absent.value != 0) return 2;
	Point? point = maybe<Point>(i => pointOpt(i), 4);
	if (!point.specified || point.value.x != 4 || point.value.y != 5) return 3;
	int?? nested = maybe<int?>(i => optionalOpt(i), 9);
	if (!nested.specified || !nested.value.specified || nested.value.value != 9) return 4;
	nested = maybe<int?>(i => optionalOpt(i), -1);
	if (nested.specified || nested.value.specified || nested.value.value != 0) return 5;
	if (produce<int>(scalarWritten, 6) != 7) return 6;
	return 0;
}
