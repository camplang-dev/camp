bool tryLook<T: copyable>(fn bool(int, out T) look, int index, out T result, sizeof(T)) => look(index, out result);
T produce<T: copyable>(fn T(int) look, int index, sizeof(T)) => look(index);
bool tryInt(int index, out int result)
{
	result = index > 0 ? index : 0;
	return index > 0;
}
void<int> scalarWritten(int index) => index + 1;
struct Point { int x; int y; }
bool tryPoint(int index, out Point result)
{
	Point value = { index, index + 1 };
	if (index <= 0) value = { 0, 0 };
	result = value;
	return index > 0;
}
bool tryOptional(int index, out void<int?> result)
{
	int? inner = default;
	if (index > 0) inner = index;
	result = inner;
	return index > 0;
}
export int main()
{
	int present = 0;
	int absent = 7;
	if (!tryLook<int>(tryInt, 6, out present) || present != 6) return 1;
	if (tryLook<int>(tryInt, -1, out absent) || absent != 0) return 2;
	Point point = { 0, 0 };
	if (!tryLook<Point>(tryPoint, 4, out point) || point.x != 4 || point.y != 5) return 3;
	int? nested = default;
	if (!tryLook<int?>(tryOptional, 9, out nested) || !nested.specified || nested.value != 9) return 4;
	if (tryLook<int?>(tryOptional, -1, out nested) || nested.specified || nested.value != 0) return 5;
	if (produce<int>(scalarWritten, 6) != 7) return 6;
	return 0;
}
