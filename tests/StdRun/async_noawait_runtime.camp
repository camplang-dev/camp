int observed;
int allocatorObserved;
int propertyObserved;

class Box
{
	@noawait
	async int getValue()
	{
		return 5;
	}
}

@noawait
async int answerAsync()
{
	return 42;
}

@noawait
async int answerWithAllocatorAsync(within allocator)
{
	return 7;
}

void complete(void* context, int value)
{
	observed = value;
}

void completeAllocator(void* context, int value)
{
	allocatorObserved = value;
}

void completeProperty(void* context, int value)
{
	propertyObserved = value;
}

export int main()
{
	answerAsync(complete, null);
	answerWithAllocatorAsync(within null, completeAllocator, null);
	auto box = new Box();
	box.Value(completeProperty, null);
	return observed == 42 && allocatorObserved == 7 && propertyObserved == 5 ? 0 : 1;
}
