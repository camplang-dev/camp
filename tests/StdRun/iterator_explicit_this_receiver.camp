using Std;

struct Range
{
	int first;
	int last;
}

struct iter int values(Range this)
{
	for (int i = this.first; i <= this.last; i++)
		yield i;
}

struct iter int pointerValues(Range* this)
{
	for (int i = this.first; i <= this.last; i++)
		yield i;
}

export int main()
{
	Range range = { 1, 3 };
	Range* pointer = &range;
	int total = 0;
	{
		foreach (int value in range.values())
			total += value;
	}
	{
		foreach (int value in pointer.pointerValues())
			total += value;
	}
	return total == 12 ? 0 : 1;
}
