T? maybe<T: copyable>(delegate bool(int) look, int index = 6, sizeof(T)) => default;
T? selected<T: copyable>(delegate bool(int) look, in T value, int index, sizeof(T))
{
	if (look(index)) return value;
	return default;
}
bool yes(int index) => true;
export int main()
{
	int? first = maybe<int>(yes, 6);
	int? second = maybe<int>(index => true, 6);
	int offset = 3;
	int? third = maybe<int>(index => index > offset, 6);
	delegate bool(int) predicate = yes;
	int? fourth = maybe<int>(predicate, 6);
	int? fifth = maybe<int>(yes);
	if (first.specified || second.specified || third.specified || fourth.specified || fifth.specified) return 1;
	if (first.value != 0 || third.value != 0) return 2;
	int value = 17;
	int? present = selected<int>(yes, value, 6);
	int? absent = selected<int>(index => index > offset, value, 1);
	if (!present.specified || present.value != 17) return 3;
	if (absent.specified || absent.value != 0) return 4;
	return 0;
}
