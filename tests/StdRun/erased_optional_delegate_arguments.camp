T maybe<T>(delegate bool(int) look, int index = 6, sizeof(T)) => default;
bool selected<T>(delegate bool(int) look, in T value, int index, out T result, sizeof(T))
{
	result = default;
	if (!look(index)) return false;
	result = value;
	return true;
}
bool yes(int index) => true;
export int main()
{
	int first = maybe<int>(yes, 6);
	int second = maybe<int>(index => true, 6);
	int offset = 3;
	int third = maybe<int>(index => index > offset, 6);
	delegate bool(int) predicate = yes;
	int fourth = maybe<int>(predicate, 6);
	int fifth = maybe<int>(yes);
	if (first != 0 || second != 0 || third != 0 || fourth != 0 || fifth != 0) return 1;
	int? optionalFirst = maybe<int?>(yes, 6);
	if (optionalFirst.specified || optionalFirst.value != 0) return 2;
	int value = 17;
	int present = 0;
	int absent = 5;
	if (!selected<int>(yes, value, 6, out present) || present != 17) return 3;
	if (selected<int>(index => index > offset, value, 1, out absent) || absent != 0) return 4;
	return 0;
}
