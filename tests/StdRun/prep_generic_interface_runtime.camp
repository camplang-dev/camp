interface Namer
{
	nuint name(prep char[] buffer = default);
}

struct Plain: Namer
{
	nuint name(prep char[] buffer = default): Namer
	{
		if (buffer.length > 0) buffer[0] = 'a';
		if (buffer.length > 1) buffer[1] = 'b';
		if (buffer.length > 2) buffer[2] = 'c';
		return 3;
	}
}

int check<T>(T* value, vtableof(T: Namer))
{
	char[] made = value.name();
	if (made.length != 3 || made[0] != 'a' || made[2] != 'c') return 1;
	if (value.name().length != 3) return 2;
	if (value.name(buffer: default) != 3) return 3;
	char[] buffer = stackalloc char[3];
	if (value.name(buffer: buffer) != 3 || buffer[1] != 'b') return 4;
	return 0;
}

export int main()
{
	Plain plain = default;
	return check<Plain>(&plain);
}
