class Resumer
{
	void resumeAsync(escaped once void() continuation)
	{
		continuation();
	}
}

Resumer resumer;
int valueObserved;
int voidObserved;
int propertyObserved;
int receiverObserved;
int asyncResumerObserved;

class Box
{
	int value;

	@noawait
	async int getValue()
	{
		return this.value;
	}
}

class ReceiverBox
{
	int value;
	int resumes;

	void resumeAsync(escaped once void() continuation)
	{
		this.resumes++;
		continuation();
	}

	async int compute()
	{
		int value = await valueAsync(&resumer);
		return this.value + value + this.resumes;
	}
}

class AsyncResumer
{
	@noawait
	async void resumeAsync()
	{
		return;
	}
}

AsyncResumer asyncResumer;

async int valueAsync(@awaitwith Resumer* resumer)
{
	return 17;
}

async int parentValueAsync(@awaitwith Resumer* resumer)
{
	return await valueAsync(resumer);
}

async void pingAsync(@awaitwith Resumer* resumer)
{
	voidObserved = 3;
	return;
}

async void parentVoidAsync(@awaitwith Resumer* resumer)
{
	return await pingAsync(resumer);
}

async int parentPropertyAsync(Box* box, @awaitwith Resumer* resumer)
{
	return await box.Value();
}

async int valueWithAsyncResumer(@awaitwith AsyncResumer* resumer)
{
	return 11;
}

async int parentWithAsyncResumer(@awaitwith AsyncResumer* resumer)
{
	return await valueWithAsyncResumer(resumer);
}

void completeValue(void* context, int value)
{
	valueObserved = value;
}

void completeProperty(void* context, int value)
{
	propertyObserved = value;
}

void completeReceiver(void* context, int value)
{
	receiverObserved = value;
}

void completeAsyncResumer(void* context, int value)
{
	asyncResumerObserved = value;
}

void completeVoid(void* context)
{
}

export int main()
{
	parentValueAsync(&resumer, completeValue, null);
	parentVoidAsync(&resumer, completeVoid, null);

	auto box = new Box();
	box.value = 22;
	parentPropertyAsync(box, &resumer, completeProperty, null);
	auto receiverBox = new ReceiverBox();
	receiverBox.value = 4;
	receiverBox.compute(completeReceiver, null);
	parentWithAsyncResumer(&asyncResumer, completeAsyncResumer, null);

	return valueObserved == 17 && voidObserved == 3 && propertyObserved == 22 && receiverObserved == 22 && asyncResumerObserved == 11 ? 0 : 1;
}
