using Std;

export void main()
{
	int[] items = [1, 2, 3, 4, 5];
	foreach (auto number in items.iterate().reverse())
	{
		Console.writeLine(number);
	}

	Point point = { .x = 3 };
	Point* mutable = &point;
	const Point*[] constPointers = [mutable];
	foreach (auto constPointer in constPointers.iterate())
	{
		const Point* checked = constPointer;
		Console.writeLine(checked.x);
	}
	Point*[] mutablePointers = [mutable];
	foreach (auto mutablePointer in mutablePointers.iterate())
	{
		mutablePointer.x = 9;
	}
	Console.writeLine(point.x);
}

struct Point
{
	int x;
}

struct iter T iterate<T: copyable>(const T[] this, sizeof(T))
{
	foreach (auto item in this)
	{
		yield item;
	}
}

struct iter T reverse<T: copyable>(iter T this, sizeof(T), within allocator)
{
	auto list = new List<T>() finally delete;
	foreach (auto item in this)
	{
		list.add(item);
	}
	for (nuint i = 1; i <= list.Length; i++)
	{
		yield list.Item[^i];
	}
}
