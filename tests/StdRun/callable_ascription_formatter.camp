using Std;

export int main(string[] args)
{
	Point* pt = new Point();
	pt.x = 5;
	pt.y = 2;

	Console.writeLine(prep pt.format());

	return 0;
}

class Point
{
	int x;
	int y;

	nuint format(prep char[] buffer = default)
	{
		if (buffer.length < 4)
			return 4;
		buffer[0] = (char)('0' + this.x);
		buffer[1] = ',';
		buffer[2] = ' ';
		buffer[3] = (char)('0' + this.y);

		return 4;
	}
}
