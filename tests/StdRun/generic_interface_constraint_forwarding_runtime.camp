interface Counter
{
	int read();
}

sealed class First: Counter
{
	int value;

	First(int value)
	{
		this.value = value;
	}

	int read(): Counter
	{
		return this.value;
	}
}

struct Second: Counter
{
	int value;

	int read(): Counter
	{
		return this.value;
	}
}

int readOne<T>(T* value, vtableof(T: Counter))
{
	int viaMethod = value.read();
	int viaNamedCapability = vtableof_T_Counter.read(value);
	return viaMethod == viaNamedCapability ? viaMethod : -1;
}

int forwardExplicit<T>(T* value, vtableof(T: Counter))
{
	return readOne<T>(value);
}

int forwardInferred<T>(T* value, vtableof(T: Counter))
{
	return readOne(value);
}

struct iter int readThroughIterator<T>(T* value, vtableof(T: Counter))
{
	yield vtableof(T: Counter).read(value);
	yield value.read();
}

int readThroughLambda<T>(T* value, vtableof(T: Counter))
{
	delegate int() read = () => vtableof_T_Counter.read(value);
	return read();
}

fixed struct Third: Counter
{
	fixed int[2] cells;

	int read(): Counter
	{
		return this.cells[0];
	}
}

int pairRead<T, U>(T* first, U* second, vtableof(T: Counter), vtableof(U: Counter))
{
	return first.read() * 100 + second.read();
}

int swappedRead<T, U>(T* first, U* second, vtableof(T: Counter), vtableof(U: Counter))
{
	return pairRead<U, T>(second, first);
}

int readIndirect<T>(in T value, sizeof(T), vtableof(T: Counter))
{
	return vtableof(T: Counter).read(&value);
}

sealed class Dispatcher<T>
{
	Dispatcher(vtableof(T: Counter)) { }

	int read(T* value) { return value.read(); }
	int readOther<U>(U* value, vtableof(U: Counter)) { return value.read(); }
}

sealed class Keeper<T>
{
	Keeper(sizeof(T), typenameof(T), vtableof(T: Counter)) { }

	int read(T* value) { return value.read(); }
	nuint width() { return sizeof(T); }
	int labelStart() { return typenameof(T)[0]; }
	int copyRead(T* target, T* source)
	{
		*target = *source;
		return target.read();
	}
}

int readAll<T>(T* value, sizeof(T), typenameof(T), vtableof(T: Counter))
{
	return value.read() + (int)sizeof(T) + (int)typenameof(T)[0];
}

int forwardExpressions<T>(T* value, sizeof(T), typenameof(T), vtableof(T: Counter))
{
	return readAll<T>(value, sizeof(T), typenameof(T), vtableof(T: Counter));
}

int forwardNames<T>(T* value, sizeof(T), typenameof(T), vtableof(T: Counter))
{
	return readAll<T>(value, sizeof_T, typenameof_T, vtableof_T_Counter);
}

export int main()
{
	First* first = stackalloc First(4);
	if (forwardExplicit<First>(first) != 4)
		return 1;
	if (forwardInferred(first) != 4)
		return 2;
	int firstTotal = 0;
	foreach (auto firstItem in readThroughIterator<First>(first))
		firstTotal += firstItem;
	if (firstTotal != 8 || readThroughLambda<First>(first) != 4)
		return 5;
	Second second = default;
	second.value = 9;
	if (forwardExplicit<Second>(&second) != 9)
		return 3;
	if (forwardInferred(&second) != 9)
		return 4;
	int secondTotal = 0;
	foreach (auto secondItem in readThroughIterator<Second>(&second))
		secondTotal += secondItem;
	if (secondTotal != 18 || readThroughLambda<Second>(&second) != 9)
		return 6;

	if (swappedRead<First, Second>(first, &second) != 904 || swappedRead<Second, First>(&second, first) != 409)
		return 7;
	if (readIndirect(second) != 9)
		return 8;
	Third third = default;
	third.cells[0] = 12;
	Dispatcher<First>* classDispatcher = new Dispatcher<First>();
	Dispatcher<Third>* fixedDispatcher = new Dispatcher<Third>();
	if (classDispatcher.read(first) != 4 || fixedDispatcher.read(&third) != 12)
		return 9;
	if (classDispatcher.readOther<Second>(&second) != 9 || fixedDispatcher.readOther<First>(first) != 4)
		return 10;
	Keeper<Second>* keeper = new Keeper<Second>();
	Second copied = default;
	if (keeper.read(&second) != 9 || keeper.width() != sizeof(Second) || keeper.labelStart() != 'S')
		return 11;
	if (keeper.copyRead(&copied, &second) != 9 || copied.value != 9)
		return 12;
	int allEvidence = 9 + (int)sizeof(Second) + 'S';
	if (readAll<Second>(&second) != allEvidence || forwardExpressions(&second) != allEvidence || forwardNames(&second) != allEvidence)
		return 13;
	if (readAll<Second>(&second, sizeof(Second), typenameof(Second), vtableof(Second: Counter)) != allEvidence)
		return 14;
	return 0;
}
