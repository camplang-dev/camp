interface Counter
{
	int read();
}

sealed class First: Counter
{
	int value;

	First(int value)
	{
		this.value = value;
	}

	int read(): Counter
	{
		return this.value;
	}
}

struct Second: Counter
{
	int value;

	int read(): Counter
	{
		return this.value;
	}
}

int readOne<T: implements Counter>(T* value, vtableof(T: Counter))
{
	int viaMethod = value.read();
	int viaNamedCapability = vtableof_T_Counter.read(value);
	return viaMethod == viaNamedCapability ? viaMethod : -1;
}

int forwardExplicit<T: implements Counter>(T* value, vtableof(T: Counter))
{
	return readOne<T>(value);
}

int forwardInferred<T: implements Counter>(T* value, vtableof(T: Counter))
{
	return readOne(value);
}

export int main()
{
	First* first = stackalloc First(4);
	if (forwardExplicit<First>(first) != 4)
		return 1;
	if (forwardInferred(first) != 4)
		return 2;
	Second second = default;
	second.value = 9;
	if (forwardExplicit<Second>(&second) != 9)
		return 3;
	if (forwardInferred(&second) != 9)
		return 4;
	return 0;
}
