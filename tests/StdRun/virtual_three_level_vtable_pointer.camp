export virtual class Component
{
	int ordinary(int delta) { return 2 + delta; }

	export Component()
	{
	}

	export virtual int value()
	{
		return 1;
	}
}

export virtual class Control: Component
{
	export Control()
	{
	}

	export override int value()
	{
		return 2;
	}

	export virtual int controlValue()
	{
		return 20;
	}
}

export sealed class Form: Control
{
	int baseOrdinary() { return base.ordinary(5); }
	int baseVirtual() { return base.value(); }

	int own;
	export Form()
	{
	}

	export override int value()
	{
		return 3;
	}

	export override int controlValue()
	{
		return 30;
	}
}

export int main()
{
	if (testGenericVirtuals() != 0) return 6;
	if (testGenericDerivedVirtuals() != 0) return 7;
	if (testGenericBaseCalls() != 0) return 8;
	auto plain = stackalloc PlainLeaf();
	if (plain.twice() != 6) return 4;
	auto square = stackalloc Square();
	Shape* shape = square;
	if (shape.area() != 7) return 1;
	auto inherited = stackalloc Inherited();
	Shape* inheritedShape = inherited;
	if (inheritedShape.area() != 9) return 2;
	Component* direct = new Form() { .own = 5 };
	Form* directForm = (unsafe Form*)direct;
	if (direct.value() != 3 || directForm.own != 5) return 3;
	delete direct;
	Form* form = new Form();
	if (form.baseOrdinary() != 7 || form.baseVirtual() != 2) return 5;
	Component* component = (Component*)form;
	Control* control = (Control*)form;
	int result = component.value() * 10 + control.controlValue();
	delete component;
	return result == 60 ? 0 : result;
}

abstract class Shape { abstract int area(); }
abstract class Half: Shape { }
sealed class Square: Half { override int area() { return 7; } }
virtual class Filled: Half { sealed int area() { return 9; } }
virtual class Gap: Filled { }
sealed class Inherited: Gap { }

class PlainRoot { int value() { return 3; } }
class PlainMiddle: PlainRoot { }
sealed class PlainLeaf: PlainMiddle { int twice() { return base.value() * 2; } }

virtual class GenericVirtualBox<T>
{
	T* held;
	virtual T* get() { return this.held; }
	virtual ~GenericVirtualBox() { }
}
sealed class ConcreteVirtualBox: GenericVirtualBox<int>
{
	override int* get() { return null; }
	override ~ConcreteVirtualBox() { }
}
virtual class GenericVirtualNum<T: int>
{
	virtual T next(T value) { return value; }
}
sealed class ConcreteVirtualNum: GenericVirtualNum<byte>
{
	override int<byte> next(int<byte> value) { return value; }
}
abstract class GenericVirtualSource<T> { abstract T* take(); }
abstract class GenericVirtualGap<U>: GenericVirtualSource<U> { }
sealed class ConcreteVirtualSource: GenericVirtualGap<int>
{
	override int* take() { return null; }
}
int testGenericVirtuals()
{
	GenericVirtualBox<int>* box = new ConcreteVirtualBox() finally delete;
	if (box.get() != null) return 1;
	GenericVirtualNum<byte>* number = new ConcreteVirtualNum() finally delete;
	if ((int)number.next(250) != 250) return 2;
	GenericVirtualSource<int>* source = new ConcreteVirtualSource() finally delete;
	if (source.take() != null) return 3;
	auto inherited = new GenericVirtualBox<int>() finally delete;
	if (inherited.get() != null) return 4;
	return 0;
}

virtual class SameNameBox<T> { T* held; virtual T* peek() { return this.held; } virtual ~SameNameBox() { } }
sealed class SameNameTagged<T>: SameNameBox<T> { override T* peek() { return this.held; } override ~SameNameTagged() { } }
sealed class SameNameHeld<T>: SameNameBox<T*> { override T** peek() { return this.held; } override ~SameNameHeld() { } }
virtual class SameNameDuo<A, B> { A* a; B* b; virtual A* first() { return this.a; } virtual B* second() { return this.b; } virtual ~SameNameDuo() { } }
sealed class SameNameKept<A, B>: SameNameDuo<A, B> { override A* first() { return this.a; } override B* second() { return this.b; } override ~SameNameKept() { } }
sealed class SameNameSwapped<A, B>: SameNameDuo<B, A> { override B* first() { return this.a; } override A* second() { return this.b; } override ~SameNameSwapped() { } }
int testGenericDerivedVirtuals()
{
	SameNameBox<long>* tagged = new SameNameTagged<long>() finally delete;
	if (tagged.peek() != null) return 1;
	SameNameBox<long*>* held = new SameNameHeld<long>() finally delete;
	if (held.peek() != null) return 2;
	SameNameDuo<long, int>* kept = new SameNameKept<long, int>() finally delete;
	if (kept.first() != null || kept.second() != null) return 3;
	SameNameDuo<int, long>* swapped = new SameNameSwapped<long, int>() finally delete;
	if (swapped.first() != null || swapped.second() != null) return 4;
	return 0;
}

virtual class BaseCallNum<T: int> { virtual T same(T v) { return v; } virtual ~BaseCallNum() { } }
virtual class BaseCallMidNum<U: int>: BaseCallNum<U> { override U same(U v) { return v; } }
sealed class BaseCallByte: BaseCallMidNum<byte> { override int<byte> same(int<byte> v) { return base.same(v); } override ~BaseCallByte() { } }
virtual class BaseCallBox<T> { virtual int check(T* p) { return 1; } virtual ~BaseCallBox() { } }
virtual class BaseCallMid<U>: BaseCallBox<U*> { override int check(U** p) { return 2; } }
sealed class BaseCallLeaf<V>: BaseCallMid<V> { override int check(V** p) { return base.check(p) + 1; } override ~BaseCallLeaf() { } }
int testGenericBaseCalls()
{
	BaseCallNum<byte>* number = new BaseCallByte() finally delete;
	if ((int)number.same((int<byte>)201) != 201) return 1;
	BaseCallBox<long*>* leaf = new BaseCallLeaf<long>() finally delete;
	long* held = null;
	if (leaf.check(&held) != 3) return 2;
	return 0;
}
