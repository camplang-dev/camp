export virtual class Component
{
	int ordinary(int delta) { return 2 + delta; }

	export Component()
	{
	}

	export virtual int value()
	{
		return 1;
	}
}

export virtual class Control: Component
{
	export Control()
	{
	}

	export override int value()
	{
		return 2;
	}

	export virtual int controlValue()
	{
		return 20;
	}
}

export sealed class Form: Control
{
	int baseOrdinary() { return base.ordinary(5); }
	int baseVirtual() { return base.value(); }

	int own;
	export Form()
	{
	}

	export override int value()
	{
		return 3;
	}

	export override int controlValue()
	{
		return 30;
	}
}

export int main()
{
	auto plain = stackalloc PlainLeaf();
	if (plain.twice() != 6) return 4;
	auto square = stackalloc Square();
	Shape* shape = square;
	if (shape.area() != 7) return 1;
	auto inherited = stackalloc Inherited();
	Shape* inheritedShape = inherited;
	if (inheritedShape.area() != 9) return 2;
	Component* direct = new Form() { .own = 5 };
	Form* directForm = (unsafe Form*)direct;
	if (direct.value() != 3 || directForm.own != 5) return 3;
	delete direct;
	Form* form = new Form();
	if (form.baseOrdinary() != 7 || form.baseVirtual() != 2) return 5;
	Component* component = (Component*)form;
	Control* control = (Control*)form;
	int result = component.value() * 10 + control.controlValue();
	delete component;
	return result == 60 ? 0 : result;
}

abstract class Shape { abstract int area(); }
abstract class Half: Shape { }
sealed class Square: Half { override int area() { return 7; } }
virtual class Filled: Half { sealed int area() { return 9; } }
virtual class Gap: Filled { }
sealed class Inherited: Gap { }

class PlainRoot { int value() { return 3; } }
class PlainMiddle: PlainRoot { }
sealed class PlainLeaf: PlainMiddle { int twice() { return base.value() * 2; } }
