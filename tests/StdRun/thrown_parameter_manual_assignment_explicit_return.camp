int ordinary(int first, int second, int expected, thrown int failure)
{
	if (first + second != expected)
		failure = 1;
	return 0;
}

export int main()
{
	int failure = 0;
	ordinary(1, 2, 3, catch failure);
	if (failure != 0)
		return 1;

	ordinary(1, 2, 999, catch failure);
	if (failure != 1)
		return 2;

	return 0;
}
