int lengthThrough(const int[]* source) { return (int)(*source).length; }
int firstThrough(const int[]* source) { return (*source)[0]; }
void update(int[]* source) { (*source)[1] = 25; }
export int main()
{
	int[] values = [10, 20, 30];
	if (lengthThrough(&values) != 3 || firstThrough(&values) != 10) return 1;
	int[]* pointer = &values;
	if (lengthThrough(pointer) != 3 || firstThrough(pointer) != 10) return 2;
	const int[] immutable = values;
	if (lengthThrough(&immutable) != 3) return 3;
	const int[]* immutablePointer = &immutable;
	if (firstThrough(immutablePointer) != 10) return 4;
	update(&values);
	if (values[1] != 25) return 5;
	update(pointer);
	return values[1] == 25 ? 0 : 6;
}
