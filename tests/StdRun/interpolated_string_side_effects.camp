using Std;

export void main()
{
	Console.writeLine($"Result: {Greeter.instance().action1().action2().complete()}");
}

struct Greeter
{
	static Greeter instance()
	{
		Console.writeLine("instance");
		return default;
	}

	Greeter action1()
	{
		Console.writeLine("action1");
		return *this;
	}

	Greeter action2()
	{
		Console.writeLine("action2");
		return *this;
	}

	string complete()
	{
		Console.writeLine("complete");
		return "complete";
	}
}
