using Std;

public nuint escapedLength(const char[] this, overload char[] buffer) : CharFormatter
{
	nuint count = min(this.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return this.length;
}

export int main()
{
	string copied = "abc".escapedLength.copyString() finally delete;
	if (copied.compareTo("abc") != 0)
		return 1;

	string text = "hello";
	string copiedText = text.format.copyString() finally delete;
	if (copiedText.compareTo("hello") != 0)
		return 2;

	string copiedChar = 'x'.format.copyString() finally delete;
	if (copiedChar.compareTo("x") != 0)
		return 3;

	fixed char[4] buffer = default;
	char[] span = buffer;
	nuint required = "xy".escapedLength(span);
	if (required != 2 || buffer[0] != 'x' || buffer[1] != 'y')
		return 4;

	fixed char[1] shortBuffer = default;
	char[] shortSpan = shortBuffer;
	required = "xy".escapedLength(shortSpan);
	if (required != 2 || shortBuffer[0] != 'x')
		return 5;

	return 0;
}
