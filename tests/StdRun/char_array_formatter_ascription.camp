using Std;

public nuint escapedLength(const char[] this, prep char[] buffer = default)
{
	nuint count = min(this.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return this.length;
}

const char[] middle(const char[] value)
{
	return value[1..4];
}

void writeSeparator(CharWriter writer, bool compact)
{
	writer.write(compact ? ":" : ": ");
}

export int main()
{
	char[] copied = "abc".escapedLength();
	if (copied.compareTo("abc") != 0)
		return 1;

	string text = "hello";
	char[] copiedText = text.toString();
	if (copiedText.compareTo("hello") != 0)
		return 2;

	char[] copiedChar = 'x'.toString();
	if (copiedChar.compareTo("x") != 0)
		return 3;

	fixed char[4] buffer = default;
	char[] span = buffer;
	nuint required = "xy".escapedLength(span);
	if (required != 2 || buffer[0] != 'x' || buffer[1] != 'y')
		return 4;

	fixed char[1] shortBuffer = default;
	char[] shortSpan = shortBuffer;
	required = "xy".escapedLength(shortSpan);
	if (required != 2 || shortBuffer[0] != 'x')
		return 5;

	char[] chainedReceiver = middle(" hello ").toString();
	if (chainedReceiver.compareTo("hel") != 0)
		return 6;

	auto writerBuffer = new List<char>() finally delete;
	writeSeparator(writerBuffer.CharWriter, false);
	char[] separator = writerBuffer.copyArray() finally delete;
	if (separator.compareTo(": ") != 0)
		return 7;

	return 0;
}
