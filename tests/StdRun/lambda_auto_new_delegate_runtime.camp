using Std;

class Arena
{
	escaped void* alloc(nuint size) => default;
	void free(escaped void* ptr) {}
}

int runOnce(once int() callback) => callback();
int runScoped(scoped delegate int() callback) => callback();

escaped delegate int() makeWithDefault(Arena* arena)
{
	within (arena)
	{
		return within (default) new delegate () =>
		{
			delete delegate;
			return 9;
		};
	}
}

export int main()
{
	int local = 4;
	auto captured = new delegate (int x, int y) => x + y + local;
	int capturedValue = captured(1, 2);
	delete captured.context;

	auto plain = new delegate (int x, int y) =>
	{
		delete delegate;
		return x * y;
	};
	int plainValue = plain(3, 5);

	auto arena = new Arena();
	auto masked = makeWithDefault(arena);
	int maskedValue = masked();
	int onceValue = runOnce(within (default) () => 11);
	delete arena;

	auto existing = new delegate () => 13;
	int scopedExistingValue = runScoped(existing);
	int onceExistingValue = runOnce(existing);
	delete existing.context;

	Console.writeLine(capturedValue);
	Console.writeLine(plainValue);
	Console.writeLine(maskedValue);
	Console.writeLine(onceValue);
	Console.writeLine(scopedExistingValue);
	Console.writeLine(onceExistingValue);
	return capturedValue == 7
		&& plainValue == 15
		&& maskedValue == 9
		&& onceValue == 11
		&& scopedExistingValue == 13
		&& onceExistingValue == 13
		? 0 : 1;
}
