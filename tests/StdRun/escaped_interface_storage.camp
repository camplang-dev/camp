escaped interface StorageSink
{
	int read();
}

struct Counter: StorageSink
{
	int value;
	int read(): StorageSink { return this.value; }
}

Counter first;
Counter second;
StorageSink* kept;

class ExplicitCounter: StorageSink
{
	int value;
	int read(escaped this): StorageSink { return this.value; }
}
escaped class DefaultCounter: StorageSink
{
	int read(): StorageSink { return 53; }
}
interface StorageMixed { int keep(escaped this); int plain(); }
class StorageMixedCounter: StorageMixed
{
	int keep(escaped this): StorageMixed { return 67; }
	int plain(): StorageMixed { return 71; }
}
int scopedPlain(StorageMixedCounter* value) { StorageMixed* view = value; return view.plain(); }

StorageSink* viewFirst() { return first; }
StorageSink* viewSecond() { return second; }
StorageSink* viewHeap(escaped Counter* counter) { return counter; }

export int main()
{
	first.value = 17;
	second.value = 29;
	StorageSink* a = viewFirst();
	StorageSink* b = viewSecond();
	Counter* heap = new Counter();
	heap.value = 41;
	kept = viewHeap(heap);
	if (a.read() != 17 || b.read() != 29 || kept.read() != 41)
		return 1;
	// Repeated conversions must preserve both existing views and object identity.
	StorageSink* again = viewFirst();
	if (again.read() != 17 || a.read() != 17 || b.read() != 29)
		return 2;
	delete heap;
	ExplicitCounter* explicitCounter = new ExplicitCounter();
	explicitCounter.value = 47;
	StorageSink* explicitView = explicitCounter;
	DefaultCounter* defaultCounter = new DefaultCounter();
	StorageSink* defaultView = defaultCounter;
	StorageMixedCounter* mixed = new StorageMixedCounter();
	StorageMixed* mixedView = mixed;
	if (explicitCounter.read() != 47 || explicitView.read() != 47 || defaultView.read() != 53
		|| mixed.keep() != 67 || mixedView.keep() != 67 || mixedView.plain() != 71)
		return 3;
	StorageMixedCounter local = StorageMixedCounter();
	if (scopedPlain(&local) != 71) return 4;
	delete mixed;
	delete defaultCounter;
	delete explicitCounter;
	return 0;
}
