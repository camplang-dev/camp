using Std;

struct LocalAssertion
{
	escaped string message;
	escaped string sourcefile;
	uint sourceline;
}

// Regression coverage for BUG-160: `check`'s success path falls off the end
// of its body without an explicit `return`, so it must still clear its
// `thrown` slot on that implicit path. Poisoning the stack before entering
// the try/catch below makes a missing clear deterministic instead of
// depending on whatever the stack already held.
void poisonStack()
{
	int a = -1;
	int b = -1;
	int c = -1;
}

export int main()
{
	poisonStack();
	try
	{
		check(1 == 1);
	}
	catch (LocalAssertion* successPathFailure)
	{
		Console.writeLine("unexpected failure on success path");
		return 2;
	}

	try
	{
		check(1 == 2);
	}
	catch (LocalAssertion* assertion)
	{
		Console.writeLine(assertion.message);
		Console.writeLine(assertion.sourceline);
		within(default) delete assertion;
		return 0;
	}
	return 1;
}

void check(bool condition, escaped string message = sourceof(condition), escaped string sourcefile = caller(sourcefile), uint sourceline = caller(sourceline), thrown LocalAssertion*)
{
	if (!condition)
	{
		throw within(default) new LocalAssertion() { .message = message, .sourcefile = sourcefile, .sourceline = sourceline };
	}
}
