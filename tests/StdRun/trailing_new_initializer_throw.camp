using Std;

struct LocalAssertion
{
	escaped string message;
	escaped string sourcefile;
	uint sourceline;
}

export int main()
{
	try
	{
		check(1 == 2);
	}
	catch (LocalAssertion* assertion)
	{
		Console.writeLine(assertion.message);
		Console.writeLine(assertion.sourceline);
		within(default) delete assertion;
		return 0;
	}
	return 1;
}

void check(bool condition, escaped string message = sourceof(condition), escaped string sourcefile = caller(sourcefile), uint sourceline = caller(sourceline), thrown LocalAssertion*)
{
	if (!condition)
	{
		throw within(default) new LocalAssertion() { .message = message, .sourcefile = sourcefile, .sourceline = sourceline };
	}
}
