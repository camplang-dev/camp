int readConstPointer(int* const* value) => **value;
int readConstToConst(const int* const* value) => **value;
int readVolatilePointer(int* volatile* value) => **value;
int readDeepPointer(int* const* const* value) => ***value;
int readInPointer(in int* const* value) => **value;

struct Item
{
	int value;
}

int readItem(Item* const* value)
{
	return (*value).value;
}

int readConstItem(Item* const value) => value.value;
int readVolatileItem(Item* volatile value) => value.value;
int readQualifiedItem(const Item* const volatile value) => value.value;

export int main()
{
	int number = 6;
	int* pointer = &number;
	if (readConstPointer(&pointer) + readConstToConst(&pointer) != 12)
		return 1;
	int* const* view = &pointer;
	const int* const* constView = &pointer;
	if (**view != 6 || **constView != 6)
		return 2;
	if (readVolatilePointer(&pointer) != 6 || readDeepPointer(&view) != 6)
		return 3;
	if (readInPointer(view) != 6)
		return 4;
	auto inferredView = view;
	if (**inferredView != 6)
		return 5;
	Item item = { .value = 7 };
	Item* itemPointer = &item;
	if (readItem(&itemPointer) != 7)
		return 6;
	if (readConstItem(itemPointer) != 7 || readVolatileItem(itemPointer) != 7
		|| readQualifiedItem(itemPointer) != 7)
		return 7;
	Item* const local = itemPointer;
	local.value = 9;
	if (local.value != 9 || item.value != 9)
		return 8;
	return 0;
}
