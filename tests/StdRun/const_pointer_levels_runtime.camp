int readConstPointer(int* const* value) => **value;
int readConstToConst(const int* const* value) => **value;
int readVolatilePointer(int* volatile* value) => **value;
int readDeepPointer(int* const* const* value) => ***value;
int readInPointer(in int* const* value) => **value;

struct Item
{
	int value;
	int getValue() => this.value;
	void setValue(int value) { this.value = value; }
}

int readItem(Item* const* value)
{
	return (*value).value;
}

int readConstItem(Item* const value) => value.value;
int readVolatileItem(Item* volatile value) => value.value;
int readQualifiedItem(const Item* const volatile value) => value.value;

int callConstItem(Item* const value) => value.getValue();
int callQualifiedItem(const Item* const value) => value.getValue();
int callIndirectItem(Item* const* value) => (*value).getValue();
int callValueItem(Item value) => value.getValue();

class Counter
{
	int n;
	Counter(int n) { this.n = n; }
	int getN() => this.n;
}

export int main()
{
	int number = 6;
	int* pointer = &number;
	if (readConstPointer(&pointer) + readConstToConst(&pointer) != 12)
		return 1;
	int* const* view = &pointer;
	const int* const* constView = &pointer;
	if (**view != 6 || **constView != 6)
		return 2;
	if (readVolatilePointer(&pointer) != 6 || readDeepPointer(&view) != 6)
		return 3;
	if (readInPointer(view) != 6)
		return 4;
	auto inferredView = view;
	if (**inferredView != 6)
		return 5;
	Item item = { .value = 7 };
	Item* itemPointer = &item;
	if (readItem(&itemPointer) != 7)
		return 6;
	if (readConstItem(itemPointer) != 7 || readVolatileItem(itemPointer) != 7
		|| readQualifiedItem(itemPointer) != 7)
		return 7;
	Item* const local = itemPointer;
	local.value = 9;
	if (local.value != 9 || item.value != 9)
		return 8;
	if (callConstItem(itemPointer) != 9
		|| callQualifiedItem(itemPointer) != 9 || callIndirectItem(&itemPointer) != 9
		|| callValueItem(item) != 9 || local.getValue() != 9)
		return 9;
	local.setValue(11);
	if (item.value != 11)
		return 10;
	auto counter = stackalloc Counter(13);
	Counter* const constCounter = counter;
	Counter* const* counterView = &counter;
	if (constCounter.getN() != 13 || (*counterView).getN() != 13)
		return 11;
	return 0;
}
