using Std;

export int main()
{
	string text = "  Hello, hello!  ";
	const char[] span = text[..];

	if (text.indexOf("Hello") != 2)
		return 1;
	const char[] helloLower = "hello";
	if (text.indexOf(helloLower, true) != 2)
		return 2;
	if (span.lastIndexOf("lo") != 12)
		return 3;
	if (span.indexOf((uchar)'H') != 2)
		return 4;
	if (text.indexOf((uchar)'e') != 3)
		return 25;
	if (text[..].indexOf((uchar)'l') != 4)
		return 26;
	if (span.lastIndexOf((uchar)'o') != 13)
		return 5;

	uchar[] any = [(uchar)'x', (uchar)'H'];
	if (span.indexOfAny(any) != 2)
		return 6;
	uchar[] anyLast = [(uchar)'!', (uchar)'x'];
	if (span.lastIndexOfAny(anyLast) != 14)
		return 7;

	if (!text.startsWith("  He"))
		return 8;
	if (!span.startsWith((uchar)' '))
		return 9;
	if (!span.endsWith("!  "))
		return 10;
	if (!span.endsWith((uchar)' '))
		return 11;
	if (text.compareTo("  Hello, hello!  ") != 0)
		return 12;

	string accent = "caf\xC3\xA9";
	if (accent[..].countUChars() != 4)
		return 13;
	if (accent[..].getUChar(3) != (uchar)233)
		return 14;
	if (accent[..].getUCharUnits(3) != 2)
		return 15;

	if (span.trim().length != 13)
		return 16;
	if (span.trimStart().length != 15)
		return 17;
	if (span.trimEnd().length != 15)
		return 18;

	string upper = span.toUppercase();
	string lower = span.toLowercase();
	string joined = null;
	string concatenated = null;
	string[] words = ["one", "two", "three"];
	concatenated = words.join();
	joined = words.join(",");

	fixed char[17] explicitUpper = default;
	if (span.toUppercase(buffer: explicitUpper) != 17)
		return 27;
	if (explicitUpper[..].compareTo("  HELLO, HELLO!  ") != 0)
		return 28;

	if (upper[..].compareTo("  HELLO, HELLO!  ") != 0)
		return 19;
	if (lower[..].compareTo("  hello, hello!  ") != 0)
		return 20;
	if (concatenated[..].compareTo("onetwothree") != 0)
		return 21;
	if (joined[..].compareTo("one,two,three") != 0)
		return 22;

	const char[] embeddedNull = ['a', 'b', '\0', 'x', 'y'];
	if (embeddedNull.compareTo("ab") != 0)
		return 23;
	if (embeddedNull.countUChars() != 2)
		return 24;

	return 0;
}
