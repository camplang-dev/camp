// @emit-metadata export
extern void* malloc(nuint size);
extern void free(void* pointer);

export interface IVisible
{
	int getValue();
}

export class DirectWidget: IVisible
{
	public int getValue(): IVisible => 7;
}

export int readVisible<T: implements IVisible>(T* value, vtableof(T: IVisible))
{
	return value.getValue();
}
