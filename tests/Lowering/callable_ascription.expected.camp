newtype fn bool ParseInt(const char[] text, out int value);

newtype delegate int DateFormatter(int adjust = 4);
int plusOne(DateFormatter this, void* this_context)
{
	return this(this_context, 4) + 1;
}
bool tryParseInt(const char* text, nuint text_length, out int value) : ParseInt
{
	value = (int)text_length;
	return true;
}

struct Date
{
	int year;

	int format(int adjust) : DateFormatter
	{
		return this.year + adjust;
	}
}

class Point
{
	nuint format(char* buffer, nuint buffer_length) : TextFormatter
	{
		return buffer_length;
	}
}

newtype delegate nuint TextFormatter(char[] buffer = default);
void main(Date date)
{
	auto parser = tryParseInt;
	fn int(void*, int) bound = Date_format;
	void* bound_context = (void*)&date;
	fn int(void*, int) unbound;
	void* unbound_context;
	auto value = DateFormatter_plusOne(bound, bound_context);
	Point* point = null;
	fn nuint(void*, char*, nuint) formatter = Point_formatCharArray;
	void* formatter_context = (void*)point;
}
