singleValueIter singleValue(int value)
{
	return {.__state = 0, .value = value};
}
void main()
{
	singleValueIter seq = singleValue(7);
	int current = 0;
	bool __discard1;
	__discard1 = singleValueIter_next(&seq, &current);
}

fixed struct singleValueIter
{
	int __state;
	int value;

	bool next(int* current)
	{
		if (this.__state == -1)
			return false;
		if (this.__state == 1)
			goto __iter_resume1;
		*current = this.value;
		this.__state = 1;
		return true;
		__iter_resume1:
		;
		this.__state = -1;
		return false;
	}

	void destroy()
	{
		if (this.__state != -1)
		{
			this.__state = -1;
		}
	}

	static bool op_iter(void* ctx, int* current)
	{
		singleValueIter* state = (singleValueIter*)ctx;
		if (current == null)
		{
			singleValueIter_destroy(state);
			return false;
		}
		return singleValueIter_next(state, current);
	}
}
