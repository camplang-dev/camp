newtype delegate nuint CharFormatter(const this, char[] buffer);

newtype delegate void EscapedCallback(escaped this);

newtype delegate void Callback();

newtype delegate void NormalCallback();

class Date
{
	int year;

	nuint format(char* buffer, nuint buffer_length) : CharFormatter
	{
		int y = this.year;
		return 0;
	}

	nuint formatExplicit(const this, char* buffer, nuint buffer_length) : CharFormatter
	{
		return 0;
	}
}

escaped class Service
{
	void run() : EscapedCallback
	{
	}

	void runExplicit(escaped this) : Callback
	{
	}

	void normal() : NormalCallback
	{
	}
}
void main()
{
	const Date d;
	fn nuint(const void*, char*, nuint) f = Date_format;
	const void* f_context = (void*)&d;
}
