newtype delegate nuint StringFormatter(const this, char[] buffer);
newtype delegate void EscapedCallback(escaped this);
newtype delegate void Callback();
newtype delegate void NormalCallback();

class Date
{
	int year;

	nuint format(char[] buffer) : StringFormatter
	{
		int y = this.year;
		return 0;
	}

	nuint formatExplicit(const this, char[] buffer) : StringFormatter
	{
		return 0;
	}
}

escaped class Service
{
	void run() : EscapedCallback
	{
	}

	void runExplicit(escaped this) : Callback
	{
	}

	void normal() : NormalCallback
	{
	}
}

void main()
{
	const Date d = init Date();
	StringFormatter f = d.format;
}
