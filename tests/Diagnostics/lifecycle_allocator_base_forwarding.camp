extern void* malloc(nuint size);
extern void free(void* ptr);

class Allocator
{
	void* alloc(nuint size)
	{
		return malloc(size);
	}

	void free(void* ptr)
	{
		free(ptr);
	}
}

class BaseWithin
{
	BaseWithin(within allocator)
	{
	}
}

class DerivedWrongForwarding : BaseWithin
{
	DerivedWrongForwarding(within allocator, Allocator* other)
	{
		within (other) base();
	}
}

class RequiredBase { RequiredBase(int value) { } }
class MissingBaseWithStatement: RequiredBase
{
	MissingBaseWithStatement() { touch(); }
}
class MissingBaseWithDeclaration: RequiredBase
{
	MissingBaseWithDeclaration() { int value = 1; }
}
class MissingBaseWithReturn: RequiredBase
{
	MissingBaseWithReturn() { return; }
}
void touch() { }

class MissingBaseWithEmptyBody: RequiredBase { MissingBaseWithEmptyBody() { } }
class MissingBaseWithImplicitConstructor: RequiredBase { }
public class PublicMissingBaseWithImplicitConstructor: RequiredBase { }
class BaseCallTooFew: RequiredBase { BaseCallTooFew() { base(); } }
class BaseCallTooMany: RequiredBase { BaseCallTooMany() { base(1, 2); } }
