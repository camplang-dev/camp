#within explicit

struct Allocator
{
}

void needs(within allocator) {}
void typed(within Allocator* allocator = null) {}
void ordinary(Allocator* allocator = null) {}

export void main()
{
	needs();
	within(default) needs();
	ordinary();
}

void untypedDefault(within allocator = default) { }
void scopedDefault(within scoped allocator = default) { }
void anchoredDefault(int* owner, within unscoped(owner) allocator = default) { }

class DefaultAllocatorConstructor
{
	DefaultAllocatorConstructor(within allocator = default) { }
}
