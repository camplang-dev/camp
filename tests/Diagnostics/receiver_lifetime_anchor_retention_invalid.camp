struct NameView
{
	const char[] name;
	bool enabled;
}

struct NameEntry
{
	fixed char[16] characters;
	uint length;
	bool enabled;

	scoped(this) const char[] name() => this.characters[..this.length];
}

struct Settings
{
	fixed NameEntry[8] entries;
	uint count;

	uint copyViews(unscoped(destination) this, NameView[] destination)
	{
		for (uint i = 0; i < this.count; i++)
			destination[i] = { this.entries[i].name(), this.entries[i].enabled };
		return this.count;
	}
}

Settings global;

void fromGlobal()
{
	fixed NameView[8] views;
	Settings* settings = &global;
	settings.copyViews(views[..]);
}

uint fromLocal(NameView[] longLived)
{
	Settings local = default;
	return local.copyViews(longLived);
}

uint innerReceiver()
{
	fixed NameView[8] views;
	Settings* escapedSettings = &global;
	{
		Settings local = default;
		local.copyViews(views[..]);
	}
	return escapedSettings.copyViews(views[..]);
}

uint outerReceiver()
{
	Settings local = default;
	fixed NameView[8] views;
	return local.copyViews(views[..]);
}

export int main() { return 0; }

struct ViewOptions { NameView[] entries; }

bool collectViews(unscoped(destination) NameView[] source, NameView[] destination)
{
	destination[0] = source[0];
	return true;
}

void fromSliceParameter(NameView[] input)
{
	fixed NameView[4] views = default;
	collectViews(input, views[..]);
}

void fromValueParameter(ViewOptions options)
{
	fixed NameView[4] views = default;
	collectViews(options.entries, views[..]);
}

void fromPointerParameter(ViewOptions* options)
{
	fixed NameView[4] views = default;
	collectViews(options.entries, views[..]);
}

void fromCopiedParameter(ViewOptions options)
{
	fixed NameView[4] views = default;
	auto input = options.entries;
	collectViews(input, views[..]);
}

void fromLocalSource()
{
	fixed NameView[4] source = default;
	fixed NameView[4] views = default;
	collectViews(source[..], views[..]);
}

void fromRelatedParameters(unscoped(output) NameView[] input, NameView[] output)
{
	collectViews(input, output);
}

void fromUnrelatedParameters(NameView[] input, NameView[] output)
{
	collectViews(input, output);
}

void fromInnerSource()
{
	fixed NameView[4] views = default;
	{
		fixed NameView[4] source = default;
		collectViews(source[..], views[..]);
	}
}
