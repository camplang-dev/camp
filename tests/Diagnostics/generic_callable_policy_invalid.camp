struct DelegatePolicy<K>
{
	delegate nuint(in K key, sizeof(K)) hash;
	delegate bool(in K left, in K right, sizeof(K)) equals;
}

nuint hashInt(in int key, sizeof(int))
{
	return (nuint)key;
}

bool equalsInt(in int left, in int right, sizeof(int))
{
	return left == right;
}

export int main()
{
	DelegatePolicy<int> policy = { .hash = hashInt, .equals = equalsInt };
	return 0;
}
