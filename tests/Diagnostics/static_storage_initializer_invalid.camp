public interface Service
{
	void run();
}

void serviceRun(Service* service)
{
}

Service ServiceStorage =
{
	.run = serviceRun
};

public Service* const DefaultService = &ServiceStorage;
public Service* ActiveService = DefaultService;

const long SECOND = 1000;
const long MINUTE = 60 * SECOND;

static class Services
{
	static Service* const Default = &ServiceStorage;
	static Service* Active = Services.Default;
}
