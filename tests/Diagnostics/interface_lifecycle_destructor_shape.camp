class Allocator
{
}

interface IPlainDestroy
{
	~IPlainDestroy();
}

interface IAllocatorDestroy
{
	~IAllocatorDestroy(within allocator);
}

class PlainNeedsNoWithin : IPlainDestroy
{
	~PlainNeedsNoWithin(within allocator)
	{
	}
}

class AllocatorNeedsWithin : IAllocatorDestroy
{
	~AllocatorNeedsWithin()
	{
	}
}
