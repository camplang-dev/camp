class Allocator
{
}

class ConstructorWithinDestructorWithout
{
	ConstructorWithinDestructorWithout(within allocator)
	{
	}

	~ConstructorWithinDestructorWithout()
	{
	}
}

class DestructorWithinConstructorWithout
{
	DestructorWithinConstructorWithout()
	{
	}

	~DestructorWithinConstructorWithout(within allocator)
	{
	}
}

class BaseWithin
{
	BaseWithin(within allocator)
	{
	}
}

class DerivedMissingWithin : BaseWithin
{
	DerivedMissingWithin()
	{
	}
}

virtual class RetainedDestructorRoot
{
	RetainedDestructorRoot(within this.allocator) { }
	virtual ~RetainedDestructorRoot() { }
}
sealed class RetainedDestructorValid: RetainedDestructorRoot
{
	RetainedDestructorValid(within allocator) { }
	override ~RetainedDestructorValid() { }
}
sealed class RetainedDestructorWrong: RetainedDestructorRoot
{
	RetainedDestructorWrong(within allocator) { }
	override ~RetainedDestructorWrong(within allocator) { }
}
