struct SectionView
{
	const byte[] image;
	nuint offset;
	nuint size;

	const byte[] content() => this.image;
	scoped(this) const byte[] payload() => this.image[this.offset..this.offset + this.size];
}

struct Result
{
	const byte[] data;
	int code;
}

const byte[] fromField(const byte[] image)
{
	SectionView section = { image, 4, 8 };
	return section.image;
}

const byte[] fromMethod(const byte[] image)
{
	SectionView section = { image, 4, 8 };
	return section.content();
}

Result fromInitializer(const byte[] image)
{
	SectionView section = { image, 4, 8 };
	return { section.content(), 0 };
}

const byte[] fromScopedMethod(const byte[] image)
{
	SectionView section = { image, 4, 8 };
	return section.payload();
}

Result fromScopedInitializer(const byte[] image)
{
	SectionView section = { image, 4, 8 };
	return { section.payload(), 0 };
}

const byte[] fromLocalBuffer()
{
	fixed byte[16] buffer;
	SectionView section = { buffer[..], 4, 8 };
	return section.content();
}

export int main() { return 0; }

struct OutView
{
	const byte[] bytes;
	bool find(out Result part) { part = { this.bytes, 1 }; return true; }
	bool annotated(out unscoped(this) Result part) { part = { this.bytes, 2 }; return true; }
	bool own(out scoped(this) Result part) { part = { this.bytes, 3 }; return true; }
}
struct NestedOutView { OutView view; }

Result viaOut(const byte[] image)
{
	OutView view = { image };
	Result part = default;
	view.find(out part);
	return part;
}

Result viaNestedOut(const byte[] image)
{
	NestedOutView wrapper = { { image } };
	Result part = default;
	wrapper.view.find(out part);
	return part;
}

Result viaAnnotatedOut(const byte[] image)
{
	OutView view = { image };
	Result part = default;
	view.annotated(out part);
	return part;
}

Result badOwnOut(const byte[] image)
{
	OutView view = { image };
	Result part = default;
	view.own(out part);
	return part;
}

Result badLocalOut()
{
	fixed byte[8] buffer;
	OutView view = { buffer[..] };
	Result part = default;
	view.find(out part);
	return part;
}

struct PointerInput { const byte[] data; int flags; }
Result emitPointer(PointerInput* input) => { input.data, 0 };
Result emitPointerValue(PointerInput input) => { input.data, 0 };
unscoped(input) Result emitPointerAnnotated(PointerInput* input) => { input.data, 0 };
scoped(input) int* pointerField(PointerInput* input) => &input.flags;
int* missingPointerRelation(PointerInput* input) => &input.flags;

Result viaPointer(const byte[] image)
{
	PointerInput input = { image, 0 };
	return emitPointer(&input);
}

Result viaPointerAlias(const byte[] image)
{
	PointerInput input = { image, 0 };
	PointerInput* pointer = &input;
	return emitPointerAnnotated(pointer);
}

Result viaPointerValue(const byte[] image)
{
	PointerInput input = { image, 0 };
	return emitPointerValue(input);
}

Result badPointerContent()
{
	fixed byte[8] buffer = default;
	PointerInput input = { buffer[..], 0 };
	return emitPointer(&input);
}

int* badPointerAddress(const byte[] image)
{
	PointerInput input = { image, 0 };
	return pointerField(&input);
}

struct FieldReader
{
	const byte[] bytes;
	fixed byte[8] scratch;
	bool read(out const byte[] result) { result = this.bytes; return true; }
	bool whole(out Result dependency) { dependency = { this.bytes, 0 }; return true; }
	bool fromField(out Result dependency) { dependency = default; dependency.data = this.bytes; return true; }
	bool viaOut(out Result dependency)
	{
		dependency = default;
		const byte[] identity;
		if (!this.read(out identity)) return false;
		dependency.data = identity;
		return true;
	}
	bool viaCast(out Result dependency)
	{
		dependency = default;
		const byte[] identity;
		if (!this.read(out identity)) return false;
		dependency.data = (unscoped(this))identity;
		return true;
	}
	bool related(const byte[] source, out unscoped(source) Result dependency)
	{
		dependency = default;
		dependency.data = source;
		return true;
	}
	bool unrelated(const byte[] source, out Result dependency)
	{
		dependency = default;
		dependency.data = source;
		return true;
	}
	bool own(out scoped(this) Result dependency)
	{
		dependency = default;
		dependency.data = this.scratch[..];
		return true;
	}
	bool badOwn(out Result dependency)
	{
		dependency = default;
		dependency.data = this.scratch[..];
		return true;
	}
}

Result returnFields(const byte[] image)
{
	FieldReader reader = { image, default };
	Result dependency = default;
	reader.fromField(out dependency);
	return dependency;
}

struct AliasOutputReader
{
	fixed byte[8] scratch;
	bool own(out scoped(this) Result part) { part = { this.scratch[..], 0 }; return true; }
	bool badAlias(out Result dependency)
	{
		Result part = default;
		this.own(out part);
		dependency = default;
		dependency.data = part.data;
		return true;
	}
}

PointerInput* missingIdentityRelation(PointerInput* input) => input;
PointerInput* missingAliasRelation(PointerInput* input) { auto borrowed = input; return borrowed; }
int* missingCallRelation(PointerInput* input) => pointerField(input);
scoped(input) PointerInput* scopedIdentity(PointerInput* input) => input;
