using Std;

struct iter T duplicateForeach<T>(T[] values, sizeof(T))
{
	foreach (stackalloc T item in values)
	{
		yield item;
		yield item;
	}
}

struct iter T duplicateLocal<T>(T[] values, sizeof(T))
{
	stackalloc T current = values[0];
	yield current;
	yield current;
}

struct iter T assignBeforeReuse<T>(T[] values, sizeof(T))
{
	stackalloc T current = values[0];
	yield current;
	current = values[1];
	yield current;
}

struct iter int duplicateErased()
{
	stackalloc void<int?> current = (void<int?>)1;
	yield (int)current;
	int? again = current;
	yield 2;
}

struct iter int reassignErased()
{
	stackalloc void<int?> current = (void<int?>)1;
	yield 1;
	current = (void<int?>)2;
	int? again = current;
	yield 2;
}
