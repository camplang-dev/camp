class GoodHookBase
{
	@getshadow
	extern escaped void* getShadow();

	@setshadow
	extern void setShadow(escaped void* value);
}

class BadGetReturnBase
{
	@getshadow
	extern void* getShadow();

	@setshadow
	extern void setShadow(escaped void* value);
}

shadow class BadGetReturn: BadGetReturnBase
{
}

class BadGetParameterBase
{
	@getshadow
	extern escaped void* getShadow(int extra);

	@setshadow
	extern void setShadow(escaped void* value);
}

shadow class BadGetParameter: BadGetParameterBase
{
}

class BadSetConstBase
{
	@getshadow
	extern escaped void* getShadow();

	@setshadow
	extern void setShadow(const this, escaped void* value);
}

shadow class BadSetConst: BadSetConstBase
{
}

class BadSetParameterBase
{
	@getshadow
	extern escaped void* getShadow();

	@setshadow
	extern void setShadow(void* value);
}

shadow class BadSetParameter: BadSetParameterBase
{
}

virtual class VirtualBase
{
	@getshadow
	extern escaped void* getShadow();

	@setshadow
	extern void setShadow(escaped void* value);
}

shadow class BadVirtualBase: VirtualBase
{
}

extern class NativeBase
{
	extern NativeBase();
	extern void ping();
}

class NonEscapedNativeView: NativeBase
{
}

escaped abstract class AbstractNativeView: NativeBase
{
}

escaped class FieldNativeView: NativeBase
{
	int value;
}

interface INativeView
{
	void show();
}

escaped class InterfaceNativeView: NativeBase, INativeView
{
	void show(): INativeView
	{
	}
}

escaped class VirtualMethodNativeView: NativeBase
{
	virtual void show()
	{
	}
}

escaped class DestructorNativeView: NativeBase
{
	~DestructorNativeView()
	{
	}
}

virtual shadow class VirtualShadow: GoodHookBase
{
	virtual int read() => 1;
	void cleanup() { delete shadow; }
}

shadow class OrdinaryVirtualChild: VirtualShadow
{
	void cleanupChild() { delete shadow; }
}

shadow class OrdinaryOverrideChild: VirtualShadow
{
	override int read() => 2;
	void cleanupChild() { delete shadow; }
}

abstract shadow class AbstractShadow: GoodHookBase
{
	abstract int read();
	void cleanup() { delete shadow; }
}

shadow class OrdinaryAbstractChild: AbstractShadow
{
	override int read() => 3;
	void cleanupChild() { delete shadow; }
}
