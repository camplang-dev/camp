extern void* malloc(nuint size);

class RefType
{
}

fixed struct FixedValue
{
	int value;
}

struct InlineBuffer
{
	fixed byte[4] bytes;
}

class Holder<T>
{
	Holder(sizeof(T)) { }
}

Holder<int>* okPrimitive;
Holder<byte[4]*>* okPointerToFixedArray;
Holder<InlineBuffer>* okStructWithCopyableFixedArray;

void rejectNoncopyableArguments()
{
	auto badFixedArray = new Holder<byte[4]>();
	auto badClass = new Holder<RefType>();
	auto badFixedStruct = new Holder<FixedValue>();
}
