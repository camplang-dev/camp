class Plain
{
	void release()
	{
		delete this;
	}
}

class ExplicitPlain
{
	void release(this)
	{
		delete this;
	}
}

class ExplicitEscaped
{
	void release(escaped this)
	{
		delete this;
	}
}

escaped class EscapedOwner
{
	void release()
	{
		delete this;
	}
}

export int main()
{
	return 0;
}

virtual class ManualDeleteRoot { virtual ~ManualDeleteRoot() { } }
sealed class ManualDeleteLeaf: ManualDeleteRoot
{
	override ~ManualDeleteLeaf()
	{
		delete base;
		delete (base);
		within (default) delete base;
	}
}

extern void free(void* ptr);
