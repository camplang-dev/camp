// Expansion-time rules: a generator local is lifted into its state, so unknown-size storage is stackalloc only.
struct iter T autoLocal<T>(const T[] values, sizeof(T))
{
	auto value = values[0];
	yield value;
}

struct iter T plainLocal<T>(const T[] values, sizeof(T))
{
	T value = values[0];
	yield value;
}

struct iter T defaultLocal<T>(const T[] values, sizeof(T))
{
	T value = default;
	yield value;
}

struct iter T nestedPlainLocal<T>(const T[] values, sizeof(T))
{
	for (nuint i = 0; i < values.length; i++)
	{
		T value;
		value = values[i];
		yield value;
	}
}

struct iter T readAfterYield<T>(const T[] values, sizeof(T))
{
	stackalloc T value = values[0];
	yield value;
	yield value;
}

struct iter T copyAfterYield<T>(const T[] values, sizeof(T))
{
	foreach (stackalloc T item in values)
	{
		yield item;
		stackalloc T copy = item;
	}
}

struct iter T assignedAgain<T>(const T[] values, sizeof(T))
{
	stackalloc T value = values[0];
	yield value;
	value = values[1];
	yield value;
}

struct iter T fixedRepresentation<T: int>(T first)
{
	T value = first;
	yield value;
	yield value;
}

// Stackalloc storage lives only in one activation, so its address cannot leave the generator.
struct iter T* yieldAddress<T>(const T[] values, sizeof(T))
{
	stackalloc T local = values[0];
	yield &local;
}

struct iter T* yieldAlias<T>(const T[] values, sizeof(T))
{
	stackalloc T local = values[0];
	T* alias = &local;
	yield alias;
}

struct iter void<int?>* yieldErasedAddress()
{
	stackalloc void<int?> local = 3;
	yield &local;
}

struct iter void<int?>* yieldErasedAlias()
{
	stackalloc void<int?> local = 3;
	void<int?>* alias = &local;
	yield alias;
}

// Legal: a value copy, and a pointer to storage the caller keeps alive.
struct iter T copiedValue<T>(const T[] values, sizeof(T))
{
	stackalloc T local = values[0];
	yield local;
}

struct iter T* longLived<T>(escaped T* item, sizeof(T))
{
	yield item;
}

export int main() { return 0; }
