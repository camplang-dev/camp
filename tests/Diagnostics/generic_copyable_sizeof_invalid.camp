T copyReturn<T>(T* value)
{
	return *value;
}

void copyLocal<T>(T* value)
{
	T copy = *value;
}

void copyAssign<T>(T* target, T* value)
{
	*target = *value;
}

void defaultFill<T>(T* target)
{
	*target = default;
}

void okWithSize<T>(T* target, in T value, sizeof(T))
{
	stackalloc T copy = value;
	*target = copy;
	*target = default;
}
