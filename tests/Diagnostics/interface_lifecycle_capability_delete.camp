extern void free(void* ptr);

class Allocator
{
}

interface IPlainDestroy
{
	~IPlainDestroy();
}

sealed class Plain : IPlainDestroy
{
	~Plain()
	{
	}
}

void deleteInterfacePointer(IPlainDestroy* view)
{
	within (default) delete view;
}

void deleteUnprovenGeneric<T: implements IPlainDestroy>(T* value, vtableof(T: IPlainDestroy))
{
	within (default) delete value;
}

void deleteEscapedGeneric<T: implements IPlainDestroy>(escaped T* value, vtableof(T: IPlainDestroy))
{
	within (default) delete value;
}
