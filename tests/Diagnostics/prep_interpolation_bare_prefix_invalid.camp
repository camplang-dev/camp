struct Value
{
}

struct Ordinary
{
}

nuint format(in Value this, prep char[] buffer = default)
{
	return 0;
}

string toString(in Ordinary this) => "ordinary";

void main()
{
	Value value = default;
	_ = $"{value}";
	Ordinary ordinary = default;
	_ = $"{ordinary.toString()}";
	_ = $"{ordinary}";
}
