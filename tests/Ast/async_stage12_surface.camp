class Resumer
{
	void resumeAsync(escaped once void() continuation)
	{
	}
}

newtype async int Loader(const char[] path, thrown int error);

extern async int loadAsync(const char[] path, thrown int error);

async int exampleAsync(Loader loader, @awaitwith Resumer* resumer, thrown int error)
{
	return await loader("test", catch _);
}

void later()
{
	auto work = postpone loadAsync("test");
}
