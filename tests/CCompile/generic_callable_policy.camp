extern escaped void* malloc(nuint size);
extern void free(void* ptr);

newtype fn nuint HashCode<K>(in K key, sizeof(K));

struct HashPolicy<K>
{
	fn nuint(in K key, sizeof(K)) hash;
	fn bool(in K left, in K right, sizeof(K)) equals;
}

struct DelegatePolicy<K>
{
	delegate nuint(in K key, sizeof(K)) hash;
	delegate bool(in K left, in K right, sizeof(K)) equals;
}

class HashSet<K>
{
	HashPolicy<K> policy;

	HashSet(HashPolicy<K> policy, sizeof(K))
	{
		this.policy = policy;
	}
}

nuint hashInt(in int key, sizeof(int))
{
	return (nuint)key;
}

bool equalsInt(in int left, in int right, sizeof(int))
{
	return left == right;
}

nuint hashIntWithContext(void* context, in int key, sizeof(int))
{
	return (nuint)key;
}

bool equalsIntWithContext(void* context, in int left, in int right, sizeof(int))
{
	return left == right;
}

export int main()
{
	HashCode<int> hashCode = hashInt;
	if (hashCode(42) != 42)
		return 1;

	HashPolicy<int> policy = { .hash = hashInt, .equals = equalsInt };
	if (!policy.equals(5, 5) || policy.hash(42) != 42)
		return 2;

	delegate nuint(in int, sizeof(int)) hash = { hashIntWithContext, null };
	delegate bool(in int, in int, sizeof(int)) equals = { equalsIntWithContext, null };
	DelegatePolicy<int> delegatePolicy = { .hash = hash, .equals = equals };
	if (!delegatePolicy.equals(6, 6) || delegatePolicy.hash(43) != 43)
		return 3;

	auto set = new HashSet<int>(policy);
	if (!set.policy.equals(7, 7) || set.policy.hash(44) != 44)
		return 4;
	delete set;

	return 0;
}
