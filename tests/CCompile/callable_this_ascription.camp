newtype delegate nuint TextFormatter(const this, char[] buffer);
newtype delegate void EscapedDelegate(escaped this);
newtype delegate void NormalDelegate();
newtype delegate int CounterReader();

extern escaped void* malloc(nuint size);

escaped interface Task { void run(); }
interface Mixed { void keep(escaped this); void plain(); }
class ExplicitTask: Task { void run(escaped this): Task { } }
escaped class DefaultTask: Task { void run(): Task { } }
escaped class ExplicitEscapedTask: Task { void run(escaped this): Task { } }
struct StructTask: Task { void run(): Task { } }
class ExplicitMixed: Mixed { void keep(escaped this): Mixed { } void plain(): Mixed { } }
escaped class DefaultMixed: Mixed { void keep(): Mixed { } void plain(): Mixed { } }
escaped class EscapedMixed: Mixed { void keep(escaped this): Mixed { } void plain(): Mixed { } }
class ExplicitCallable { void run(escaped this): EscapedDelegate { } }
struct ExplicitValueCallable { void run(escaped this): EscapedDelegate { } }

class Date
{
	int year;

	nuint format(char[] buffer) : TextFormatter
	{
		int y = this.year;
		return 0;
	}
}

escaped class Test
{
	void increment() : EscapedDelegate
	{
	}

	void incrementExplicit(escaped this) : EscapedDelegate
	{
	}

	void normal() : NormalDelegate
	{
	}
}

interface ICounterReader
{
	int readCount(): CounterReader;
}

class Counter: ICounterReader
{
	int count;

	int readCount(): ICounterReader
	{
		return this.count;
	}
}

export int main()
{
	const Date d = Date();
	TextFormatter f = d.format;
	auto test = new Test();
	EscapedDelegate e1 = test.increment;
	auto e2 = test.increment;
	EscapedDelegate e3 = e2;
	EscapedDelegate e4 = test.incrementExplicit;
	NormalDelegate n1 = test.normal;
	auto n2 = test.normal;
	NormalDelegate n3 = n2;
	auto counter = new Counter();
	counter.count = 7;
	CounterReader reader = counter.readCount;
	return reader() - 7;
}
