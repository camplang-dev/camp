newtype fn bool ParseInt(const char[] text, out int value);
newtype delegate int DateFormatter(int adjust = 4);

int plusOne(DateFormatter this)
{
	return this() + 1;
}

bool tryParseInt(const char[] text, out int value) : ParseInt
{
	value = (int)text.length;
	return true;
}

class Date
{
	int year;

	int format(int adjust) : DateFormatter
	{
		return this.year + adjust;
	}
}

class Point
{
	nuint format(overload char[] buffer) : CharFormatter
	{
		return buffer.length;
	}
}

newtype delegate nuint CharFormatter(char[] buffer = default);

int main()
{
	ParseInt parser = tryParseInt;
	int parsed = 0;
	bool ok = parser("123", out parsed);

	Date* date = null;
	DateFormatter formatter = date.format;
	int dateValue = formatter();
	int extra = formatter.plusOne();
	Point* point = null;
	CharFormatter charFormatter = point.format;
	nuint formatted = charFormatter();

	return ok ? parsed + dateValue + extra + (int)formatted : 1;
}
