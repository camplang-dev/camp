extern escaped void* malloc(nuint size);
extern void free(escaped void* ptr);

newtype delegate nuint Count();

escaped Count makeSpanCount()
{
	const char[] span = "hello";
	return new delegate () => span.length;
}

escaped delegate int() makeOptionalReader()
{
	int? value = 7;
	return new delegate () => value.specified ? value.value : 0;
}

escaped delegate int() makeDelegateReader()
{
	delegate int(int) mapper = value => value + 1;
	return new delegate () => mapper.context == null ? 0 : 1;
}

export int main()
{
	auto spanCount = makeSpanCount();
	delete spanCount.context;

	auto optionalReader = makeOptionalReader();
	delete optionalReader.context;

	auto delegateReader = makeDelegateReader();
	delete delegateReader.context;

	return 0;
}
