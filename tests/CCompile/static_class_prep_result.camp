static class Tools
{
	static nuint render(prep char[] buffer = default)
	{
		if (buffer.length >= 2)
		{
			buffer[0] = 'o';
			buffer[1] = 'k';
		}
		return 2;
	}
}

export int main()
{
	auto text = Tools.render();
	if (text.length != 2 || text[0] != 'o' || text[1] != 'k')
		return 1;
	return 0;
}
