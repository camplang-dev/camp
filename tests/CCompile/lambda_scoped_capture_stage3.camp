int apply(delegate int(int) callback, int value)
{
	return callback(value);
}

export int main()
{
	int offset = 10;
	delegate int(int) addOffset = value => value + offset;
	offset = 20;

	int count = 0;
	delegate void() increment = () => count++;
	increment();
	increment();

	int direct = apply(value => value + offset, 2);
	return addOffset(1) == 21 && count == 2 && direct == 22 ? 0 : 1;
}
