extern void* malloc(nuint size);
extern void free(void* ptr);

int invoke(delegate int(within int* allocator) callback, within int* allocator)
{
	return within (allocator) callback();
}

int callbackFn(within int* allocator)
{
	return 7;
}

int main()
{
	int alloc = 0;
	int result = within (&alloc) invoke(callbackFn);
	return result - 7;
}
