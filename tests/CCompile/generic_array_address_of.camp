extern void* malloc(nuint size);
extern void free(void* ptr);

T* getAddressOf<T>(T[] items, nuint index, sizeof(T))
{
	return &items[index];
}

const T* getAddressOfConst<T>(const T[] items, nuint index, sizeof(T))
{
	return &items[index];
}

void acceptIn<T>(in T value, sizeof(T))
{
}

void passInArg<T>(T[] items, nuint index, sizeof(T))
{
	acceptIn<T>(items[index]);
}

void writeTo<T>(T[] items, nuint index, in T value, sizeof(T))
{
	items[index] = value;
}

int main()
{
	int[] arr = [10, 20, 30];
	int* p = getAddressOf<int>(arr, 1);
	const int* cp = getAddressOfConst<int>(arr, 2);
	passInArg<int>(arr, 0);
	writeTo<int>(arr, 0, *p);
	return (int)(*p) + (int)(*cp) - 50;
}
