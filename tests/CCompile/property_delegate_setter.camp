newtype delegate void ClickHandler(Button* sender);

extern class Button
{
	extern void setClick(ClickHandler click);
}

escaped class App
{
	void wire(Button* button)
	{
		button.Click = this.handle;
	}

	void handle(Button* sender): ClickHandler
	{
	}
}

App app = {};

export int main()
{
	Button* button = default;
	app.wire(button);
	return 0;
}
