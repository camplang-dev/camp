interface IValue
{
	int value();
}

struct Counter: IValue
{
	int count;

	int value(): IValue
	{
		return this.count;
	}
}

int readValue(IValue* counter)
{
	return counter.value();
}

int main()
{
	Counter c = { .count = 12 };
	int v = readValue(c);
	IValue* assigned = &c;
	v += readValue(assigned);
	v += readValue(&c);
	return v - 36;
}
