extern void* malloc(nuint size);
extern void free(void* ptr);

class Allocator
{
	void* alloc(nuint size)
	{
		return malloc(size);
	}

	void free(void* ptr)
	{
		free(ptr);
	}
}

class Inner
{
	Inner()
	{
		this.value = 3;
	}

	~Inner()
	{
		this.value = 0;
	}

	int value;
}

class Retained
{
	Retained(within this.allocator)
	{
		this.value = 7;
		Inner* inner = new Inner();
		delete inner;
	}

	~Retained()
	{
		this.value = 0;
	}

	int value;
}

int main()
{
	Allocator* allocator = null;
	within (allocator)
	{
		Retained* retained = Retained.create();
		retained.destroy();
	}
	return 0;
}
