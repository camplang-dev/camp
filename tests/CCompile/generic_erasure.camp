void accept<T>(T* value)
{
}

struct Aggregate
{
	int value;

	bool isZero() => this.value == 0;
}

Aggregate makeAggregate()
{
	return { 1 };
}

void acceptValue<T>(in T value, sizeof(T))
{
}

T identity<T>(in T value, sizeof(T))
{
	return value;
}

T getAt<T>(in T value, uint index, sizeof(T))
{
	return value;
}

int main()
{
	int value = 0;
	accept<int>(&value);
	acceptValue<Aggregate>(makeAggregate());
	Aggregate aggregate = default;
	uint count = 0;
	while (identity<Aggregate>(aggregate).isZero())
	{
		count++;
		break;
	}
	for (uint index = 0; getAt<Aggregate>(aggregate, index).isZero(); index++)
		break;
	return 0;
}
