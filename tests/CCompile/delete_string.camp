extern void* malloc(nuint size);
extern void free(void* ptr);

void deleteNow()
{
	string text = (escaped string)malloc(16);
	delete text;
}

void deleteFinally()
{
	string text = (escaped string)malloc(16) finally delete;
	_ = text;
}

export int main()
{
	deleteNow();
	deleteFinally();
	return 0;
}
