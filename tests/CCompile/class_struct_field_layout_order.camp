extern escaped void* malloc(nuint size);
extern void free(void* ptr);

class Holder
{
	Pair value;
	Wrapper wrapper;
	FixedWrapper fixedWrapper;

	Holder(int number)
	{
		this.value.number = number;
		this.wrapper.value.number = number + 1;
	}
}

struct Wrapper
{
	Pair value;
}

struct Pair
{
	int number;
}

fixed struct FixedPair { int number; }
fixed struct FixedWrapper { FixedPair value; Pair copyable; }
struct PointerWrapper
{
	Holder* object;
	FixedPair* fixedValue;
	static FixedPair shared;
}

int main()
{
	auto holder = new Holder(42);
	int result = holder.value.number + holder.wrapper.value.number;
	delete holder;
	return result - 85;
}
