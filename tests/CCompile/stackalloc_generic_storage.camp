void assignGeneric<T: copyable>(in T source, out T destination, sizeof(T))
{
	stackalloc T scratch = source;
	destination = scratch;
}

void defaultGeneric<T: copyable>(out T destination, sizeof(T))
{
	stackalloc T scratch = default;
	destination = scratch;
}

void forEachGeneric<T: copyable>(const T[] values, delegate void(in T item) visit, sizeof(T))
{
	foreach (stackalloc T value in values)
	{
		visit(value);
	}
}

interface Reader
{
	int read();
}

struct Counter: Reader
{
	int count;
	int read(): Reader => this.count;
}

int readInterface<T: implements Reader>(T* source, sizeof(T), vtableof(T: Reader))
{
	return source.read();
}

void fillOptional(int?* target, int value)
{
	*target = value;
}

int fillStorage()
{
	stackalloc void<int?> slot = (void<int?>)1;
	fillOptional(&slot, 9);
	int? read = slot;
	return read.specified ? read.value : -1;
}

int sum = 0;

void add(in int item)
{
	sum += item;
}

export int main()
{
	int value = 0;
	assignGeneric(42, out value);
	int cleared = 5;
	defaultGeneric(out cleared);
	int[] values = [1, 2, 3];
	forEachGeneric(values, add);
	Counter counter = { 4 };
	return value == 42 && cleared == 0 && sum == 6 && readInterface(&counter) == 4 && fillStorage() == 9 ? 0 : 1;
}
