export as Std;

extern void* memcpy(void* destination, const void* source, nuint count);
extern void* memmove(void* destination, const void* source, nuint count);

export class List<T>
{
	T[] buffer;
	nuint length;

	// Initializes an empty list without allocating its buffer.
	export List(sizeof(T))
	{
		this.buffer = default;
		this.length = 0;
	}

	// Releases the buffer when one has been allocated.
	export ~List()
	{
		if (this.buffer.elements != null)
		{
			free(this.buffer.elements);
			this.buffer = default;
		}
		this.length = 0;
	}

	// Adds or inserts a single item.
	export void add(T item, @index nuint at = ^0)
	{
		if (at > this.length)
			at = this.length;

		this.ensureCapacity(this.length + 1);
		if (this.buffer.length <= this.length)
			return;

		if (at < this.length)
		{
			nuint count = this.length - at;
			memmove((void*)&this.buffer.elements[at + 1], (const void*)&this.buffer.elements[at], count * sizeof(T));
		}

		this.buffer.elements[at] = item;
		this.length++;
	}

	// Removes one item and returns 1 when an item was removed.
	export nuint remove(@index nuint at)
	{
		if (at >= this.length)
			return 0;

		nuint remaining = this.length - at - 1;
		if (remaining > 0)
			memmove((void*)&this.buffer.elements[at], (const void*)&this.buffer.elements[at + 1], remaining * sizeof(T));

		this.length--;
		return 1;
	}

	// Removes a range and returns the number of items removed.
	export nuint removeRange(@range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return 0;

		if (count > this.length - startAt)
			count = this.length - startAt;

		nuint remainingStart = startAt + count;
		nuint remaining = this.length - remainingStart;
		if (remaining > 0)
			memmove((void*)&this.buffer.elements[startAt], (const void*)&this.buffer.elements[remainingStart], remaining * sizeof(T));

		this.length -= count;
		return count;
	}

	// Returns the first matching index, or -1 when no match is found.
	export nint findIndex(T item, @range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return -1;

		nuint end = startAt + count;
		if (end > this.length)
			end = this.length;

		for (nuint i = startAt; i < end; i++)
			if (this.buffer.elements[i] == item)
				return (nint)i;

		return -1;
	}

	// Returns the last matching index, or -1 when no match is found.
	export nint findLastIndex(T item, @range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return -1;

		nuint end = startAt + count;
		if (end > this.length)
			end = this.length;

		while (end > startAt)
		{
			end--;
			if (this.buffer.elements[end] == item)
				return (nint)end;
		}

		return -1;
	}

	// Clears the list and optionally releases its buffer.
	export void clear(bool deleteBuffer = false)
	{
		this.length = 0;
		if (deleteBuffer && this.buffer.elements != null)
		{
			free(this.buffer.elements);
			this.buffer = default;
		}
	}

	// Allocates a new list and copies a range of items into it.
	export List<T>* copyList(@range nuint startAt = 0, nuint count = ^0, within allocator)
	{
		List<T>* copy = (List<T>*)malloc(sizeof(List<T>));
		if (copy == null)
			return null;

		copy.buffer = default;
		copy.length = 0;
		copy._sizeof_T = this._sizeof_T;

		if (startAt >= this.length || count == 0)
			return copy;

		if (count > this.length - startAt)
			count = this.length - startAt;

		copy.ensureCapacity(count);
		if (copy.buffer.length < count)
			return copy;

		memcpy((void*)copy.buffer.elements, (const void*)&this.buffer.elements[startAt], count * sizeof(T));
		copy.length = count;
		return copy;
	}

	// Returns the number of used slots in the buffer.
	export nuint getLength()
	{
		return this.length;
	}

	// Returns the number of allocated slots in the buffer.
	export nuint getCapacity()
	{
		return this.buffer.length;
	}

	// Returns the item at an index.
	export T get(@index nuint at)
	{
		return this.buffer.elements[at];
	}

	// Replaces the item at an index.
	export void set(@index nuint at, T value)
	{
		this.buffer.elements[at] = value;
	}

	// Returns the item at an index using property syntax.
	export T getItem(@index nuint at)
	{
		return this.get(at);
	}

	// Replaces the item at an index using property syntax.
	export void setItem(@index nuint at, T value)
	{
		this.set(at, value);
	}

	// Ensures the buffer has at least the requested number of slots.
	export void ensureCapacity(nuint minimumCapacity)
	{
		if (this.buffer.length >= minimumCapacity)
			return;

		nuint capacity = this.buffer.length;
		if (capacity == 0)
			capacity = 8;

		while (capacity < minimumCapacity)
		{
			nuint grown = capacity + (capacity / 2);
			if (grown <= capacity)
				grown = capacity + 1;
			capacity = grown;
		}

		T* elements = (T*)realloc(this.buffer.elements, capacity * sizeof(T));
		if (elements == null)
			return;

		this.buffer.elements = elements;
		this.buffer.length = capacity;
	}
}
