export as Std;

extern void* memcpy(void* destination, const void* source, nuint count);
extern void* memmove(void* destination, const void* source, nuint count);

void listCopyValue(void* destination, const void* source, nuint size)
{
	if (size == 1)
	{
		((byte*)destination)[0] = ((const byte*)source)[0];
	}
	else if (size == 2)
	{
		((ushort*)destination)[0] = ((const ushort*)source)[0];
	}
	else if (size == 4)
	{
		((uint*)destination)[0] = ((const uint*)source)[0];
	}
	else if (size == 8)
	{
		((ulong*)destination)[0] = ((const ulong*)source)[0];
	}
	else
	{
		memcpy(destination, source, size);
	}
}

void listMoveValues(void* destination, const void* source, nuint count, nuint itemSize)
{
	if (count == 0)
		return;

	memmove(destination, source, count * itemSize);
}

export class List<T: any>
{
	void* buffer;
	nuint length;
	nuint capacity;
	Allocator* allocator;

	// Initializes an empty list and remembers the allocator used for storage.
	export List(within allocator, sizeof(T))
	{
		this.buffer = null;
		this.length = 0;
		this.capacity = 0;
		this.allocator = allocator;
	}

	// Releases the allocated element buffer, if any.
	export ~List()
	{
		if (this.buffer != null)
		{
			if (this.allocator != null)
				this.allocator.free(this.buffer);
			else
				free(this.buffer);
		}

		this.buffer = null;
		this.length = 0;
		this.capacity = 0;
	}

	void* itemAddress(@index nuint at)
	{
		return (void*)&((byte*)this.buffer)[at * sizeof(T)];
	}

	// Adds or inserts a single item.
	export void add(in T item, @index nuint at = ^0)
	{
		if (at > this.length)
			at = this.length;

		this.ensureCapacity(this.length + 1);
		if (this.capacity <= this.length)
			return;

		if (at < this.length)
			listMoveValues(this.itemAddress(at + 1), this.itemAddress(at), this.length - at, sizeof(T));

		listCopyValue(this.itemAddress(at), (const void*)&item, sizeof(T));
		this.length++;
	}

	// Replaces the item at an index.
	export void setItem(@index nuint at, in T value)
	{
		if (at >= this.length)
			return;

		listCopyValue(this.itemAddress(at), (const void*)&value, sizeof(T));
	}

	// Returns the item at an index.
	export T getItem(@index nuint at)
	{
		T result = default;
		if (at < this.length)
			listCopyValue((void*)&result, (const void*)this.itemAddress(at), sizeof(T));
		return result;
	}

	// Removes one item and returns 1 when an item was removed.
	export nuint remove(@index nuint at)
	{
		if (at >= this.length)
			return 0;

		nuint remaining = this.length - at - 1;
		if (remaining > 0)
			listMoveValues(this.itemAddress(at), this.itemAddress(at + 1), remaining, sizeof(T));

		this.length--;
		return 1;
	}

	// Removes a range and returns the number of items removed.
	export nuint removeRange(@range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return 0;

		if (count > this.length - startAt)
			count = this.length - startAt;

		nuint remainingStart = startAt + count;
		nuint remaining = this.length - remainingStart;
		if (remaining > 0)
			listMoveValues(this.itemAddress(startAt), this.itemAddress(remainingStart), remaining, sizeof(T));

		this.length -= count;
		return count;
	}

	// Clears the list and optionally releases its buffer.
	export void clear(bool deleteBuffer = false)
	{
		this.length = 0;
		if (deleteBuffer && this.buffer != null)
		{
			if (this.allocator != null)
				this.allocator.free(this.buffer);
			else
				free(this.buffer);

			this.buffer = null;
			this.capacity = 0;
		}
	}

	// Allocates a new list and copies a range of items into it.
	export List<T>* copyList(@range nuint startAt = 0, nuint count = ^0)
	{
		void* storage = null;
		if (this.allocator != null)
			storage = this.allocator.alloc(sizeof(List<T>));
		else
			storage = malloc(sizeof(List<T>));

		List<T>* copy = (List<T>*)storage;
		if (copy == null)
			return null;

		copy.buffer = null;
		copy.length = 0;
		copy.capacity = 0;
		copy.allocator = this.allocator;
		copy._sizeof_T = this._sizeof_T;

		if (startAt >= this.length || count == 0)
			return copy;

		if (count > this.length - startAt)
			count = this.length - startAt;

		copy.ensureCapacity(count);
		if (copy.capacity < count)
			return copy;

		listMoveValues(copy.buffer, this.itemAddress(startAt), count, sizeof(T));
		copy.length = count;
		return copy;
	}

	// Adds or inserts all items from an array.
	export void addArray(T[] const array, @index nuint at = ^0)
	{
		if (array.length == 0)
			return;

		if (at > this.length)
			at = this.length;

		nuint newLength = this.length + array.length;
		this.ensureCapacity(newLength);
		if (this.capacity < newLength)
			return;

		if (at < this.length)
			listMoveValues(this.itemAddress(at + array.length), this.itemAddress(at), this.length - at, sizeof(T));

		listMoveValues(this.itemAddress(at), (const void*)array.elements, array.length, sizeof(T));
		this.length = newLength;
	}

	// Transfers the owned buffer to the caller as an array and empties the list.
	export T[] takeBuffer()
	{
		T[] bufferResult = default;
		bufferResult.elements = (T*)this.buffer;
		bufferResult.length = this.length;
		this.buffer = null;
		this.length = 0;
		this.capacity = 0;
		return bufferResult;
	}

	// Allocates a new array and copies a range of items into it.
	export T[] copyArray(@range nuint startAt = 0, nuint count = ^0)
	{
		T[] arrayResult = default;
		if (startAt >= this.length || count == 0)
			return arrayResult;

		if (count > this.length - startAt)
			count = this.length - startAt;

		void* storage = null;
		if (this.allocator != null)
			storage = this.allocator.alloc(count * sizeof(T));
		else
			storage = malloc(count * sizeof(T));

		if (storage == null)
			return arrayResult;

		listMoveValues(storage, this.itemAddress(startAt), count, sizeof(T));
		arrayResult.elements = (T*)storage;
		arrayResult.length = count;
		return arrayResult;
	}

	// Copies a range of items into an existing array.
	export void copyTo(T[] dest, nuint destIndex, @range nuint startAt = 0, nuint count = ^0)
	{
		if (destIndex >= dest.length || startAt >= this.length || count == 0)
			return;

		if (count > this.length - startAt)
			count = this.length - startAt;
		if (count > dest.length - destIndex)
			count = dest.length - destIndex;
		if (count == 0)
			return;

		listMoveValues((void*)&((byte*)dest.elements)[destIndex * sizeof(T)], this.itemAddress(startAt), count, sizeof(T));
	}

	// Returns the first matching index, or -1 when no match is found.
	export nint findIndex(in T item, delegate bool(in T left, in T right) equals, @range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return -1;

		nuint end = startAt + count;
		if (end > this.length)
			end = this.length;

		for (nuint i = startAt; i < end; i++)
			if (equals(this.getItem(i), item))
				return (nint)i;

		return -1;
	}

	// Returns the last matching index, or -1 when no match is found.
	export nint findLastIndex(in T item, delegate bool(in T left, in T right) equals, @range nuint startAt = 0, nuint count = ^0)
	{
		if (startAt >= this.length || count == 0)
			return -1;

		nuint end = startAt + count;
		if (end > this.length)
			end = this.length;

		while (end > startAt)
		{
			end--;
			if (equals(this.getItem(end), item))
				return (nint)end;
		}

		return -1;
	}

	// Sorts the list in place using the supplied comparer.
	export void sort(delegate int(in T left, in T right) comparer)
	{
		if (this.length < 2)
			return;

		void* temp = this.allocator != null ? this.allocator.alloc(sizeof(T)) : malloc(sizeof(T));
		if (temp == null)
			return;

		for (nuint i = 1; i < this.length; i++)
		{
			listCopyValue(temp, this.itemAddress(i), sizeof(T));
			T pivot = default;
			listCopyValue((void*)&pivot, temp, sizeof(T));
			nuint j = i;
			while (j > 0 && comparer(this.getItem(j - 1), pivot) > 0)
			{
				listCopyValue(this.itemAddress(j), this.itemAddress(j - 1), sizeof(T));
				j--;
			}
			listCopyValue(this.itemAddress(j), temp, sizeof(T));
		}

		if (this.allocator != null)
			this.allocator.free(temp);
		else
			free(temp);
	}

	// Returns the number of items in the list.
	export nuint getLength()
	{
		return this.length;
	}

	// Returns the number of allocated item slots.
	export nuint getCapacity()
	{
		return this.capacity;
	}

	// Ensures the buffer has at least the requested number of slots.
	export void ensureCapacity(nuint minimumCapacity)
	{
		if (this.capacity >= minimumCapacity)
			return;

		nuint newCapacity = this.capacity;
		if (newCapacity == 0)
			newCapacity = 8;

		while (newCapacity < minimumCapacity)
		{
			nuint grown = newCapacity + (newCapacity / 2);
			if (grown <= newCapacity)
				grown = newCapacity + 1;
			newCapacity = grown;
		}

		void* newBuffer = null;
		if (this.allocator != null)
			newBuffer = this.allocator.alloc(newCapacity * sizeof(T));
		else
			newBuffer = malloc(newCapacity * sizeof(T));

		if (newBuffer == null)
			return;

		if (this.buffer != null)
		{
			listMoveValues(newBuffer, this.buffer, this.length, sizeof(T));
			if (this.allocator != null)
				this.allocator.free(this.buffer);
			else
				free(this.buffer);
		}

		this.buffer = newBuffer;
		this.capacity = newCapacity;
	}
}
