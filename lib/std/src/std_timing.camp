namespace Std;

@category("Synchronization");
requires (SUPPORTS_TIMERS && (SUBSYSTEM_POSIX || OS_WIN32));

/// Represents a running timer.
/// @remarks
/// A default handle means no timer was started. Handles are opaque and are only
/// valid for calls to [stopTimer].
public newtype TimerHandle: nint;

/// Suspends the current thread for approximately the requested duration.
/// - timeoutMs: The number of milliseconds to wait. A value of 0 returns immediately.
public void sleep(nuint timeoutMs)
{
	timingSleepPlatform(timeoutMs);
}

/// Completes after approximately the requested duration.
/// @remarks
/// The completion callback is invoked by a platform timer thread after the
/// delay. A caller that needs to resume on a specific thread should use an
/// async resumer that marshals continuations to that thread.
/// - timeoutMs: The number of milliseconds to wait. A value of 0 completes immediately.
/// - complete: The callback to invoke when the delay elapses.
public void sleepAsync(nuint timeoutMs, escaped once void() complete)
{
	if (timeoutMs == 0)
	{
		complete();
		return;
	}

	startTimer(timeoutMs, within(default) new delegate h => {
		stopTimer(h);
		complete();
	});
}

/// Starts a repeating timer.
/// @remarks
/// The callback runs on a platform timer thread until [stopTimer] is called with
/// the supplied handle. The callback is escaped because the timer may outlive the
/// call to [startTimer].
/// - intervalMs: The number of milliseconds between callback invocations. A value of 0 does not start a timer.
/// - callback: The function to invoke for each tick.
/// @returns A non-default handle when the timer starts successfully; otherwise `default`.
public TimerHandle startTimer(nuint intervalMs, escaped delegate void(TimerHandle handle) callback)
{
	return timingStartTimerPlatform(intervalMs, callback);
}

/// Requests cancellation of a running timer.
/// @remarks
/// Cancellation is cooperative. A callback that is already running may finish
/// after this function returns.
/// - handle: The timer handle returned by [startTimer].
public void stopTimer(TimerHandle handle)
{
	timingStopTimerPlatform(handle);
}

/// Atomically stores a signed native integer and returns the previous value.
/// - dest: The storage location to update.
/// - value: The value to store.
@symbol("atomicExchangeNInt")
public extern nint atomicExchange(overload nint* dest, nint value);

/// Atomically stores an unsigned native integer and returns the previous value.
/// - dest: The storage location to update.
/// - value: The value to store.
@symbol("atomicExchangeNUInt")
public extern nuint atomicExchange(overload nuint* dest, nuint value);

/// Atomically stores a pointer and returns the previous value.
/// - dest: The storage location to update.
/// - value: The value to store.
@symbol("atomicExchangePtr")
public extern void* atomicExchange(overload void** dest, void* value);

/// Atomically stores a signed native integer when the current value matches `expected`.
/// @returns The value that was stored before the operation.
/// - dest: The storage location to update.
/// - expected: The value that must currently be stored for the exchange to occur.
/// - value: The value to store when `expected` matches.
@symbol("atomicCompareExchangeNInt")
public extern nint atomicCompareExchange(overload nint* dest, nint expected, nint value);

/// Atomically stores an unsigned native integer when the current value matches `expected`.
/// @returns The value that was stored before the operation.
/// - dest: The storage location to update.
/// - expected: The value that must currently be stored for the exchange to occur.
/// - value: The value to store when `expected` matches.
@symbol("atomicCompareExchangeNUInt")
public extern nuint atomicCompareExchange(overload nuint* dest, nuint expected, nuint value);

/// Atomically stores a pointer when the current value matches `expected`.
/// @returns The value that was stored before the operation.
/// - dest: The storage location to update.
/// - expected: The value that must currently be stored for the exchange to occur.
/// - value: The value to store when `expected` matches.
@symbol("atomicCompareExchangePtr")
public extern void* atomicCompareExchange(overload void** dest, void* expected, void* value);

namespace global
{
	requires (SUBSYSTEM_POSIX)
	{
		extern int usleep(uint usec);

		extern int pthread_create(nint* thread, void* attr, fn void*(void*) start, void* arg);

		extern int pthread_detach(nint thread);
	}
}

requires (SUBSYSTEM_POSIX)
{
	const nuint TIMING_POSIX_SLEEP_CHUNK_MS = 1000;

	void timingSleepPosix(nuint timeoutMs)
	{
		while (timeoutMs > 0)
		{
			nuint step = timeoutMs > TIMING_POSIX_SLEEP_CHUNK_MS ? TIMING_POSIX_SLEEP_CHUNK_MS : timeoutMs;
			global::usleep((uint)(step * 1000));
			timeoutMs -= step;
		}
	}

	void* timingPosixTimerThread(void* context)
	{
		TimingTimerState* state = (TimingTimerState*)context;
		TimerHandle handle = (TimerHandle)(nint)state;

		while (!state.cancelled)
		{
			timingSleepPosix(state.intervalMs);
			if (!state.cancelled)
				state.callback(handle);
		}

		within(default) delete state;
		return null;
	}

	TimerHandle timingStartTimerPosix(nuint intervalMs, escaped delegate void(TimerHandle handle) callback)
	{
		if (intervalMs == 0 || callback == default)
			return default;

		auto state = within(default) new TimingTimerState();
		if (state == null)
			return default;

		state.intervalMs = intervalMs;
		state.callback = callback;
		if (global::pthread_create(&state.thread, null, timingPosixTimerThread, state) != 0)
		{
			within(default) delete state;
			return default;
		}

		global::pthread_detach(state.thread);
		return (TimerHandle)(nint)state;
	}

	void timingStopTimerPosix(TimerHandle handle)
	{
		if (handle == default)
			return;

		TimingTimerState* state = (TimingTimerState*)(nint)handle;
		state.cancelled = true;
	}
}

escaped class TimingTimerState
{
	bool cancelled;
	nuint intervalMs;
	escaped delegate void(TimerHandle handle) callback;
	nint thread;
}

requires (OS_WIN32)
{
	const nuint TIMING_WINDOWS_SLEEP_CHUNK_MS = 0xFFFFFFFF;

	@symbol("Sleep")
	extern _winapi void timingWinSleep(uint dwMilliseconds);

	@symbol("CreateThread")
	extern _winapi void* timingWinCreateThread(
		void* lpThreadAttributes,
		nuint dwStackSize,
		fn _winapi uint(void*) lpStartAddress,
		void* lpParameter,
		uint dwCreationFlags,
		uint* lpThreadId
	);

	@symbol("CloseHandle")
	extern _winapi int timingWinCloseHandle(void* hObject);

	void timingSleepWindows(nuint timeoutMs)
	{
		while (timeoutMs > 0)
		{
			nuint step = timeoutMs > TIMING_WINDOWS_SLEEP_CHUNK_MS ? TIMING_WINDOWS_SLEEP_CHUNK_MS : timeoutMs;
			timingWinSleep((uint)step);
			timeoutMs -= step;
		}
	}

	_winapi uint timingWindowsTimerThread(void* context)
	{
		TimingTimerState* state = (TimingTimerState*)context;
		TimerHandle handle = (TimerHandle)(nint)state;

		while (!state.cancelled)
		{
			timingSleepWindows(state.intervalMs);
			if (!state.cancelled)
				state.callback(handle);
		}

		within(default) delete state;
		return 0;
	}

	TimerHandle timingStartTimerWindows(nuint intervalMs, escaped delegate void(TimerHandle handle) callback)
	{
		if (intervalMs == 0 || callback == default)
			return default;

		auto state = within(default) new TimingTimerState();
		if (state == null)
			return default;

		state.intervalMs = intervalMs;
		state.callback = callback;

		void* thread = timingWinCreateThread(null, 0, timingWindowsTimerThread, state, 0, null);
		if (thread == null)
		{
			within(default) delete state;
			return default;
		}

		timingWinCloseHandle(thread);
		return (TimerHandle)(nint)state;
	}

	void timingStopTimerWindows(TimerHandle handle)
	{
		if (handle == default)
			return;

		TimingTimerState* state = (TimingTimerState*)(nint)handle;
		state.cancelled = true;
	}
}

void timingSleepPlatform(nuint timeoutMs)
{
	if (configured(SUBSYSTEM_POSIX))
	{
		timingSleepPosix(timeoutMs);
		return;
	}
	if (configured(OS_WIN32))
	{
		timingSleepWindows(timeoutMs);
		return;
	}
}

TimerHandle timingStartTimerPlatform(nuint intervalMs, escaped delegate void(TimerHandle handle) callback)
{
	if (configured(SUBSYSTEM_POSIX))
		return timingStartTimerPosix(intervalMs, callback);
	if (configured(OS_WIN32))
		return timingStartTimerWindows(intervalMs, callback);
}

void timingStopTimerPlatform(TimerHandle handle)
{
	if (configured(SUBSYSTEM_POSIX))
	{
		timingStopTimerPosix(handle);
		return;
	}
	if (configured(OS_WIN32))
	{
		timingStopTimerWindows(handle);
		return;
	}
}
