export as Std;

export extern void* malloc(nuint size);
export extern void* realloc(void* ptr, nuint new_size);
export extern void free(void* ptr);

export abstract class Allocator
{
	export abstract void* alloc(nuint size);
	export abstract void free(escaped void* ptr);
}

export virtual class HeapAllocator: Allocator
{
	export override void* alloc(nuint size)
	{
		return malloc(size);
	}
	
	export override void free(escaped void* ptr)
	{
		free(ptr);
	}
}
