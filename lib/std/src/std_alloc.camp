namespace Std;

public extern void* malloc(nuint size);
public extern void* realloc(void* ptr, nuint new_size);
public extern void free(void* ptr);

public abstract class Allocator
{
	public abstract void* alloc(nuint size);
	public abstract void* realloc(void* ptr, nuint newSize);
	public abstract void free(void* ptr);
}

public virtual class HeapAllocator: Allocator
{
	public override void* alloc(nuint size)
	{
		return malloc(size);
	}
	
	public override void* realloc(void* ptr, nuint newSize)
	{
		return realloc(ptr, newSize);
	}
	
	public override void free(void* ptr)
	{
		free(ptr);
	}
}
