export void write(CharWriter this, overload float value)
{
	this.write((double)value);
}

export bool tryWrite(CharWriter this, overload float value, thrown IoError error)
{
	return this.tryWrite((double)value, catch error);
}

export void write(CharWriter this, overload double value)
{
	this.tryWrite(value, catch _);
}

export bool tryWrite(CharWriter this, overload double value, thrown IoError error)
{
	if (value < 0.0)
	{
		CharWriter_tryWriteChar(this, '-');
		value = 0.0 - value;
	}
	
	uint integerPart = (uint)value;
	CharWriter_tryWriteUInt(this, integerPart);
	CharWriter_tryWriteChar(this, '.');
	
	double fraction = value - (double)integerPart;
	for (int i = 0; i < 6; i++)
	{
		fraction *= 10.0;
		uint digit = (uint)fraction;
		CharWriter_tryWriteChar(this, (char)((int)'0' + (int)digit));
		fraction -= (double)digit;
	}
	return true;
}

escaped string readCopy(CharReader this, bool stopAtNewline, within allocator, thrown IoError error)
{
	char* buffer = null;
	nuint length = 0;
	nuint capacity = 0;
	bool reading = true;
	
	while (reading)
	{
		char ch = CharReader_readChar(this, catch error);
		if (error != default)
		{
			if (buffer != null)
				delete buffer;
			return null;
		}
		
		if (ch == '\0')
		{
			reading = false;
		}
		else
		{
			if (length + 1 >= capacity)
			{
				buffer = CharReader_growBuffer(buffer, length, capacity, within allocator, catch error);
				if (error != default)
					return null;
				capacity = capacity == 0 ? 64 : capacity * 2;
			}
			
			buffer[length] = ch;
			if (stopAtNewline && ch == '\n')
				reading = false;
			else
				length++;
		}
	}
	
	if (length + 1 >= capacity)
	{
		buffer = CharReader_growBuffer(buffer, length, capacity, within allocator, catch error);
		if (error != default)
			return null;
	}
	buffer[length] = '\0';
	return (string)buffer;
}

escaped char* CharReader_growBuffer(char* buffer, nuint length, nuint capacity, within allocator, thrown IoError error)
{
	nuint nextCapacity = capacity == 0 ? 64 : capacity * 2;
	char[] nextArray = new char[nextCapacity];
	if (nextArray.elements == null)
		throw NO_MEMORY;
	char* next = nextArray.elements;
	
	for (nuint i = 0; i < length; i++)
		next[i] = buffer[i];
	if (buffer != null)
		delete buffer;
	return next;
}

export char readChar(CharReader this, thrown IoError error)
{
	char[] buffer = ['\0'];
	nuint readCount = 0;
	if (!this(&readCount, buffer.elements, buffer.length))
		throw IO;
	if (readCount == 0)
		return '\0';
	return buffer[0];
}

export escaped string readLine(CharReader this, within allocator, thrown IoError error)
{
	return CharReader_readCopy(this, true, within allocator, catch error);
}

export escaped string readToEnd(CharReader this, within allocator, thrown IoError error)
{
	return CharReader_readCopy(this, false, within allocator, catch error);
}

