export void writeAll(ByteWriter this, const byte[] value, thrown IoError error)
{
	nuint offset = 0;
	while (offset < value.length)
	{
		const byte[] remaining = default;
		remaining.elements = &value.elements[offset];
		remaining.length = value.length - offset;
		
		nuint written = 0;
		if (!this(&written, (byte*)remaining.elements, remaining.length))
			throw FAILED;
		if (written == 0)
			throw FAILED;
		offset += written;
	}
}

export void write(CharWriter this, overload char value, thrown IoError error)
{
	const char[] buffer = [value];
	nuint written = 0;
	if (!this(&written, (char*)buffer.elements, buffer.length) || written != 1)
		throw FAILED;
}

export void write(CharWriter this, overload const char[] value, thrown IoError error)
{
	nuint offset = 0;
	while (offset < value.length)
	{
		const char[] remaining = default;
		remaining.elements = &value.elements[offset];
		remaining.length = value.length - offset;
		
		nuint written = 0;
		if (!this(&written, (char*)remaining.elements, remaining.length))
			throw FAILED;
		if (written == 0)
			throw FAILED;
		offset += written;
	}
}

export void writeLine(CharWriter this, const char[] value = default, thrown IoError error)
{
	CharWriter_writeCharArray(this, value, catch error);
	CharWriter_writeChar(this, '\n', catch error);
}

export void write(CharWriter this, overload bool value, thrown IoError error)
{
	if (value)
		CharWriter_writeCharArray(this, "true", catch error);
	else
		CharWriter_writeCharArray(this, "false", catch error);
}

export void write(CharWriter this, overload int value, thrown IoError error)
{
	if (value < 0)
	{
		CharWriter_writeChar(this, '-', catch error);
		CharWriter_writeUInt(this, (uint)(0 - value), catch error);
	}
	else
	{
		CharWriter_writeUInt(this, (uint)value, catch error);
	}
}

export void write(CharWriter this, overload uint value, thrown IoError error)
{
	if (value >= 10)
		CharWriter_writeUInt(this, value / 10, catch error);
	CharWriter_writeChar(this, (char)((int)'0' + (int)(value % 10)), catch error);
}

export void write(CharWriter this, overload double value, thrown IoError error)
{
	if (value < 0.0)
	{
		CharWriter_writeChar(this, '-', catch error);
		value = 0.0 - value;
	}
	
	uint integerPart = (uint)value;
	CharWriter_writeUInt(this, integerPart, catch error);
	CharWriter_writeChar(this, '.', catch error);
	
	double fraction = value - (double)integerPart;
	for (int i = 0; i < 6; i++)
	{
		fraction *= 10.0;
		uint digit = (uint)fraction;
		CharWriter_writeChar(this, (char)((int)'0' + (int)digit), catch error);
		fraction -= (double)digit;
	}
}

char* CharReader_growBuffer(char* buffer, nuint length, nuint capacity, within allocator, thrown IoError error)
{
	nuint nextCapacity = capacity == 0 ? 64 : capacity * 2;
	char[] nextArray = new char[nextCapacity];
	if (nextArray.elements == null)
		throw FAILED;
	char* next = nextArray.elements;
	
	for (nuint i = 0; i < length; i++)
		next[i] = buffer[i];
	if (buffer != null)
		delete buffer;
	return next;
}

string readCopy(CharReader this, bool stopAtNewline, within allocator, thrown IoError error)
{
	char* buffer = null;
	nuint length = 0;
	nuint capacity = 0;
	bool reading = true;
	
	while (reading)
	{
		char ch = CharReader_readChar(this, catch error);
		if (error != default)
		{
			if (buffer != null)
				delete buffer;
			return null;
		}
		
		if (ch == '\0')
		{
			reading = false;
		}
		else
		{
			if (length + 1 >= capacity)
			{
				buffer = CharReader_growBuffer(buffer, length, capacity, within allocator, catch error);
				if (error != default)
					return null;
				capacity = capacity == 0 ? 64 : capacity * 2;
			}
			
			buffer[length] = ch;
			if (stopAtNewline && ch == '\n')
				reading = false;
			else
				length++;
		}
	}
	
	if (length + 1 >= capacity)
	{
		buffer = CharReader_growBuffer(buffer, length, capacity, within allocator, catch error);
		if (error != default)
			return null;
	}
	buffer[length] = '\0';
	return (string)buffer;
}

export char readChar(CharReader this, thrown IoError error)
{
	char[] buffer = ['\0'];
	nuint readCount = 0;
	if (!this(&readCount, buffer.elements, buffer.length))
		throw FAILED;
	if (readCount == 0)
		return '\0';
	return buffer[0];
}

export string readLine(CharReader this, within allocator, thrown IoError error)
{
	return CharReader_readCopy(this, true, within allocator, catch error);
}

export string readToEnd(CharReader this, within allocator, thrown IoError error)
{
	return CharReader_readCopy(this, false, within allocator, catch error);
}

