export enum IoError
{
	OK = 0,
	UNKNOWN,
	INVALID_ARGUMENT,
	NOT_SUPPORTED,
	NOT_FOUND,
	ALREADY_EXISTS,
	PERMISSION_DENIED,
	BUSY,
	INTERRUPTED,
	WOULD_BLOCK,
	TOO_MANY_OPEN_FILES,
	PATH_TOO_LONG,
	NO_SPACE,
	READ_ONLY,
	IS_DIRECTORY,
	NOT_DIRECTORY,
	DIRECTORY_NOT_EMPTY,
	BROKEN_PIPE,
	IO,
	NO_MEMORY,
	TIMEOUT
}

