export bool tryWriteAll(ByteWriter this, const byte[] value, thrown IoError error)
{
	nuint offset = 0;
	while (offset < value.length)
	{
		const byte[] remaining = { &value.elements[offset], value.length - offset };
		
		nuint written = 0;
			if (!this(&written, (unsafe byte*)remaining.elements, remaining.length))
			throw IO;
		if (written == 0)
			throw IO;
		offset += written;
	}
	return true;
}

export void write(CharWriter this, overload char value)
{
	this.tryWrite(value, catch _);
}

export bool tryWrite(CharWriter this, overload char value, thrown IoError error)
{
	const char[] buffer = [value];
	nuint written = 0;
	if (!this(&written, (unsafe char*)buffer.elements, buffer.length) || written != 1)
		throw IO;
	return true;
}

export void write(CharWriter this, overload const char[] value)
{
	this.tryWrite(value, catch _);
}

export bool tryWrite(CharWriter this, overload const char[] value, thrown IoError error)
{
	nuint writeLength = 0;
	while (writeLength < value.length && value.elements[writeLength] != '\0')
		writeLength++;
	
	nuint offset = 0;
	while (offset < writeLength)
	{
		const char[] remaining = { &value.elements[offset], writeLength - offset };
		
		nuint written = 0;
			if (!this(&written, (unsafe char*)remaining.elements, remaining.length))
			throw IO;
		if (written == 0)
			throw IO;
		offset += written;
	}
	return true;
}

export void newLine(CharWriter this)
{
	this.tryWrite('\n', catch _);
}

export bool tryNewLine(CharWriter this, thrown IoError error)
{
	return this.tryWrite('\n', catch error);
}

export void write(CharWriter this, overload CharFormatter formatter)
{
	this.tryWrite(formatter, catch _);
}

export bool tryWrite(CharWriter this, overload CharFormatter formatter, thrown IoError error)
{
	auto size = formatter();
	auto buf = init char[size];
	formatter(buf);
	return this.tryWrite(buf, catch error);
}

export void writeLine(CharWriter this, overload CharFormatter formatter)
{
	this.tryWriteLine(formatter, catch _);
}

export bool tryWriteLine(CharWriter this, overload CharFormatter formatter, thrown IoError error)
{
	auto size = formatter();
	auto buf = init char[size+1];
	formatter(buf);
	buf[buf.length - 2] = '\n';
	buf[buf.length - 1] = '\0';
	return this.tryWrite(buf, catch error);
}

export void writeLine(CharWriter this, overload const char[] value)
{
	this.write(value);
	this.write('\n');
}

export bool tryWriteLine(CharWriter this, overload const char[] value, thrown IoError error)
{
	this.tryWrite(value);
	this.tryWrite('\n');
	return true;
}

export void write(CharWriter this, overload bool value)
{
	this.tryWrite(value, catch _);
}

export bool tryWrite(CharWriter this, overload bool value, thrown IoError error)
{
	if (value)
		this.writeCharArray("true");
	else
		this.writeCharArray("false");
	return true;
}

