export CharReader getCharReader(ByteReader this)
{
	CharReader reader = default;
	reader.call = (fn bool(void*, nuint*, char*, nuint))this.call;
	reader.context = this.context;
	return reader;
}

export WCharReader getWCharReader(ByteReader this)
{
	WCharReader reader = default;
	reader.call = (fn bool(void*, nuint*, wchar*, nuint))this.call;
	reader.context = this.context;
	return reader;
}

export ACharReader getACharReader(ByteReader this)
{
	ACharReader reader = default;
	reader.call = (fn bool(void*, nuint*, achar*, nuint))this.call;
	reader.context = this.context;
	return reader;
}

export CharWriter getCharWriter(ByteWriter this)
{
	CharWriter writer = default;
	writer.call = (fn bool(void*, nuint*, char*, nuint))this.call;
	writer.context = this.context;
	return writer;
}

export WCharWriter getWCharWriter(ByteWriter this)
{
	WCharWriter writer = default;
	writer.call = (fn bool(void*, nuint*, wchar*, nuint))this.call;
	writer.context = this.context;
	return writer;
}

export ACharWriter getACharWriter(ByteWriter this)
{
	ACharWriter writer = default;
	writer.call = (fn bool(void*, nuint*, achar*, nuint))this.call;
	writer.context = this.context;
	return writer;
}

