namespace Std;

/// Groups the hash and equality functions used by a hash-based collection.
export struct HashPolicy<K: any>
{
	fn nuint(in K key) hash;
	fn bool(in K left, in K right) equals;
}

inline nuint HASH_OFFSET = (nuint)1469598103934665603;
inline nuint HASH_PRIME = (nuint)1099511628211;

nuint hashMix(nuint hash, nuint value)
{
	hash = hash ^ value;
	return hash * HASH_PRIME;
}

nuint hashInteger(nuint value)
{
	return hashMix(HASH_OFFSET, value);
}

/// Returns a hash code for an `sbyte`.
export nuint hashcode(in sbyte this) => hashInteger((nuint)(int)this);

/// Returns true when two `sbyte` keys are equal.
export bool hashEquals(in sbyte this, in sbyte other) => this == other;

/// Standard hash policy for `sbyte`.
export static const HashPolicy<sbyte> sbyte.HASH_POLICY = { .hash = SByte_hashcode, .equals = SByte_hashEquals };

/// Returns a hash code for a `ushort`.
export nuint hashcode(in ushort this) => hashInteger((nuint)this);

/// Returns true when two `ushort` keys are equal.
export bool hashEquals(in ushort this, in ushort other) => this == other;

/// Standard hash policy for `ushort`.
export static const HashPolicy<ushort> ushort.HASH_POLICY = { .hash = UShort_hashcode, .equals = UShort_hashEquals };

/// Returns a hash code for a `short`.
export nuint hashcode(in short this) => hashInteger((nuint)(int)this);

/// Returns true when two `short` keys are equal.
export bool hashEquals(in short this, in short other) => this == other;

/// Standard hash policy for `short`.
export static const HashPolicy<short> short.HASH_POLICY = { .hash = Short_hashcode, .equals = Short_hashEquals };

/// Returns a hash code for a `uint`.
export nuint hashcode(in uint this) => hashInteger((nuint)this);

/// Returns true when two `uint` keys are equal.
export bool hashEquals(in uint this, in uint other) => this == other;

/// Standard hash policy for `uint`.
export static const HashPolicy<uint> uint.HASH_POLICY = { .hash = UInt_hashcode, .equals = UInt_hashEquals };

/// Returns a hash code for an `int`.
export nuint hashcode(in int this) => hashInteger((nuint)this);

/// Returns true when two `int` keys are equal.
export bool hashEquals(in int this, in int other) => this == other;

/// Standard hash policy for `int`.
export static const HashPolicy<int> int.HASH_POLICY = { .hash = Int_hashcode, .equals = Int_hashEquals };

/// Returns a hash code for a `ulong`.
export nuint hashcode(in ulong this)
{
	nuint hash = HASH_OFFSET;
	hash = hashMix(hash, (nuint)this);
	if (sizeof(ulong) > sizeof(nuint))
		hash = hashMix(hash, (nuint)(this >> ((nuint)sizeof(nuint) * 8)));
	return hash;
}

/// Returns true when two `ulong` keys are equal.
export bool hashEquals(in ulong this, in ulong other) => this == other;

/// Standard hash policy for `ulong`.
export static const HashPolicy<ulong> ulong.HASH_POLICY = { .hash = ULong_hashcode, .equals = ULong_hashEquals };

/// Returns a hash code for a `long`.
export nuint hashcode(in long this) => ULong_hashcode((ulong)this);

/// Returns true when two `long` keys are equal.
export bool hashEquals(in long this, in long other) => this == other;

/// Standard hash policy for `long`.
export static const HashPolicy<long> long.HASH_POLICY = { .hash = Long_hashcode, .equals = Long_hashEquals };

/// Returns a hash code for a `nuint`.
export nuint hashcode(in nuint this) => hashInteger(this);

/// Returns true when two `nuint` keys are equal.
export bool hashEquals(in nuint this, in nuint other) => this == other;

/// Standard hash policy for `nuint`.
export static const HashPolicy<nuint> nuint.HASH_POLICY = { .hash = NUInt_hashcode, .equals = NUInt_hashEquals };

/// Returns a hash code for an `nint`.
export nuint hashcode(in nint this) => hashInteger((nuint)this);

/// Returns true when two `nint` keys are equal.
export bool hashEquals(in nint this, in nint other) => this == other;

/// Standard hash policy for `nint`.
export static const HashPolicy<nint> nint.HASH_POLICY = { .hash = NInt_hashcode, .equals = NInt_hashEquals };

/// Returns a pointer-identity hash code.
export nuint hashcodePointer<T: any>(in T* this) => hashInteger((nuint)(nint)this);

/// Returns true when two pointer keys have the same address.
export bool hashEqualsPointer<T: any>(in T* this, in T* other) => this == other;

/// Returns a pointer-identity hash policy for `T*`.
export HashPolicy<T*> Ptr_hashPolicy<T: any>() => { .hash = hashcodePointer, .equals = hashEqualsPointer };

/// Returns a content hash code for a string.
export nuint hashcode(in string this)
{
	if (this == null)
		return 0;

	nuint hash = HASH_OFFSET;
	const char[] text = { this, this.Length };
	for (nuint i = 0; i < text.length; i++)
		hash = hashMix(hash, (nuint)text[i]);
	return hash;
}

/// Returns a hash code for case-insensitive string matching.
export nuint hashcodeCaseInsensitive(in string this)
{
	if (this == null)
		return 0;

	return HASH_OFFSET;
}

/// Returns true when two strings have the same content.
export bool hashEquals(in string this, in string other)
{
	if (this == other)
		return true;
	if (this == null || other == null)
		return false;

	const char[] left = { this, this.Length };
	const char[] right = { other, other.Length };
	return left.compareTo(right) == 0;
}

/// Returns true when two strings have the same content ignoring case.
export bool hashEqualsCaseInsensitive(in string this, in string other)
{
	if (this == other)
		return true;
	if (this == null || other == null)
		return false;

	const char[] left = { this, this.Length };
	const char[] right = { other, other.Length };
	return left.compareTo(right, true) == 0;
}

/// Standard case-sensitive string hash policy.
export static const HashPolicy<string> string.HASH_POLICY = { .hash = String_hashcode, .equals = String_hashEquals };

/// Standard case-insensitive string hash policy.
export static const HashPolicy<string> string.CASE_INSENSITIVE_HASH_POLICY = { .hash = String_hashcodeCaseInsensitive, .equals = String_hashEqualsCaseInsensitive };
