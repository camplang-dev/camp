namespace Std;

@category("Text");

/// Finds the first matching ASCII span.
/// - match: Text to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint indexOf(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	if (matchLength == 0)
		return 0;
	if (matchLength > length)
		return -1;

	nuint last = length - matchLength;
	for (nuint i = 0; i <= last; i++)
	{
		if (astringCompareUnits(&this.elements[i], match.elements, matchLength, caseInsensitive) == 0)
			return (nint)i;
	}
	return -1;
}

/// Finds the first matching ASCII character.
/// - match: Character to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint indexOf(const achar[] this, overload achar match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	achar normalized = caseInsensitive ? astringLowerUnit(match) : match;
	for (nuint i = 0; i < length; i++)
	{
		achar value = caseInsensitive ? astringLowerUnit(this.elements[i]) : this.elements[i];
		if (value == normalized)
			return (nint)i;
	}
	return -1;
}

/// Finds the first character contained in a set.
/// - match: Characters to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint indexOfAny(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	for (nuint i = 0; i < length; i++)
	{
		achar value = caseInsensitive ? astringLowerUnit(this.elements[i]) : this.elements[i];
		for (nuint j = 0; j < matchLength; j++)
		{
			achar candidate = caseInsensitive ? astringLowerUnit(match.elements[j]) : match.elements[j];
			if (value == candidate)
				return (nint)i;
		}
	}
	return -1;
}

/// Finds the last matching ASCII span.
/// - match: Text to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint lastIndexOf(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	if (matchLength == 0)
		return (nint)length;
	if (matchLength > length)
		return -1;

	nint result = -1;
	nuint last = length - matchLength;
	for (nuint i = 0; i <= last; i++)
	{
		if (astringCompareUnits(&this.elements[i], match.elements, matchLength, caseInsensitive) == 0)
			result = (nint)i;
	}
	return result;
}

/// Finds the last matching ASCII character.
/// - match: Character to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint lastIndexOf(const achar[] this, overload achar match, bool caseInsensitive = false)
{
	nint result = -1;
	nuint length = astringLogicalLength(this.elements, this.length);
	achar normalized = caseInsensitive ? astringLowerUnit(match) : match;
	for (nuint i = 0; i < length; i++)
	{
		achar value = caseInsensitive ? astringLowerUnit(this.elements[i]) : this.elements[i];
		if (value == normalized)
			result = (nint)i;
	}
	return result;
}

/// Finds the last character contained in a set.
/// - match: Characters to find.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public nint lastIndexOfAny(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nint result = -1;
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	for (nuint i = 0; i < length; i++)
	{
		achar value = caseInsensitive ? astringLowerUnit(this.elements[i]) : this.elements[i];
		for (nuint j = 0; j < matchLength; j++)
		{
			achar candidate = caseInsensitive ? astringLowerUnit(match.elements[j]) : match.elements[j];
			if (value == candidate)
				result = (nint)i;
		}
	}
	return result;
}

/// Returns true when the text starts with an ASCII span.
/// - match: Prefix to test.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public bool startsWith(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	if (matchLength > astringLogicalLength(this.elements, this.length))
		return false;
	return astringCompareUnits(this.elements, match.elements, matchLength, caseInsensitive) == 0;
}

/// Returns true when the text starts with an ASCII character.
/// - match: Prefix character to test.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public bool startsWith(const achar[] this, overload achar match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	if (length == 0)
		return false;
	achar value = caseInsensitive ? astringLowerUnit(this.elements[0]) : this.elements[0];
	achar normalized = caseInsensitive ? astringLowerUnit(match) : match;
	return value == normalized;
}

/// Returns true when the text ends with an ASCII span.
/// - match: Suffix to test.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public bool endsWith(const achar[] this, overload const achar[] match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint matchLength = astringLogicalLength(match.elements, match.length);
	if (matchLength > length)
		return false;
	return astringCompareUnits(&this.elements[length - matchLength], match.elements, matchLength, caseInsensitive) == 0;
}

/// Returns true when the text ends with an ASCII character.
/// - match: Suffix character to test.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
public bool endsWith(const achar[] this, overload achar match, bool caseInsensitive = false)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	if (length == 0)
		return false;
	achar value = caseInsensitive ? astringLowerUnit(this.elements[length - 1]) : this.elements[length - 1];
	achar normalized = caseInsensitive ? astringLowerUnit(match) : match;
	return value == normalized;
}

/// Compares two ASCII spans.
/// - other: Text to compare with.
/// - caseInsensitive: Uses ASCII case-insensitive comparison.
/// @returns `-1`, `0`, or `1` for less-than, equal, or greater-than.
public nint compareTo(const achar[] this, const achar[] other, bool caseInsensitive = false)
{
	nuint thisLength = astringLogicalLength(this.elements, this.length);
	nuint otherLength = astringLogicalLength(other.elements, other.length);
	nuint comparedLength = astringMin(thisLength, otherLength);
	nint comparison = astringCompareUnits(this.elements, other.elements, comparedLength, caseInsensitive);
	if (comparison < 0)
		return -1;
	if (comparison > 0)
		return 1;

	if (thisLength < otherLength)
		return -1;
	if (thisLength > otherLength)
		return 1;
	return 0;
}

/// Returns a view with leading and trailing ASCII whitespace removed.
public scoped const achar[] trim(const achar[] this)
{
	nuint start = astringTrimStartIndex(this.elements, this.length);
	nuint end = astringTrimEndIndex(this.elements, this.length, start);
	return { &this.elements[start], end - start };
}

/// Returns a view with leading ASCII whitespace removed.
public scoped const achar[] trimStart(const achar[] this)
{
	nuint start = astringTrimStartIndex(this.elements, this.length);
	return { &this.elements[start], astringLogicalLength(this.elements, this.length) - start };
}

/// Returns a view with trailing ASCII whitespace removed.
public scoped const achar[] trimEnd(const achar[] this)
{
	nuint end = astringTrimEndIndex(this.elements, this.length, 0);
	return { this.elements, end };
}

/// Copies the text to uppercase ASCII text.
public prep achar[] toUppercase(const achar[] this)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint count = astringMin(length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = astringUpperUnit(this[i]);
	return length;
}

/// Copies the text to lowercase ASCII text.
public prep achar[] toLowercase(const achar[] this)
{
	nuint length = astringLogicalLength(this.elements, this.length);
	nuint count = astringMin(length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = astringLowerUnit(this[i]);
	return length;
}

/// Joins ASCII strings with an optional separator.
/// - separator: Text written between values. The default writes no separator.
public prep achar[] join(astring[] this, const achar[] separator = default)
{
	nuint length = 0;
	nuint separatorLength = astringLogicalLength(separator.elements, separator.length);
	for (nuint i = 0; i < this.length; i++)
	{
		length += this[i].Length;
		if (i > 0)
			length += separatorLength;
	}

	if (buffer.length < length)
		return length;

	nuint offset = 0;
	for (nuint j = 0; j < this.length; j++)
	{
		if (j > 0)
			offset = astringWriteSpan(buffer, offset, separator);
		const achar[] value = { (const achar*)this[j], this[j].Length };
		offset = astringWriteSpan(buffer, offset, value);
	}
	return length;
}

public nuint getLength(astring this)
{
	nuint length = 0;
	while (this[length] != (achar)0)
		length++;
	return length;
}

bool astringIsAsciiWhitespace(achar value)
{
	return value == (achar)' '
		|| value == (achar)'\t'
		|| value == (achar)'\n'
		|| value == (achar)'\r'
		|| value == (achar)'\v'
		|| value == (achar)'\f';
}

bool astringIsAsciiUpper(achar value)
{
	return value >= (achar)'A' && value <= (achar)'Z';
}

bool astringIsAsciiLower(achar value)
{
	return value >= (achar)'a' && value <= (achar)'z';
}

achar astringLowerUnit(achar value)
{
	if (astringIsAsciiUpper(value))
		return (achar)(value + ((achar)'a' - (achar)'A'));
	return value;
}

achar astringUpperUnit(achar value)
{
	if (astringIsAsciiLower(value))
		return (achar)(value - ((achar)'a' - (achar)'A'));
	return value;
}

nint astringCompareUnits(const achar* left, const achar* right, nuint length, bool caseInsensitive)
{
	for (nuint i = 0; i < length; i++)
	{
		achar leftUnit = caseInsensitive ? astringLowerUnit(left[i]) : left[i];
		achar rightUnit = caseInsensitive ? astringLowerUnit(right[i]) : right[i];
		if (leftUnit < rightUnit)
			return -1;
		if (leftUnit > rightUnit)
			return 1;
		if (leftUnit == (achar)0)
			return 0;
	}
	return 0;
}

nuint astringTrimStartIndex(const achar* value, nuint valueLength)
{
	nuint length = astringLogicalLength(value, valueLength);
	nuint start = 0;
	while (start < length && astringIsAsciiWhitespace(value[start]))
		start++;
	return start;
}

nuint astringTrimEndIndex(const achar* value, nuint valueLength, nuint start)
{
	nuint end = astringLogicalLength(value, valueLength);
	while (end > start && astringIsAsciiWhitespace(value[end - 1]))
		end--;
	return end;
}

nuint astringLogicalLength(const achar* value, nuint valueLength)
{
	nuint length = 0;
	while (length < valueLength && value[length] != (achar)0)
		length++;
	return length;
}

nuint astringMin(nuint left, nuint right)
{
	return left < right ? left : right;
}

nuint astringWriteSpan(achar[] buffer, nuint offset, const achar[] span)
{
	nuint length = astringLogicalLength(span.elements, span.length);
	for (nuint i = 0; i < length; i++)
		buffer[offset + i] = span[i];
	return offset + length;
}
