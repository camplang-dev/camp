namespace Std;

@category("Text");

@symbol("utf16ncmp")
extern nint utf16ncmp(const wchar* src1, const wchar* src2, nuint len);
@symbol("utf16ncasecmp")
extern nint utf16ncasecmp(const wchar* src1, const wchar* src2, nuint len);
@symbol("camp_utf16nlen")
extern nuint camp_utf16nlen(const wchar* src, nuint len);
@symbol("camp_utf16size_lazy")
extern nuint camp_utf16size_lazy(const wchar* src);
@symbol("camp_utf16nsize_lazy")
extern nuint camp_utf16nsize_lazy(const wchar* src, nuint len);
@symbol("utf16codepoint")
extern const wchar* utf16codepoint(const wchar* src, out uchar codepoint);
@symbol("utf16codepointcalcsize")
extern nuint utf16codepointcalcsize(const wchar* src);
@symbol("utf16lwrcodepoint")
extern uchar utf16lwrcodepoint(uchar codepoint);
@symbol("utf16uprcodepoint")
extern uchar utf16uprcodepoint(uchar codepoint);

@symbol("camp_utf16nstr")
extern const wchar* camp_utf16nstr(const wchar* haystack, nuint haystackLen, const wchar* needle, nuint needleLen);
@symbol("camp_utf16ncasestr")
extern const wchar* camp_utf16ncasestr(const wchar* haystack, nuint haystackLen, const wchar* needle, nuint needleLen);
@symbol("camp_utf16nchr")
extern const wchar* camp_utf16nchr(const wchar* text, nuint len, uchar codepoint, int caseInsensitive);
@symbol("camp_utf16nrchr")
extern const wchar* camp_utf16nrchr(const wchar* text, nuint len, uchar codepoint, int caseInsensitive);
@symbol("camp_utf16npbrk_codepoints")
extern const wchar* camp_utf16npbrk_codepoints(const wchar* text, nuint len, const uchar* codepoints, nuint codepointCount, int caseInsensitive);
@symbol("camp_utf16nrpbrk_codepoints")
extern const wchar* camp_utf16nrpbrk_codepoints(const wchar* text, nuint len, const uchar* codepoints, nuint codepointCount, int caseInsensitive);

/// Finds the first matching UTF-16 span.
/// - match: Text to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint indexOf(const wchar[] this, overload const wchar[] match, bool caseInsensitive = false)
{
	const wchar* found = caseInsensitive
		? camp_utf16ncasestr(this.elements, this.length, match.elements, match.length)
		: camp_utf16nstr(this.elements, this.length, match.elements, match.length);
	if (found == null)
		return -1;
	return wstringOffsetOf(this.elements, found);
}

/// Finds the first matching Unicode scalar value.
/// - match: Scalar value to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint indexOf(const wchar[] this, overload uchar match, bool caseInsensitive = false)
{
	const wchar* found = camp_utf16nchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return wstringOffsetOf(this.elements, found);
}

/// Finds the first scalar value contained in a set.
/// - match: Scalar values to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint indexOfAny(const wchar[] this, overload const uchar[] match, bool caseInsensitive = false)
{
	const wchar* found = camp_utf16npbrk_codepoints(this.elements, this.length, match.elements, match.length, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return wstringOffsetOf(this.elements, found);
}

/// Finds the last matching UTF-16 span.
/// - match: Text to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint lastIndexOf(const wchar[] this, overload const wchar[] match, bool caseInsensitive = false)
{
	nuint logical = wstringLogicalLength(this.elements, this.length);
	if (match.length == 0)
		return (nint)logical;
	if (match.length > logical)
		return -1;

	nint result = -1;
	nuint last = logical - match.length;
	for (nuint i = 0; i <= last; i++)
	{
		nint comparison = caseInsensitive
			? utf16ncasecmp(&this.elements[i], match.elements, match.length)
			: utf16ncmp(&this.elements[i], match.elements, match.length);
		if (comparison == 0)
			result = (nint)i;
	}
	return result;
}

/// Finds the last matching Unicode scalar value.
/// - match: Scalar value to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint lastIndexOf(const wchar[] this, overload uchar match, bool caseInsensitive = false)
{
	const wchar* found = camp_utf16nrchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return wstringOffsetOf(this.elements, found);
}

/// Finds the last scalar value contained in a set.
/// - match: Scalar values to find.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public nint lastIndexOfAny(const wchar[] this, overload const uchar[] match, bool caseInsensitive = false)
{
	const wchar* found = camp_utf16nrpbrk_codepoints(this.elements, this.length, match.elements, match.length, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return wstringOffsetOf(this.elements, found);
}

/// Returns true when the text starts with a UTF-16 span.
/// - match: Prefix to test.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public bool startsWith(const wchar[] this, overload const wchar[] match, bool caseInsensitive = false)
{
	if (match.length > wstringLogicalLength(this.elements, this.length))
		return false;
	return (caseInsensitive ? utf16ncasecmp(this.elements, match.elements, match.length) : utf16ncmp(this.elements, match.elements, match.length)) == 0;
}

/// Returns true when the text starts with a scalar value.
/// - match: Prefix scalar to test.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public bool startsWith(const wchar[] this, overload uchar match, bool caseInsensitive = false)
{
	return camp_utf16nchr(this.elements, this.length, match, caseInsensitive ? 1 : 0) == this.elements;
}

/// Returns true when the text ends with a UTF-16 span.
/// - match: Suffix to test.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public bool endsWith(const wchar[] this, overload const wchar[] match, bool caseInsensitive = false)
{
	nuint length = wstringLogicalLength(this.elements, this.length);
	if (match.length > length)
		return false;
	return (caseInsensitive ? utf16ncasecmp(&this.elements[length - match.length], match.elements, match.length) : utf16ncmp(&this.elements[length - match.length], match.elements, match.length)) == 0;
}

/// Returns true when the text ends with a scalar value.
/// - match: Suffix scalar to test.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
public bool endsWith(const wchar[] this, overload uchar match, bool caseInsensitive = false)
{
	const wchar* found = camp_utf16nrchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return false;
	nuint index = (nuint)wstringOffsetOf(this.elements, found);
	return index + utf16codepointcalcsize(found) == wstringLogicalLength(this.elements, this.length);
}

/// Compares two UTF-16 spans.
/// - other: Text to compare with.
/// - caseInsensitive: Uses the UTF-16 helper's case-insensitive comparison.
/// @returns `-1`, `0`, or `1` for less-than, equal, or greater-than.
public nint compareTo(const wchar[] this, const wchar[] other, bool caseInsensitive = false)
{
	nuint thisLength = wstringLogicalLength(this.elements, this.length);
	nuint otherLength = wstringLogicalLength(other.elements, other.length);
	nuint comparedLength = wstringMin(thisLength, otherLength);
	nint comparison = caseInsensitive
		? utf16ncasecmp(this.elements, other.elements, comparedLength)
		: utf16ncmp(this.elements, other.elements, comparedLength);
	if (comparison < 0)
		return -1;
	if (comparison > 0)
		return 1;

	if (thisLength < otherLength)
		return -1;
	if (thisLength > otherLength)
		return 1;
	return 0;
}

/// Counts Unicode scalar values in UTF-16 text.
public nuint countUChars(const wchar[] this)
{
	return camp_utf16nlen(this.elements, this.length);
}

/// Gets the Unicode scalar value at a UTF-16 code-unit index.
/// - unit: UTF-16 code-unit index.
public uchar getUChar(const wchar[] this, @index nuint unit)
{
	uchar codepoint = 0;
	if (unit >= wstringLogicalLength(this.elements, this.length))
		return 0;
	utf16codepoint(&this.elements[unit], out codepoint);
	return codepoint;
}

/// Gets the number of UTF-16 code units used by the scalar at an index.
/// - unit: UTF-16 code-unit index.
public nuint getUCharUnits(const wchar[] this, @index nuint unit)
{
	if (unit >= wstringLogicalLength(this.elements, this.length))
		return 0;
	return utf16codepointcalcsize(&this.elements[unit]);
}

/// Returns a view with leading and trailing ASCII whitespace removed.
public scoped const wchar[] trim(const wchar[] this)
{
	nuint start = wstringTrimStartIndex(this.elements, this.length);
	nuint end = wstringTrimEndIndex(this.elements, this.length, start);
	return { &this.elements[start], end - start };
}

/// Returns a view with leading ASCII whitespace removed.
public scoped const wchar[] trimStart(const wchar[] this)
{
	nuint start = wstringTrimStartIndex(this.elements, this.length);
	return { &this.elements[start], wstringLogicalLength(this.elements, this.length) - start };
}

/// Returns a view with trailing ASCII whitespace removed.
public scoped const wchar[] trimEnd(const wchar[] this)
{
	nuint end = wstringTrimEndIndex(this.elements, this.length, 0);
	return { this.elements, end };
}

/// Copies the text to uppercase UTF-16 text.
public prep wchar[] toUppercase(const wchar[] this)
{
	return wstringTransformCodepoints(this, true, buffer);
}

/// Copies the text to lowercase UTF-16 text.
public prep wchar[] toLowercase(const wchar[] this)
{
	return wstringTransformCodepoints(this, false, buffer);
}

/// Joins UTF-16 strings with an optional separator.
/// - separator: Text written between values. The default writes no separator.
public prep wchar[] join(wstring[] this, const wchar[] separator = default)
{
	nuint length = 0;
	nuint separatorLength = wstringLogicalLength(separator.elements, separator.length);
	for (nuint i = 0; i < this.length; i++)
	{
		length += this[i].Length;
		if (i > 0)
			length += separatorLength;
	}

	if (buffer.length < length)
		return length;

	nuint offset = 0;
	for (nuint j = 0; j < this.length; j++)
	{
		if (j > 0)
			offset = wstringWriteSpan(buffer, offset, separator);
		const wchar[] value = { (const wchar*)this[j], this[j].Length };
		offset = wstringWriteSpan(buffer, offset, value);
	}
	return length;
}

public nuint getLength(wstring this)
{
	return camp_utf16size_lazy(this);
}

nint wstringOffsetOf(const wchar* start, const wchar* target)
{
	nuint offset = 0;
	while (&start[offset] != target)
		offset++;
	return (nint)offset;
}

bool wstringIsAsciiWhitespace(wchar value)
{
	return value == (wchar)' '
		|| value == (wchar)'\t'
		|| value == (wchar)'\n'
		|| value == (wchar)'\r'
		|| value == (wchar)'\v'
		|| value == (wchar)'\f';
}

nuint wstringTrimStartIndex(const wchar* value, nuint valueLength)
{
	nuint length = wstringLogicalLength(value, valueLength);
	nuint start = 0;
	while (start < length && wstringIsAsciiWhitespace(value[start]))
		start++;
	return start;
}

nuint wstringTrimEndIndex(const wchar* value, nuint valueLength, nuint start)
{
	nuint end = wstringLogicalLength(value, valueLength);
	while (end > start && wstringIsAsciiWhitespace(value[end - 1]))
		end--;
	return end;
}

nuint wstringLogicalLength(const wchar* value, nuint valueLength)
{
	return camp_utf16nsize_lazy(value, valueLength);
}

nuint wstringMin(nuint left, nuint right)
{
	return left < right ? left : right;
}

nuint wstringTransformCodepoints(const wchar[] text, bool uppercase, wchar[] buffer)
{
	nuint inputLength = wstringLogicalLength(text.elements, text.length);
	nuint required = wstringTransformedCodepointLength(text.elements, inputLength, uppercase);
	if (buffer.length < required)
		return required;

	nuint input = 0;
	nuint output = 0;
	while (input < inputLength)
	{
		uchar codepoint = 0;
		utf16codepoint(&text.elements[input], out codepoint);
		uchar transformed = uppercase ? utf16uprcodepoint(codepoint) : utf16lwrcodepoint(codepoint);
		output = wstringWriteCodepoint(buffer.elements, output, transformed);
		input += utf16codepointcalcsize(&text.elements[input]);
	}
	return required;
}

nuint wstringTransformedCodepointLength(const wchar* text, nuint textLength, bool uppercase)
{
	nuint input = 0;
	nuint length = 0;
	while (input < textLength)
	{
		uchar codepoint = 0;
		utf16codepoint(&text[input], out codepoint);
		uchar transformed = uppercase ? utf16uprcodepoint(codepoint) : utf16lwrcodepoint(codepoint);
		length += transformed < 0x10000 ? 1 : 2;
		input += utf16codepointcalcsize(&text[input]);
	}
	return length;
}

nuint wstringWriteCodepoint(wchar* output, nuint index, uchar codepoint)
{
	if (codepoint < 0x10000)
	{
		output[index] = (wchar)codepoint;
		return index + 1;
	}

	uchar adjusted = (uchar)(codepoint - 0x10000);
	output[index] = (wchar)(0xD800 | (adjusted >> 10));
	output[index + 1] = (wchar)(0xDC00 | (adjusted & 0x3FF));
	return index + 2;
}

nuint wstringWriteSpan(wchar[] buffer, nuint offset, const wchar[] span)
{
	nuint length = wstringLogicalLength(span.elements, span.length);
	for (nuint i = 0; i < length; i++)
		buffer[offset + i] = span[i];
	return offset + length;
}
