public newtype delegate nuint CharFormatter(const this, char[] buffer = default);

public escaped string copyString(CharFormatter this, within allocator)
{
	auto size = this();
	auto buf = new char[size + 1];
	char[] text = { buf.elements, size };
	this(text);
	buf[size] = '\0';
	return (string)buf.elements;
}

public nuint format(in char this, overload char[] buffer) : CharFormatter
{
	if (buffer.length > 0)
		buffer[0] = this;
	return 1;
}

public nuint format(const char[] this, overload char[] buffer) : CharFormatter
{
	nuint length = 0;
	while (length < this.length && this[length] != '\0')
		length++;

	nuint count = min(length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return length;
}

public nuint format(in string this, overload char[] buffer) : CharFormatter
{
	const char[] text = { (const char*)this, this.Length };
	return text.format(buffer);
}

public nuint format(in bool this, overload char[] buffer) : CharFormatter
{
	if (this)
	{
		copyFormatterText("true", buffer);
		return 4;
	}
	else
	{
		copyFormatterText("false", buffer);
		return 5;
	}
}

public nuint format(in byte   this, overload char[] buffer) : CharFormatter => applyFormat((long)this, false, buffer);
public nuint format(in sbyte  this, overload char[] buffer) : CharFormatter => applyFormat(abs((int)this), this < 0, buffer);
public nuint format(in ushort this, overload char[] buffer) : CharFormatter => applyFormat((long)this, false, buffer);
public nuint format(in short  this, overload char[] buffer) : CharFormatter => applyFormat(abs((int)this), this < 0, buffer);
public nuint format(in uint   this, overload char[] buffer) : CharFormatter => applyFormat((long)this, false, buffer);
public nuint format(in int    this, overload char[] buffer) : CharFormatter => applyFormat(abs((long)this), this < 0, buffer);
public nuint format(in nuint  this, overload char[] buffer) : CharFormatter => applyFormat((long)this, false, buffer);
public nuint format(in nint   this, overload char[] buffer) : CharFormatter => applyFormat(abs((long)this), this < 0, buffer);
public nuint format(in ulong  this, overload char[] buffer) : CharFormatter => applyFormat(this, false, buffer);

public nuint format(in long   this, overload char[] buffer) : CharFormatter
{
	if (this == (-9223372036854775807 - 1))
	{
		copyFormatterText("-9223372036854775808", buffer);
		return 20;
	}
	
	ulong value = (this < 0) ? (ulong)-this : (ulong)this;

	return applyFormat(value, this < 0, buffer);
}

nuint applyFormat(ulong value, bool sign, char[] buffer)
{
	nuint digits = decimalDigits(value);
	nuint required = digits + (sign ? 1 : 0);
	fixed char[21] scratch = default;
	char[] text = scratch;
	nuint index = 0;
	if (sign)
	{
		text[0] = '-';
		index = 1;
	}

	nuint end = index + digits;
	for (nuint i = 0; i < digits; i++)
	{
		text[end - 1 - i] = (char)((int)'0' + (int)(value % 10));
		value /= 10;
	}

	nuint count = min(required, buffer.length);
	for (nuint j = 0; j < count; j++)
		buffer[j] = text[j];
	return required;
}

void copyFormatterText(const char[] text, char[] buffer)
{
	nuint count = min(text.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = text[i];
}

nuint decimalDigits(ulong n)
{
    if (n >= 10000000000) { // 11 to 20 digits
        if (n >= 1000000000000000) { // 16 to 20 digits
            if (n >= 100000000000000000) { // 18 to 20 digits
                if (n >= 1000000000000000000) { // 19 or 20 digits
                    return (n >= 10000000000000000000) ? 20 : 19;
                } else {
                    return 18;
                }
            } else { // 16 or 17 digits
                return (n >= 10000000000000000) ? 17 : 16;
            }
        } else { // 11 to 15 digits
            if (n >= 1000000000000) { // 13 to 15 digits
                if (n >= 10000000000000) { // 14 or 15 digits
                    return (n >= 100000000000000) ? 15 : 14;
                } else {
                    return 13;
                }
            } else { // 11 or 12 digits
                return (n >= 100000000000) ? 12 : 11;
            }
        }
    } else { // 1 to 10 digits
        if (n >= 100000) { // 6 to 10 digits
            if (n >= 100000000) { // 9 or 10 digits
                return (n >= 1000000000) ? 10 : 9;
            } else { // 6 to 8 digits
                if (n >= 10000000) { // 8 digits
                    return 8;
                } else {
                    return (n >= 1000000) ? 7 : 6;
                }
            }
        } else { // 1 to 5 digits
            if (n >= 100) { // 3 to 5 digits
                if (n >= 1000) { // 4 or 5 digits
                    return (n >= 10000) ? 5 : 4;
                } else {
                    return 3;
                }
            } else { // 1 or 2 digits
                return (n >= 10) ? 2 : 1;
            }
        }
    }
}
