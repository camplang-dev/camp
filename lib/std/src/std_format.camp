namespace Std;

@category("Text");

public prep char[] toString(in char this)
{
	if (buffer.length > 0)
		buffer[0] = this;
	return 1;
}

public prep char[] toString(in achar this)
{
	if (buffer.length > 0)
		buffer[0] = (char)this;
	return 1;
}

public prep char[] toString(in wchar this)
{
	uchar codepoint = normalizeScalar((uchar)this);
	nuint length = formatUtf8LengthOf(codepoint);
	if (buffer.length >= length)
		formatWriteUtf8(buffer.elements, 0, codepoint);
	return length;
}

public prep char[] toString(in uchar this)
{
	uchar codepoint = normalizeScalar(this);
	nuint length = formatUtf8LengthOf(codepoint);
	if (buffer.length >= length)
		formatWriteUtf8(buffer.elements, 0, codepoint);
	return length;
}

public prep char[] toString(const char[] this)
{
	nuint length = 0;
	while (length < this.length && this[length] != '\0')
		length++;

	nuint count = min(length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = this[i];
	return length;
}

public prep char[] toString(in string this)
{
	const char[] text = { (const char*)this, this.Length };
	return text.toString(buffer);
}

public prep char[] toString(in bool this)
{
	if (this)
	{
		copyFormatterText("true", buffer);
		return 4;
	}
	else
	{
		copyFormatterText("false", buffer);
		return 5;
	}
}

uchar normalizeScalar(uchar value)
{
	if (value > uchar.MAX)
		return (uchar)0xFFFD;
	if (value >= 0xD800 && value <= 0xDFFF)
		return (uchar)0xFFFD;
	return value;
}

nuint formatUtf8LengthOf(uchar codepoint)
{
	if (codepoint < 0x80)
		return 1;
	if (codepoint < 0x800)
		return 2;
	if (codepoint < 0x10000)
		return 3;
	return 4;
}

nuint formatWriteUtf8(char* output, nuint index, uchar codepoint)
{
	if (codepoint < 0x80)
	{
		output[index] = (char)codepoint;
		return index + 1;
	}

	if (codepoint < 0x800)
	{
		output[index] = (char)(0xC0 | (codepoint >> 6));
		output[index + 1] = (char)(0x80 | (codepoint & 0x3F));
		return index + 2;
	}

	if (codepoint < 0x10000)
	{
		output[index] = (char)(0xE0 | (codepoint >> 12));
		output[index + 1] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
		output[index + 2] = (char)(0x80 | (codepoint & 0x3F));
		return index + 3;
	}

	output[index] = (char)(0xF0 | (codepoint >> 18));
	output[index + 1] = (char)(0x80 | ((codepoint >> 12) & 0x3F));
	output[index + 2] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
	output[index + 3] = (char)(0x80 | (codepoint & 0x3F));
	return index + 4;
}

public prep char[] toString(in byte   this) => applyFormat((long)this, false, buffer);
public prep char[] toString(in sbyte  this) => applyFormat(abs((int)this), this < 0, buffer);
public prep char[] toString(in ushort this) => applyFormat((long)this, false, buffer);
public prep char[] toString(in short  this) => applyFormat(abs((int)this), this < 0, buffer);
public prep char[] toString(in uint   this) => applyFormat((long)this, false, buffer);
public prep char[] toString(in int    this) => applyFormat(abs((long)this), this < 0, buffer);
public prep char[] toString(in nuint  this) => applyFormat((long)this, false, buffer);
public prep char[] toString(in nint   this) => applyFormat(abs((long)this), this < 0, buffer);
public prep char[] toString(in ulong  this) => applyFormat(this, false, buffer);

public prep char[] toString(in long   this)
{
	if (this == (-9223372036854775807 - 1))
	{
		copyFormatterText("-9223372036854775808", buffer);
		return 20;
	}
	
	ulong value = (this < 0) ? (ulong)-this : (ulong)this;

	return applyFormat(value, this < 0, buffer);
}

nuint applyFormat(ulong value, bool sign, char[] buffer)
{
	nuint digits = decimalDigits(value);
	nuint required = digits + (sign ? 1 : 0);
	fixed char[21] scratch = default;
	char[] text = scratch;
	nuint index = 0;
	if (sign)
	{
		text[0] = '-';
		index = 1;
	}

	nuint end = index + digits;
	for (nuint i = 0; i < digits; i++)
	{
		text[end - 1 - i] = (char)((int)'0' + (int)(value % 10));
		value /= 10;
	}

	nuint count = min(required, buffer.length);
	for (nuint j = 0; j < count; j++)
		buffer[j] = text[j];
	return required;
}

void copyFormatterText(const char[] text, char[] buffer)
{
	nuint count = min(text.length, buffer.length);
	for (nuint i = 0; i < count; i++)
		buffer[i] = text[i];
}

nuint decimalDigits(ulong n)
{
    if (n >= 10000000000) { // 11 to 20 digits
        if (n >= 1000000000000000) { // 16 to 20 digits
            if (n >= 100000000000000000) { // 18 to 20 digits
                if (n >= 1000000000000000000) { // 19 or 20 digits
                    return (n >= 10000000000000000000) ? 20 : 19;
                } else {
                    return 18;
                }
            } else { // 16 or 17 digits
                return (n >= 10000000000000000) ? 17 : 16;
            }
        } else { // 11 to 15 digits
            if (n >= 1000000000000) { // 13 to 15 digits
                if (n >= 10000000000000) { // 14 or 15 digits
                    return (n >= 100000000000000) ? 15 : 14;
                } else {
                    return 13;
                }
            } else { // 11 or 12 digits
                return (n >= 100000000000) ? 12 : 11;
            }
        }
    } else { // 1 to 10 digits
        if (n >= 100000) { // 6 to 10 digits
            if (n >= 100000000) { // 9 or 10 digits
                return (n >= 1000000000) ? 10 : 9;
            } else { // 6 to 8 digits
                if (n >= 10000000) { // 8 digits
                    return 8;
                } else {
                    return (n >= 1000000) ? 7 : 6;
                }
            }
        } else { // 1 to 5 digits
            if (n >= 100) { // 3 to 5 digits
                if (n >= 1000) { // 4 or 5 digits
                    return (n >= 10000) ? 5 : 4;
                } else {
                    return 3;
                }
            } else { // 1 or 2 digits
                return (n >= 10) ? 2 : 1;
            }
        }
    }
}
