namespace Std;

public class Console
{
	public static CharReader getReader()
	{
		return { Console_readFd, (void*)camp_io_stdin() };
	}
	
	public static CharWriter getWriter()
	{
		return { Console_writeFd, (void*)camp_io_stdout() };
	}
	
	public static CharWriter getError()
	{
		return { Console_writeFd, (void*)camp_io_stderr() };
	}
	
	static bool writeFd(void* context, nuint* written, char* buffer, nuint buffer_length)
	{
		IoError error = default;
		nint result = camp_io_file_write((nint)context, (const void*)buffer, buffer_length, out error);
		if (result < 0)
			return false;
		*written = (nuint)result;
		return true;
	}

	static bool readFd(void* context, nuint* readCount, char* buffer, nuint buffer_length)
	{
		IoError error = default;
		nint result = camp_io_file_read((nint)context, (void*)buffer, buffer_length, out error);
		if (result < 0)
			return false;
		*readCount = (nuint)result;
		return true;
	}
	
	// public static AsyncCharReader getAsyncReader();
	// public static AsyncCharWriter getAsyncWriter();
	// public static AsyncCharWriter getAsyncError();
	
	public static void write(overload char   value)
	{
		auto buf = [value];
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), buf.elements, buf.length, out error);
	}
	
	public static void write(overload const char [] value)
	{
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), value.elements, value.length, out error);
	}
	
	public static void write(overload string value)
	{
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), (const void*)(void*)value, value.Length, out error);
	}
	
	public static void write(overload bool   value) => Console.write(prep value.format());
	public static void write(overload byte   value) => Console.write(prep value.format());
	public static void write(overload sbyte  value) => Console.write(prep value.format());
	public static void write(overload ushort value) => Console.write(prep value.format());
	public static void write(overload short  value) => Console.write(prep value.format());
	public static void write(overload uint   value) => Console.write(prep value.format());
	public static void write(overload int    value) => Console.write(prep value.format());
	public static void write(overload ulong  value) => Console.write(prep value.format());
	public static void write(overload long   value) => Console.write(prep value.format());
	public static void write(overload nuint  value) => Console.write(prep value.format());
	public static void write(overload nint   value) => Console.write(prep value.format());
	
	public static void writeLine(overload char   value)
	{
		auto buf = [value, '\n'];
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), buf.elements, buf.length, out error);
	}
	
	public static void writeLine(overload const char [] value)
	{
		Console.write(value);
		Console.write('\n');
	}
	
	public static void writeLine(overload string value)
	{
		Console.write(value);
		Console.write('\n');
	}
	
	public static void writeLine(overload bool   value) => Console.writeLine(prep value.format());
	public static void writeLine(overload byte   value) => Console.writeLine(prep value.format());
	public static void writeLine(overload sbyte  value) => Console.writeLine(prep value.format());
	public static void writeLine(overload ushort value) => Console.writeLine(prep value.format());
	public static void writeLine(overload short  value) => Console.writeLine(prep value.format());
	public static void writeLine(overload uint   value) => Console.writeLine(prep value.format());
	public static void writeLine(overload int    value) => Console.writeLine(prep value.format());
	public static void writeLine(overload ulong  value) => Console.writeLine(prep value.format());
	public static void writeLine(overload long   value) => Console.writeLine(prep value.format());
	public static void writeLine(overload nuint  value) => Console.writeLine(prep value.format());
	public static void writeLine(overload nint   value) => Console.writeLine(prep value.format());
	
	public static void newLine() => Console.write('\n');
	
	public static char readChar() => Console.Reader.readChar(catch _);
	
	public static escaped string readLine(within allocator) => Console.Reader.readLine(within allocator, catch _);
}
