export as Std;

extern int putchar(int ch);

export class Console
{
	export static void writeString(const char[] value)
	{
		for (nuint i = 0; i < value.length; i++)
			Console.writeChar(value[i]);
	}
	
	export static void writeLine(const char[] value = default)
	{
		Console.writeString(value);
		Console.writeChar('\n');
	}
	
	export static void writeBool(bool value)
	{
		if (value)
			Console.writeString("true");
		else
			Console.writeString("false");
	}
	
	export static void writeChar(char value)
	{
		putchar((int)value);
	}
	
	export static void writeInt(int value)
	{
		if (value < 0)
		{
			Console.writeChar('-');
			Console.writeUInt((uint)(0 - value));
		}
		else
		{
			Console.writeUInt((uint)value);
		}
	}
	
	export static void writeUInt(uint value)
	{
		if (value >= 10)
			Console.writeUInt(value / 10);
		Console.writeChar((char)((int)'0' + (int)(value % 10)));
	}
	
	export static void writeDouble(double value)
	{
		if (value < 0.0)
		{
			Console.writeChar('-');
			value = 0.0 - value;
		}
		
		uint integerPart = (uint)value;
		Console.writeUInt(integerPart);
		Console.writeChar('.');
		
		double fraction = value - (double)integerPart;
		for (int i = 0; i < 6; i++)
		{
			fraction *= 10.0;
			uint digit = (uint)fraction;
			Console.writeChar((char)((int)'0' + (int)digit));
			fraction -= (double)digit;
		}
	}
}
