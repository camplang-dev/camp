namespace Std;

export class Console
{
	export static CharReader getReader()
	{
		return { Console_readFd, (void*)camp_io_stdin() };
	}
	
	export static CharWriter getWriter()
	{
		return { Console_writeFd, (void*)camp_io_stdout() };
	}
	
	export static CharWriter getError()
	{
		return { Console_writeFd, (void*)camp_io_stderr() };
	}
	
	static bool writeFd(void* context, nuint* written, char* buffer, nuint buffer_length)
	{
		IoError error = default;
		nint result = camp_io_file_write((nint)context, (const void*)buffer, buffer_length, out error);
		if (result < 0)
			return false;
		*written = (nuint)result;
		return true;
	}

	static bool readFd(void* context, nuint* readCount, char* buffer, nuint buffer_length)
	{
		IoError error = default;
		nint result = camp_io_file_read((nint)context, (void*)buffer, buffer_length, out error);
		if (result < 0)
			return false;
		*readCount = (nuint)result;
		return true;
	}
	
	// export static AsyncCharReader getAsyncReader();
	// export static AsyncCharWriter getAsyncWriter();
	// export static AsyncCharWriter getAsyncError();
	
	export static void write(overload CharFormatter value)
	{
		auto size = value();
		auto buf = init char[size];
		value(buf);
		if (size > 0)
		{
			IoError error = default;
			camp_io_file_write(camp_io_stdout(), buf.elements, size - 1, out error);
		}
	}
	
	export static void write(overload char   value)
	{
		auto buf = [value];
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), buf.elements, buf.length, out error);
	}
	
	export static void write(overload const char [] value)
	{
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), value.elements, value.length, out error);
	}
	
	export static void write(overload string value)
	{
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), (const void*)(void*)value, value.Length, out error);
	}
	
	export static void write(overload bool   value) => Console.write(value.format);
	export static void write(overload byte   value) => Console.write(value.format);
	export static void write(overload sbyte  value) => Console.write(value.format);
	export static void write(overload ushort value) => Console.write(value.format);
	export static void write(overload short  value) => Console.write(value.format);
	export static void write(overload uint   value) => Console.write(value.format);
	export static void write(overload int    value) => Console.write(value.format);
	export static void write(overload ulong  value) => Console.write(value.format);
	export static void write(overload long   value) => Console.write(value.format);
	export static void write(overload nuint  value) => Console.write(value.format);
	export static void write(overload nint   value) => Console.write(value.format);
	
	export static void writeLine(overload CharFormatter value)
	{
		auto size = value();
		auto buf = init char[size + 1];
		value(buf);
		buf[buf.length - 2] = '\n';
		buf[buf.length - 1] = '\0';
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), buf.elements, size, out error);
	}
	
	export static void writeLine(overload char   value)
	{
		auto buf = [value, '\n'];
		IoError error = default;
		camp_io_file_write(camp_io_stdout(), buf.elements, buf.length, out error);
	}
	
	export static void writeLine(overload const char [] value)
	{
		Console.write(value);
		Console.write('\n');
	}
	
	export static void writeLine(overload string value)
	{
		Console.write(value);
		Console.write('\n');
	}
	
	export static void writeLine(overload bool   value) => Console.writeLine(value.format);
	export static void writeLine(overload byte   value) => Console.writeLine(value.format);
	export static void writeLine(overload sbyte  value) => Console.writeLine(value.format);
	export static void writeLine(overload ushort value) => Console.writeLine(value.format);
	export static void writeLine(overload short  value) => Console.writeLine(value.format);
	export static void writeLine(overload uint   value) => Console.writeLine(value.format);
	export static void writeLine(overload int    value) => Console.writeLine(value.format);
	export static void writeLine(overload ulong  value) => Console.writeLine(value.format);
	export static void writeLine(overload long   value) => Console.writeLine(value.format);
	export static void writeLine(overload nuint  value) => Console.writeLine(value.format);
	export static void writeLine(overload nint   value) => Console.writeLine(value.format);
	
	export static void newLine() => Console.write('\n');
	
	export static char readChar() => Console.Reader.readChar(catch _);
	
	export static escaped string readLine(within allocator) => Console.Reader.readLine(within allocator, catch _);
}
