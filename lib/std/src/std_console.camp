export as Std;

bool Console_writeFd(void* context, nuint* written, char* buffer, nuint buffer_length)
{
	int fd = (int)(nint)context;
	nint result = posixWrite(fd, (const void*)buffer, buffer_length);
	if (result < 0)
		return false;
	*written = (nuint)result;
	return true;
}

bool Console_readFd(void* context, nuint* readCount, char* buffer, nuint buffer_length)
{
	int fd = context == null ? 0 : (int)(nint)context;
	nint result = posixRead(fd, (void*)buffer, buffer_length);
	if (result < 0)
		return false;
	*readCount = (nuint)result;
	return true;
}

export class Console
{
	export static CharReader getReader()
	{
		return { Console_readFd, null };
	}
	
	export static CharWriter getWriter()
	{
		return { Console_writeFd, (void*)(nint)1 };
	}
	
	export static CharWriter getError()
	{
		return { Console_writeFd, (void*)(nint)2 };
	}
	
	// export static AsyncCharReader getAsyncReader();
	// export static AsyncCharWriter getAsyncWriter();
	// export static AsyncCharWriter getAsyncError();
	
	export static void write(overload const char[] value) => Console.Writer.writeCharArray(value, catch _);
	
	export static void write(overload bool value) => Console.Writer.writeBool(value, catch _);
	
	export static void write(overload char value) => Console.Writer.writeChar(value, catch _);
	
	export static void write(overload int value) => Console.Writer.writeInt(value, catch _);
	
	export static void write(overload uint value) => Console.Writer.writeUInt(value, catch _);
	
	export static void write(overload long value) => Console.Writer.writeLong(value, catch _);
	
	export static void write(overload ulong value) => Console.Writer.writeULong(value, catch _);
	
	export static void write(overload nint value) => Console.Writer.writeNInt(value, catch _);
	
	export static void write(overload nuint value) => Console.Writer.writeNUInt(value, catch _);
	
	export static void write(overload float value) => Console.Writer.writeFloat(value, catch _);
	
	export static void write(overload double value) => Console.Writer.writeDouble(value, catch _);
	
	export static void writeLine(const char[] value = default) => Console.Writer.writeLine(value, catch _);
	
	export static char readChar() => Console.Reader.readChar(catch _);
	
	export static string readLine(within allocator) => Console.Reader.readLine(within allocator, catch _);
	
	export static string readToEnd(within allocator) => Console.Reader.readToEnd(within allocator, catch _);
}
