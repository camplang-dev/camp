export as Std;

bool Console_writeFd(void* context, nuint* written, char* buffer, nuint buffer_length)
{
	int fd = (int)(nint)context;
	nint result = posixWrite(fd, (const void*)buffer, buffer_length);
	if (result < 0)
		return false;
	*written = (nuint)result;
	return true;
}

bool Console_readFd(void* context, nuint* readCount, char* buffer, nuint buffer_length)
{
	return false;
}

export class Console
{
	export static CharReader getReader()
	{
		CharReader reader = default;
		reader.call = Console_readFd;
		reader.context = null;
		return reader;
	}
	
	export static CharWriter getWriter()
	{
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		return writer;
	}
	
	export static CharWriter getError()
	{
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)2;
		return writer;
	}
	
	// export static AsyncCharReader getAsyncReader();
	// export static AsyncCharWriter getAsyncWriter();
	// export static AsyncCharWriter getAsyncError();
	
	export static void writeString(const char[] value) => Console.Writer.writeString(value, catch _);
	
	export static void writeLine(const char[] value = default) => Console.Writer.writeLine(value, catch _);
	
	export static void writeBool(bool value) => Console.Writer.writeBool(value, catch _);
	
	export static void writeChar(char value) => Console.Writer.writeChar(value, catch _);
	
	export static void writeInt(int value) => Console.Writer.writeInt(value, catch _);
	
	export static void writeUInt(uint value) => Console.Writer.writeUInt(value, catch _);
	
	export static void writeDouble(double value) => Console.Writer.writeDouble(value, catch _);
}
