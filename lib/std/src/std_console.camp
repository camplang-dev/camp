export as Std;

bool Console_writeFd(void* context, nuint* written, char* buffer, nuint buffer_length)
{
	int fd = (int)(nint)context;
	nint result = posixWrite(fd, (const void*)buffer, buffer_length);
	if (result < 0)
		return false;
	*written = (nuint)result;
	return true;
}

bool Console_readFd(void* context, nuint* readCount, char* buffer, nuint buffer_length)
{
	return false;
}

export class Console
{
	export static CharReader getReader()
	{
		CharReader reader = default;
		reader.call = Console_readFd;
		reader.context = null;
		return reader;
	}
	
	export static CharWriter getWriter()
	{
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		return writer;
	}
	
	export static CharWriter getError()
	{
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)2;
		return writer;
	}
	
	// export static AsyncCharReader getAsyncReader();
	// export static AsyncCharWriter getAsyncWriter();
	// export static AsyncCharWriter getAsyncError();
	
	export static void writeString(const char[] value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeString(writer, value, catch error);
	}
	
	export static void writeLine(const char[] value = default)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeLine(writer, value, catch error);
	}
	
	export static void writeBool(bool value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeBool(writer, value, catch error);
	}
	
	export static void writeChar(char value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeChar(writer, value, catch error);
	}
	
	export static void writeInt(int value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeInt(writer, value, catch error);
	}
	
	export static void writeUInt(uint value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeUInt(writer, value, catch error);
	}
	
	export static void writeDouble(double value)
	{
		IoError error = default;
		CharWriter writer = default;
		writer.call = Console_writeFd;
		writer.context = (void*)(nint)1;
		CharWriter_writeDouble(writer, value, catch error);
	}
}
