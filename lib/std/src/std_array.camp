namespace Std;

@category("Arrays");

/// Clears every slot in an array to `default`.
public void clear<T: any>(T[] this, sizeof(T))
{
	for (nuint i = 0; i < this.length; i++)
		this[i] = default;
}

/// Copies an array into newly allocated storage.
public escaped T[] copyArray<T: copyable>(const T[] this, within allocator, sizeof(T))
{
	T[] elements = new T[this.length];
	this.copyTo<T>(elements);
	return elements;
}

/// Copies array elements into another array.
/// - destination: The array that receives copied elements. If it is shorter than the source, only the destination length is copied.
public void copyTo<T: copyable>(const T[] this, T[] destination, sizeof(T))
{
	nuint count = this.length;
	if (destination.length < count)
		count = destination.length;
	if (count == 0)
		return;

	if ((const byte*)(const void*)destination.elements < (const byte*)(const void*)this.elements)
	{
		for (nuint i = 0; i < count; i++)
			destination[i] = this[i];
	}
	else
	{
		for (nuint i = count; i > 0; i--)
			destination[i - 1] = this[i - 1];
	}
}

/// Copies elements from another array into this array.
/// - source: The array to copy from. If it is longer than this array, only this array's length is copied.
public void copyFrom<T: copyable>(T[] this, const T[] source, sizeof(T))
{
	T[] destination = { this.elements, this.length };
	source.copyTo<T>(destination);
}

/// Resizes an array buffer.
/// - newSize: The requested element count after resizing.
public void resize<T: copyable>(escaped T[]* this, nuint newSize, within allocator, sizeof(T))
{
	if (this.length == newSize)
		return;

	void* resized = allocator != null
		? allocator.realloc((escaped void*)this.elements, newSize * sizeof(T))
		: realloc((escaped void*)this.elements, newSize * sizeof(T));
	if (resized == null && newSize != 0)
		return;

	this.elements = (escaped T*)resized;
	this.length = newSize;
}

/// Reverses the elements of an array in place.
public void reverse<T: copyable>(T[] this, sizeof(T))
{
	if (this.length < 2)
		return;

	nuint left = 0;
	nuint right = this.length - 1;
	while (left < right)
	{
		T temp = this[left];
		this[left] = this[right];
		this[right] = temp;
		left++;
		right--;
	}
}

/// Sorts an array in place using insertion sort.
/// - compare: Returns a negative value when the left item sorts before the right item, zero when equal, and a positive value otherwise.
public void sort<T: copyable>(T[] this, delegate int(in T left, in T right) compare, sizeof(T))
{
	if (this.length < 2)
		return;

	for (nuint i = 1; i < this.length; i++)
	{
		nuint j = i;

		while (j > 0 && compare(this[j - 1], this[j]) > 0)
		{
			T temp = this[j - 1];
			this[j - 1] = this[j];
			this[j] = temp;
			j--;
		}
	}
}

/// Searches a sorted array for a value.
/// - value: The item to find.
/// - compare: Compares an array item with [value] using the same ordering used to sort the array.
/// @returns The zero-based index of the matching item, or `-1` when no match exists.
public nint binarySearch<T: any>(const T[] this, in T value, delegate int(in T left, in T right) compare, sizeof(T))
{
	nuint low = 0;
	nuint high = this.length;

	while (low < high)
	{
		nuint mid = low + ((high - low) / 2);
		int order = compare(this[mid], value);

		if (order < 0)
		{
			low = mid + 1;
		}
		else if (order > 0)
		{
			high = mid;
		}
		else
		{
			return (nint)mid;
		}
	}

	return -1;
}

/// Finds the first matching item in an array.
/// - item: The item to find.
/// - equals: Returns true when an array item matches [item].
/// @returns The zero-based index of the first match, or `-1` when no match exists.
public nint findIndex<T: any>(const T[] this, in T item, delegate bool(in T left, in T right) equals, sizeof(T))
{
	for (nuint i = 0; i < this.length; i++)
		if (equals(this[i], item))
			return (nint)i;

	return -1;
}

/// Finds the last matching item in an array.
/// - item: The item to find.
/// - equals: Returns true when an array item matches [item].
/// @returns The zero-based index of the last match, or `-1` when no match exists.
public nint findLastIndex<T: any>(const T[] this, in T item, delegate bool(in T left, in T right) equals, sizeof(T))
{
	for (nuint i = this.length; i > 0; i--)
		if (equals(this[i - 1], item))
			return (nint)i - 1;

	return -1;
}
