export as Std;

export void clear<T: any>(T[] this, sizeof(T))
{
	for (nuint i = 0; i < this.length; i++)
		this[i] = default;
}

export T[] copyArray<T: copyable>(const T[] this, within allocator, sizeof(T))
{
	T[] elements = new T[this.length];
	this.copyTo<T>(elements);
	return elements;
}

export void copyTo<T: copyable>(const T[] this, T[] destination, sizeof(T))
{
	nuint count = this.length;
	if (destination.length < count)
		count = destination.length;
	if (count == 0)
		return;

	if ((byte*)destination.elements < (byte*)this.elements)
	{
		for (nuint i = 0; i < count; i++)
			destination[i] = this[i];
	}
	else
	{
		for (nuint i = count; i > 0; i--)
			destination[i - 1] = this[i - 1];
	}
}

export void copyFrom<T: copyable>(T[] this, const T[] source, sizeof(T))
{
	T[] destination = { this.elements, this.length };
	source.copyTo<T>(destination);
}

export void resize<T: copyable>(T[]* this, nuint newSize, within allocator, sizeof(T))
{
	if (this.length == newSize)
		return;

	void* resized = allocator != null
		? allocator.realloc(this.elements, newSize * sizeof(T))
		: realloc(this.elements, newSize * sizeof(T));
	if (resized == null && newSize != 0)
		return;

	this.elements = (T*)resized;
	this.length = newSize;
}

export void reverse<T: copyable>(T[] this, sizeof(T))
{
	if (this.length < 2)
		return;

	nuint left = 0;
	nuint right = this.length - 1;
	while (left < right)
	{
		T temp = this[left];
		this[left] = this[right];
		this[right] = temp;
		left++;
		right--;
	}
}

export void sort<T: copyable>(T[] this, delegate int(in T left, in T right) compare, sizeof(T))
{
	if (this.length < 2)
		return;

	for (nuint i = 1; i < this.length; i++)
	{
		nuint j = i;

		while (j > 0 && compare(this[j - 1], this[j]) > 0)
		{
			T temp = this[j - 1];
			this[j - 1] = this[j];
			this[j] = temp;
			j--;
		}
	}
}

export nint binarySearch<T: any>(const T[] this, in T value, delegate int(in T left, in T right) compare, sizeof(T))
{
	nuint low = 0;
	nuint high = this.length;

	while (low < high)
	{
		nuint mid = low + ((high - low) / 2);
		int order = compare(this[mid], value);

		if (order < 0)
		{
			low = mid + 1;
		}
		else if (order > 0)
		{
			high = mid;
		}
		else
		{
			return (nint)mid;
		}
	}

	return -1;
}

export nint findIndex<T: any>(const T[] this, in T item, delegate bool(in T left, in T right) equals, sizeof(T))
{
	for (nuint i = 0; i < this.length; i++)
		if (equals(this[i], item))
			return (nint)i;

	return -1;
}

export nint findLastIndex<T: any>(const T[] this, in T item, delegate bool(in T left, in T right) equals, sizeof(T))
{
	for (nuint i = this.length; i > 0; i--)
		if (equals(this[i - 1], item))
			return (nint)i - 1;

	return -1;
}
