namespace Std;

const int CAMP_IO_ACCESS_READ = 1;
const int CAMP_IO_ACCESS_WRITE = 2;
const int CAMP_IO_ACCESS_READ_WRITE = 3;

const int CAMP_IO_MODE_OPEN_EXISTING = 0;
const int CAMP_IO_MODE_CREATE = 1;
const int CAMP_IO_MODE_CREATE_OR_TRUNCATE = 2;
const int CAMP_IO_MODE_APPEND = 3;

const int CAMP_IO_SEEK_BEGIN = 0;
const int CAMP_IO_SEEK_CURRENT = 1;
const int CAMP_IO_SEEK_END = 2;

const int CAMP_IO_OPTION_SEQUENTIAL = 1;
const int CAMP_IO_OPTION_RANDOM_ACCESS = 2;
const int CAMP_IO_OPTION_WRITE_THROUGH = 4;
const int CAMP_IO_OPTION_SHARE_READ = 8;
const int CAMP_IO_OPTION_SHARE_WRITE = 16;

int FileHandle_access(FileAccess access)
{
	if (access == FileAccess.WRITE)
		return CAMP_IO_ACCESS_WRITE;
	if (access == FileAccess.READ_WRITE)
		return CAMP_IO_ACCESS_READ_WRITE;
	return CAMP_IO_ACCESS_READ;
}

int FileHandle_mode(FileMode mode)
{
	if (mode == FileMode.CREATE)
		return CAMP_IO_MODE_CREATE;
	if (mode == FileMode.CREATE_OR_TRUNCATE)
		return CAMP_IO_MODE_CREATE_OR_TRUNCATE;
	if (mode == FileMode.APPEND)
		return CAMP_IO_MODE_APPEND;
	return CAMP_IO_MODE_OPEN_EXISTING;
}

int FileHandle_options(FileOptions options)
{
	int flags = 0;
	if (options.sequential)
		flags |= CAMP_IO_OPTION_SEQUENTIAL;
	if (options.randomAccess)
		flags |= CAMP_IO_OPTION_RANDOM_ACCESS;
	if (options.writeThrough)
		flags |= CAMP_IO_OPTION_WRITE_THROUGH;
	if (options.allowSharedRead)
		flags |= CAMP_IO_OPTION_SHARE_READ;
	if (options.allowSharedWrite)
		flags |= CAMP_IO_OPTION_SHARE_WRITE;
	return flags;
}

export enum FileAccess
{
	READ,
	WRITE,
	READ_WRITE
}

export enum FileMode
{
	OPEN_EXISTING,
	CREATE,
	CREATE_OR_TRUNCATE,
	APPEND
}

export struct FileOptions
{
	bool sequential;
	bool randomAccess;
	bool writeThrough;
	bool allowSharedRead;
	bool allowSharedWrite;
}

#if NO_FILES
@notsupported("The current target does not support file handles.")
#endif
bool FileHandle_readFd(void* context, nuint* readCount, byte* buffer, nuint buffer_length)
{
	FileHandle handle = (FileHandle)(nint)context;
	IoError error = default;
	nint result = camp_io_file_read((nint)handle, (void*)buffer, buffer_length, out error);
	if (result < 0)
		return false;
	*readCount = (nuint)result;
	return true;
}

#if NO_FILES
@notsupported("The current target does not support file handles.")
#endif
bool FileHandle_writeFd(void* context, nuint* written, byte* buffer, nuint buffer_length)
{
	FileHandle handle = (FileHandle)(nint)context;
	IoError error = default;
	nint result = camp_io_file_write((nint)handle, (const void*)buffer, buffer_length, out error);
	if (result < 0)
		return false;
	*written = (nuint)result;
	return true;
}

export newtype FileHandle: nint
{
	/// Closes the wrapped operating-system file handle.
	///
	/// Closing an invalid or already-closed handle is ignored. Errors reported
	/// by the underlying platform close operation are intentionally discarded,
	/// making this method suitable for `finally close()` cleanup.
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export void close()
	{
		if ((nint)this > 0)
		{
			IoError error = default;
			camp_io_file_close((nint)this, out error);
		}
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export static FileHandle open(string path, FileAccess access, FileMode mode, FileOptions options = default, thrown IoError error)
	{
		nint fileHandle = camp_io_file_open(path, FileHandle_access(access), FileHandle_mode(mode), FileHandle_options(options), out error);
		if (fileHandle < 0)
			throw error;
		
		error = default;
		return (FileHandle)fileHandle;
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export ulong getLength(thrown IoError error)
	{
		long current = camp_io_file_seek((nint)this, 0, CAMP_IO_SEEK_CURRENT, out error);
		if (current < 0)
			throw error;
		long length = camp_io_file_seek((nint)this, 0, CAMP_IO_SEEK_END, out error);
		if (length < 0)
			throw error;
		if (camp_io_file_seek((nint)this, current, CAMP_IO_SEEK_BEGIN, out error) < 0)
			throw error;
		error = default;
		return (ulong)length;
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export ulong getPosition(thrown IoError error)
	{
		long position = camp_io_file_seek((nint)this, 0, CAMP_IO_SEEK_CURRENT, out error);
		if (position < 0)
			throw error;
		error = default;
		return (ulong)position;
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export void setPosition(ulong value, thrown IoError error)
	{
		if (camp_io_file_seek((nint)this, (long)value, CAMP_IO_SEEK_BEGIN, out error) < 0)
			throw error;
		error = default;
	}

#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export void read(byte[] buffer, out nuint readCount, thrown IoError error)
	{
		nint result = camp_io_file_read((nint)this, (void*)buffer.elements, buffer.length, out error);
		if (result < 0)
			throw error;
		readCount = (nuint)result;
		error = default;
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export void write(const byte[] buffer, thrown IoError error)
	{
		nuint offset = 0;
		while (offset < buffer.length)
		{
			nint result = camp_io_file_write((nint)this, (const void*)&buffer.elements[offset], buffer.length - offset, out error);
			if (result <= 0)
			{
				if (error == default)
					throw IO;
				throw error;
			}
			offset += (nuint)result;
		}
		error = default;
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export ByteReader getByteReader()
	{
		return { FileHandle_readFd, (void*)(nint)this };
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export CharReader getCharReader()
	{
		ByteReader byteReader = this.ByteReader;
		return { (unsafe fn bool(void*, nuint*, char*, nuint))byteReader.call, byteReader.context };
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export ByteWriter getByteWriter()
	{
		return { FileHandle_writeFd, (void*)(nint)this };
	}
	
#if NO_FILES
	@notsupported("The current target does not support file handles.")
#endif
	export CharWriter getCharWriter()
	{
		ByteWriter byteWriter = this.ByteWriter;
		return { (unsafe fn bool(void*, nuint*, char*, nuint))byteWriter.call, byteWriter.context };
	}
	
	// export AsyncByteReader getAsyncReader();
	// export AsyncByteWriter getAsyncWriter();
}
