namespace Std;

@category("Text");

@symbol("utf8ncmp")
extern nint utf8ncmp(const char* src1, const char* src2, nuint len);
@symbol("utf8ncasecmp")
extern nint utf8ncasecmp(const char* src1, const char* src2, nuint len);
@symbol("camp_utf8nlen")
extern nuint camp_utf8nlen(const char* src, nuint len);
@symbol("camp_utf8size_lazy")
extern nuint camp_utf8size_lazy(const char* src);
@symbol("utf8nsize_lazy")
extern nuint utf8nsize_lazy(const char* src, nuint len);
@symbol("utf8codepoint")
extern const char* utf8codepoint(const char* src, out uchar codepoint);
@symbol("utf8codepointcalcsize")
extern nuint utf8codepointcalcsize(const char* src);
@symbol("utf8ncpy")
extern char* utf8ncpy(char* dst, const char* src, nuint len);
@symbol("utf8lwrcodepoint")
extern uchar utf8lwrcodepoint(uchar codepoint);
@symbol("utf8uprcodepoint")
extern uchar utf8uprcodepoint(uchar codepoint);

@symbol("camp_utf8nstr")
extern const char* camp_utf8nstr(const char* haystack, nuint haystackLen, const char* needle, nuint needleLen);
@symbol("camp_utf8ncasestr")
extern const char* camp_utf8ncasestr(const char* haystack, nuint haystackLen, const char* needle, nuint needleLen);
@symbol("camp_utf8nchr")
extern const char* camp_utf8nchr(const char* text, nuint len, uchar codepoint, int caseInsensitive);
@symbol("camp_utf8nrchr")
extern const char* camp_utf8nrchr(const char* text, nuint len, uchar codepoint, int caseInsensitive);
@symbol("camp_utf8npbrk_codepoints")
extern const char* camp_utf8npbrk_codepoints(const char* text, nuint len, const uchar* codepoints, nuint codepointCount, int caseInsensitive);
@symbol("camp_utf8nrpbrk_codepoints")
extern const char* camp_utf8nrpbrk_codepoints(const char* text, nuint len, const uchar* codepoints, nuint codepointCount, int caseInsensitive);

/// Finds the first matching text span.
/// - match: Text to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint indexOf(const char[] this, overload const char[] match, bool caseInsensitive = false)
{
	const char* found = caseInsensitive
		? camp_utf8ncasestr(this.elements, this.length, match.elements, match.length)
		: camp_utf8nstr(this.elements, this.length, match.elements, match.length);
	if (found == null)
		return -1;
	return byteOffsetOf(this.elements, found);
}

/// Finds the first matching Unicode scalar value.
/// - match: Scalar value to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint indexOf(const char[] this, overload uchar match, bool caseInsensitive = false)
{
	const char* found = camp_utf8nchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return byteOffsetOf(this.elements, found);
}

/// Finds the first scalar value contained in a set.
/// - match: Scalar values to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint indexOfAny(const char[] this, overload const uchar[] match, bool caseInsensitive = false)
{
	const char* found = camp_utf8npbrk_codepoints(this.elements, this.length, match.elements, match.length, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return byteOffsetOf(this.elements, found);
}

/// Finds the last matching text span.
/// - match: Text to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint lastIndexOf(const char[] this, overload const char[] match, bool caseInsensitive = false)
{
	nuint logical = logicalLength(this.elements, this.length);
	if (match.length == 0)
		return (nint)logical;
	if (match.length > logical)
		return -1;

	nint result = -1;
	nuint last = logical - match.length;
	for (nuint i = 0; i <= last; i++)
	{
		nint comparison = caseInsensitive
			? utf8ncasecmp(&this.elements[i], match.elements, match.length)
			: utf8ncmp(&this.elements[i], match.elements, match.length);
		if (comparison == 0)
			result = (nint)i;
	}
	return result;
}

/// Finds the last matching Unicode scalar value.
/// - match: Scalar value to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint lastIndexOf(const char[] this, overload uchar match, bool caseInsensitive = false)
{
	const char* found = camp_utf8nrchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return byteOffsetOf(this.elements, found);
}

/// Finds the last scalar value contained in a set.
/// - match: Scalar values to find.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public nint lastIndexOfAny(const char[] this, overload const uchar[] match, bool caseInsensitive = false)
{
	const char* found = camp_utf8nrpbrk_codepoints(this.elements, this.length, match.elements, match.length, caseInsensitive ? 1 : 0);
	if (found == null)
		return -1;
	return byteOffsetOf(this.elements, found);
}

/// Returns true when the text starts with a span.
/// - match: Prefix to test.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public bool startsWith(const char[] this, overload const char[] match, bool caseInsensitive = false)
{
	if (match.length > logicalLength(this.elements, this.length))
		return false;
	return (caseInsensitive ? utf8ncasecmp(this.elements, match.elements, match.length) : utf8ncmp(this.elements, match.elements, match.length)) == 0;
}

/// Returns true when the text starts with a scalar value.
/// - match: Prefix scalar to test.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public bool startsWith(const char[] this, overload uchar match, bool caseInsensitive = false)
{
	return camp_utf8nchr(this.elements, this.length, match, caseInsensitive ? 1 : 0) == this.elements;
}

/// Returns true when the text ends with a span.
/// - match: Suffix to test.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public bool endsWith(const char[] this, overload const char[] match, bool caseInsensitive = false)
{
	nuint length = logicalLength(this.elements, this.length);
	if (match.length > length)
		return false;
	return (caseInsensitive ? utf8ncasecmp(&this.elements[length - match.length], match.elements, match.length) : utf8ncmp(&this.elements[length - match.length], match.elements, match.length)) == 0;
}

/// Returns true when the text ends with a scalar value.
/// - match: Suffix scalar to test.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
public bool endsWith(const char[] this, overload uchar match, bool caseInsensitive = false)
{
	const char* found = camp_utf8nrchr(this.elements, this.length, match, caseInsensitive ? 1 : 0);
	if (found == null)
		return false;
	nuint index = (nuint)byteOffsetOf(this.elements, found);
	return index + utf8codepointcalcsize(found) == logicalLength(this.elements, this.length);
}

/// Compares two text spans.
/// - other: Text to compare with.
/// - caseInsensitive: Uses the UTF-8 helper's case-insensitive comparison.
/// @returns `-1`, `0`, or `1` for less-than, equal, or greater-than.
public nint compareTo(const char[] this, const char[] other, bool caseInsensitive = false)
{
	nuint thisLength = logicalLength(this.elements, this.length);
	nuint otherLength = logicalLength(other.elements, other.length);
	nuint comparedLength = min(thisLength, otherLength);
	nint comparison = caseInsensitive
		? utf8ncasecmp(this.elements, other.elements, comparedLength)
		: utf8ncmp(this.elements, other.elements, comparedLength);
	if (comparison < 0)
		return -1;
	if (comparison > 0)
		return 1;

	if (thisLength < otherLength)
		return -1;
	if (thisLength > otherLength)
		return 1;
	return 0;
}

/// Counts Unicode scalar values in UTF-8 text.
public nuint countUChars(const char[] this)
{
	return camp_utf8nlen(this.elements, this.length);
}

/// Gets the Unicode scalar value at a UTF-8 code-unit index.
/// - unit: UTF-8 code-unit index.
public uchar getUChar(const char[] this, @index nuint unit)
{
	uchar codepoint = 0;
	if (unit >= logicalLength(this.elements, this.length))
		return 0;
	utf8codepoint(&this.elements[unit], out codepoint);
	return codepoint;
}

/// Gets the number of UTF-8 code units used by the scalar at an index.
/// - unit: UTF-8 code-unit index.
public nuint getUCharUnits(const char[] this, @index nuint unit)
{
	if (unit >= logicalLength(this.elements, this.length))
		return 0;
	return utf8codepointcalcsize(&this.elements[unit]);
}

/// Returns a view with leading and trailing ASCII whitespace removed.
public scoped const char[] trim(const char[] this)
{
	nuint start = trimStartIndex(this.elements, this.length);
	nuint end = trimEndIndex(this.elements, this.length, start);
	return { &this.elements[start], end - start };
}

/// Returns a view with leading ASCII whitespace removed.
public scoped const char[] trimStart(const char[] this)
{
	nuint start = trimStartIndex(this.elements, this.length);
	return { &this.elements[start], logicalLength(this.elements, this.length) - start };
}

/// Returns a view with trailing ASCII whitespace removed.
public scoped const char[] trimEnd(const char[] this)
{
	nuint end = trimEndIndex(this.elements, this.length, 0);
	return { this.elements, end };
}

/// Copies the text to uppercase UTF-8 text.
public prep char[] toUppercase(const char[] this)
{
	return transformCodepoints(this, true, buffer);
}

/// Copies the text to lowercase UTF-8 text.
public prep char[] toLowercase(const char[] this)
{
	return transformCodepoints(this, false, buffer);
}

// Skip this one for now
//public scoped string[] splitCopy(const char[] this, const char[] separator, within allocator) => default;

/// Joins UTF-8 strings with an optional separator.
/// - separator: Text written between values. The default writes no separator.
public prep char[] join(string[] this, const char[] separator = default)
{
	nuint length = 0;
	nuint separatorLength = logicalLength(separator.elements, separator.length);
	for (nuint i = 0; i < this.length; i++)
	{
		length += this[i].Length;
		if (i > 0)
			length += separatorLength;
	}

	if (buffer.length < length)
		return length;

	nuint offset = 0;
	for (nuint j = 0; j < this.length; j++)
	{
		if (j > 0)
			offset = writeCharSpan(buffer, offset, separator);
		const char[] value = { (const char*)this[j], this[j].Length };
		offset = writeCharSpan(buffer, offset, value);
	}
	return length;
}

public nuint getLength(string this)
{
	return camp_utf8size_lazy(this);
}

nint byteOffsetOf(const char* start, const char* target)
{
	nuint offset = 0;
	while (&start[offset] != target)
		offset++;
	return (nint)offset;
}

bool isAsciiWhitespace(char value)
{
	return value == ' '
		|| value == '\t'
		|| value == '\n'
		|| value == '\r'
		|| value == '\v'
		|| value == '\f';
}

nuint trimStartIndex(const char* value, nuint valueLength)
{
	nuint length = logicalLength(value, valueLength);
	nuint start = 0;
	while (start < length && isAsciiWhitespace(value[start]))
		start++;
	return start;
}

nuint trimEndIndex(const char* value, nuint valueLength, nuint start)
{
	nuint end = logicalLength(value, valueLength);
	while (end > start && isAsciiWhitespace(value[end - 1]))
		end--;
	return end;
}

nuint logicalLength(const char* value, nuint valueLength)
{
	return utf8nsize_lazy(value, valueLength);
}

nuint transformCodepoints(const char[] text, bool uppercase, char[] buffer)
{
	nuint inputLength = logicalLength(text.elements, text.length);
	nuint required = transformedCodepointLength(text.elements, inputLength, uppercase);
	if (buffer.length < required)
		return required;

	nuint input = 0;
	nuint output = 0;
	while (input < inputLength)
	{
		uchar codepoint = 0;
		utf8codepoint(&text.elements[input], out codepoint);
		uchar transformed = uppercase ? utf8uprcodepoint(codepoint) : utf8lwrcodepoint(codepoint);
		output = writeUtf8Codepoint(buffer.elements, output, transformed);
		input += utf8codepointcalcsize(&text.elements[input]);
	}
	return required;
}

nuint transformedCodepointLength(const char* text, nuint textLength, bool uppercase)
{
	nuint input = 0;
	nuint length = 0;
	while (input < textLength)
	{
		uchar codepoint = 0;
		utf8codepoint(&text[input], out codepoint);
		uchar transformed = uppercase ? utf8uprcodepoint(codepoint) : utf8lwrcodepoint(codepoint);
		length += utf8LengthOf(transformed);
		input += utf8codepointcalcsize(&text[input]);
	}
	return length;
}

nuint utf8LengthOf(uchar codepoint)
{
	if (codepoint < 0x80)
		return 1;
	if (codepoint < 0x800)
		return 2;
	if (codepoint < 0x10000)
		return 3;
	return 4;
}

nuint writeUtf8Codepoint(char* output, nuint index, uchar codepoint)
{
	if (codepoint < 0x80)
	{
		output[index] = (char)codepoint;
		return index + 1;
	}
	if (codepoint < 0x800)
	{
		output[index] = (char)(0xC0 | (codepoint >> 6));
		output[index + 1] = (char)(0x80 | (codepoint & 0x3F));
		return index + 2;
	}
	if (codepoint < 0x10000)
	{
		output[index] = (char)(0xE0 | (codepoint >> 12));
		output[index + 1] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
		output[index + 2] = (char)(0x80 | (codepoint & 0x3F));
		return index + 3;
	}
	output[index] = (char)(0xF0 | (codepoint >> 18));
	output[index + 1] = (char)(0x80 | ((codepoint >> 12) & 0x3F));
	output[index + 2] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
	output[index + 3] = (char)(0x80 | (codepoint & 0x3F));
	return index + 4;
}

nuint writeCharSpan(char[] buffer, nuint offset, const char[] span)
{
	nuint length = logicalLength(span.elements, span.length);
	for (nuint i = 0; i < length; i++)
		buffer[offset + i] = span[i];
	return offset + length;
}
