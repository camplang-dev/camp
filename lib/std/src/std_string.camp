export as Std;

export nint indexOf(string this, const char[] match, bool caseInsensitive = false) => 0;
export nint indexOfChar(string this, uchar match, bool caseInsensitive = false) => 0;
export nint indexOfAnyChar(string this, uchar[] const matches, bool caseInsensitive = false) => 0;

export nint lastIndexOf(string this, const char[] match, bool caseInsensitive = false) => 0;
export nint lastIndexOfChar(string this, uchar match, bool caseInsensitive = false) => 0;
export nint lastIndexOfAnyChar(string this, const uchar[] matches, bool caseInsensitive = false) => 0;

export bool startsWith(string this, const char[] match, bool caseInsensitive = false) => false;
export bool startsWithChar(string this, uchar match, bool caseInsensitive = false) => false;
export bool endsWith(string this, const char[] match, bool caseInsensitive = false) => false;
export bool endsWithChar(string this, uchar match, bool caseInsensitive = false) => false;

export nint compareTo(string this, const char[] other, bool caseInsensitive = false) => 0;

export nuint countChars(string this) => 0;
export uchar getChar(string this, @index nuint unit) => 0;
export nuint getCharUnits(string this, @index nuint unit) => 0;

// Borrowing transformations
export scoped char[] trim(string this) => default;
export scoped char[] trimStart(string this) => default;
export scoped char[] trimEnd(string this) => default;

// NOT YET
//scoped String slice(string this, @range nuint index = 0, nuint count = ^0);

// Copy-producing transformations
export string uppercaseCopy(string this, within allocator) => default;
export string lowercaseCopy(string this, within allocator) => default;

//export scoped string[] splitCopy(string this, const char[] separator, within allocator) => default;

export string concatCopy(string[] const this, within allocator) => default;
export string joinCopy(string[] const this, const char[] separator, within allocator) => default;

