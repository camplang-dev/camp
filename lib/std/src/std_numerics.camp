namespace Std;

@category("Primitives");

public inline byte byte.MIN = (byte)0;
public inline byte byte.MAX = (byte)255;

public inline sbyte sbyte.MIN = (sbyte)-128;
public inline sbyte sbyte.MAX = (sbyte)127;

public inline short short.MIN = (short)-32768;
public inline short short.MAX = (short)32767;

public inline ushort ushort.MIN = (ushort)0;
public inline ushort ushort.MAX = (ushort)65535;

public inline int int.MIN = -2147483647 - 1;
public inline int int.MAX = 2147483647;

public inline uint uint.MIN = (uint)0;
public inline uint uint.MAX = (uint)4294967295;

public inline long long.MIN = (long)-9223372036854775807 - 1;
public inline long long.MAX = (long)9223372036854775807;

public inline ulong ulong.MIN = (ulong)0;
public inline ulong ulong.MAX = (ulong)18446744073709551615;

public inline nint nint.MIN = -(nint)((nuint)1 << (((nuint)sizeof(nint) * 8) - 1));
public inline nint nint.MAX = (nint)(((nuint)1 << (((nuint)sizeof(nint) * 8) - 1)) - 1);
public inline nuint nuint.MIN = (nuint)0;
public inline nuint nuint.MAX = ((((nuint)1 << (((nuint)sizeof(nuint) * 8) - 1)) - 1) * 2) + 1;

public byte abs(overload sbyte value) => value < 0 ? (byte)-value : (byte)value;

public ushort abs(overload short value) => value < 0 ? (ushort)-value : (ushort)value;

public uint abs(overload int value) => value < 0 ? -(uint)value : (uint)value;

public ulong abs(overload long value) => value < 0 ? -(ulong)value : (ulong)value;

public byte min(overload byte left, byte right) => left < right ? left : right;
public byte max(overload byte left, byte right) => left > right ? left : right;

public sbyte min(overload sbyte left, sbyte right) => left < right ? left : right;
public sbyte max(overload sbyte left, sbyte right) => left > right ? left : right;

public short min(overload short left, short right) => left < right ? left : right;
public short max(overload short left, short right) => left > right ? left : right;

public ushort min(overload ushort left, ushort right) => left < right ? left : right;
public ushort max(overload ushort left, ushort right) => left > right ? left : right;

public int min(overload int left, int right) => left < right ? left : right;
public int max(overload int left, int right) => left > right ? left : right;

public uint min(overload uint left, uint right) => left < right ? left : right;
public uint max(overload uint left, uint right) => left > right ? left : right;

public long min(overload long left, long right) => left < right ? left : right;
public long max(overload long left, long right) => left > right ? left : right;

public ulong min(overload ulong left, ulong right) => left < right ? left : right;
public ulong max(overload ulong left, ulong right) => left > right ? left : right;

public nint min(overload nint left, nint right) => left < right ? left : right;
public nint max(overload nint left, nint right) => left > right ? left : right;

public nuint min(overload nuint left, nuint right) => left < right ? left : right;
public nuint max(overload nuint left, nuint right) => left > right ? left : right;

public uchar min(overload uchar left, uchar right) => left < right ? left : right;
public uchar max(overload uchar left, uchar right) => left > right ? left : right;

public float min(overload float left, float right) => left < right ? left : right;
public float max(overload float left, float right) => left > right ? left : right;

public double min(overload double left, double right) => left < right ? left : right;
public double max(overload double left, double right) => left > right ? left : right;
