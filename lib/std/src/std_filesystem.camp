namespace Std;

@category("I/O");

/// Provides common host filesystem operations.
requires (SUPPORTS_FILES)
static class FileSystem
{
	/// Creates a directory.
	///
	/// - path: Directory path to create.
	/// - recursive: When true, missing parent directories are created.
	/// @remarks Throws `IoError` when the directory cannot be created.
	public static void createDirectory(string path, bool recursive = false, thrown IoError error)
	{
		int result = recursive
			? camp_io_create_directory_recursive(path, out error)
			: camp_io_create_directory(path, out error);
		if (result == 0)
			throw error;
		error = default;
	}

	/// Deletes a directory.
	///
	/// - path: Directory path to delete.
	/// - recursive: When true, contained files and directories are removed first.
	/// @remarks Throws `IoError` when the directory cannot be deleted.
	/// Recursive deletion deletes symlink or reparse-point entries themselves
	/// rather than following them as directories.
	public static void deleteDirectory(string path, bool recursive = false, thrown IoError error)
	{
		int result = recursive
			? camp_io_delete_directory_recursive(path, out error)
			: camp_io_delete_directory(path, out error);
		if (result == 0)
			throw error;
		error = default;
	}

	/// Deletes a file.
	///
	/// - path: File path to delete.
	/// @remarks Throws `IoError` when the file cannot be deleted.
	public static void deleteFile(string path, thrown IoError error)
	{
		if (camp_io_delete_file(path, out error) == 0)
			throw error;
		error = default;
	}

	/// Copies a file.
	///
	/// - source: Existing source file path.
	/// - dest: Destination file path.
	/// - overwrite: When true, an existing destination file may be replaced.
	/// @remarks Throws `IoError` when the file cannot be copied.
	public static void copyFile(string source, string dest, bool overwrite = false, thrown IoError error)
	{
		int overwriteFlag = 0;
		if (overwrite)
			overwriteFlag = 1;
		if (camp_io_copy_file(source, dest, overwriteFlag, out error) == 0)
			throw error;
		error = default;
	}

	/// Moves or renames a file.
	///
	/// - source: Existing source file path.
	/// - dest: Destination file path.
	/// - overwrite: When true, an existing destination file may be replaced.
	/// @remarks Throws `IoError` when the file cannot be moved.
	public static void moveFile(string source, string dest, bool overwrite = false, thrown IoError error)
	{
		int overwriteFlag = 0;
		if (overwrite)
			overwriteFlag = 1;
		if (camp_io_move_file(source, dest, overwriteFlag, out error) == 0)
			throw error;
		error = default;
	}

	/// Returns true when a filesystem entry exists at [path].
	///
	/// - path: Path to probe.
	/// @remarks This is a convenience probe. It returns false for missing paths
	/// and for errors that prevent reliable probing.
	public static bool exists(string path)
	{
		return camp_io_path_exists(path) != 0;
	}

	/// Returns an iterator over the immediate entry names in a directory.
	///
	/// - path: Directory path to enumerate.
	/// - allocator: Allocation context for the iterator state.
	/// @remarks Opening begins synchronously, but an open failure is delivered
	/// when the iterator is advanced. Entry order is native and unspecified.
	/// Each yielded name borrows one reusable iterator buffer and is valid only
	/// until the next iterator advancement or iterator destruction. Copy a name
	/// before retaining it.
	public static iter(string, thrown IoError) iterateDirectory(string path, within allocator)
	{
		IoError error = default;
		nint handle = camp_io_directory_open(path, out error);
		return within (allocator) asDirectoryIterator(iterateDirectoryCore(handle, error));
	}

	/// Returns true when [path] exists and is a directory.
	///
	/// - path: Path to probe.
	/// - noFollow: When true, symbolic links and Windows directory reparse points
	///   are not considered directories themselves.
	/// @remarks This is a convenience probe. It returns false for files, missing
	/// paths, links or reparse points when [noFollow] is true, and errors that
	/// prevent reliable probing. By default, links and directory reparse points
	/// are followed.
	public static bool isDirectory(string path, bool noFollow = false)
	{
		return camp_io_path_is_directory(path, noFollow ? 1 : 0) != 0;
	}

	/// Gets a file size in bytes.
	///
	/// - file: File path to query.
	/// @remarks Throws `IoError` when the file size cannot be queried.
	public static ulong getSize(string file, thrown IoError error)
	{
		ulong size = 0;
		if (camp_io_file_get_size(file, out size, out error) == 0)
			throw error;
		error = default;
		return size;
	}
}

// The iterator protocol conversion must be materialized as a call argument.
// Returning the generated class iterator directly currently omits its context
// when lowering to C.
iter(string, thrown IoError) asDirectoryIterator(iter(string, thrown IoError) iterator)
{
	return iterator;
}

class iter(string, thrown IoError) iterateDirectoryCore(nint handle, IoError openError, within allocator)
{
	fixed char[4096] name = default;

	finally
	{
		if (handle != 0)
			camp_io_directory_close(handle);
	}

	if (openError != default)
		throw openError;

	while (true)
	{
		IoError error = default;
		int result = camp_io_directory_read(handle, name.elements, name.length, out error);
		if (result < 0)
			throw error;
		if (result == 0)
			yield break;
		yield (string)name.elements;
	}
}
