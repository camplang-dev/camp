namespace Std;

@test
void numericMinMaxHelpers(thrown Assertion* assertion)
{
	assert(min((double)2, (double)3) == 2.0, "double min should return smaller value");
	assert(max((double)2, (double)3) == 3.0, "double max should return larger value");
	assert(min((double)4, min((double)2, (double)3)) == 2.0, "nested double min should compose");
	assert(max((double)4, max((double)2, (double)3)) == 4.0, "nested double max should compose");
	assert(min((float)2, (float)3) == (float)2, "float min should return smaller value");
	assert(max((float)2, (float)3) == (float)3, "float max should return larger value");
	assert(min((float)4, min((float)2, (float)3)) == (float)2, "nested float min should compose");
	assert(max((float)4, max((float)2, (float)3)) == (float)4, "nested float max should compose");
}
