namespace Std;

@test
void utf16StringSearchTrimCaseJoinAndEmbeddedNulls(thrown Assertion* assertion)
{
	wstring text = "  Hello, hello!  ";
	const wchar[] span = text[..];
	const wchar[] hello = "Hello";
	const wchar[] helloLower = "hello";
	const wchar[] lo = "lo";
	const wchar[] prefix = "  He";
	const wchar[] suffix = "!  ";
	const wchar[] original = "  Hello, hello!  ";
	const wchar[] upperText = "  HELLO, HELLO!  ";
	const wchar[] lowerText = "  hello, hello!  ";
	const wchar[] joinedText = "one,two,three";
	const wchar[] concatenatedText = "onetwothree";
	const wchar[] comma = ",";

	assert(text.indexOf(hello) == 2, "wstring indexOf should find UTF-16 strings");
	assert(text.indexOf(helloLower, true) == 2, "wstring indexOf should support case-insensitive search");
	assert(span.lastIndexOf(lo) == 12, "wstring lastIndexOf should find UTF-16 slices");
	assert(span.indexOf((uchar)'H') == 2, "wstring indexOf should find code points");
	assert(text.indexOf((uchar)'e') == 3, "wstring indexOf should find code points on strings");
	assert(text[..].indexOf((uchar)'l') == 4, "wstring slice indexOf should find code points");
	assert(span.lastIndexOf((uchar)'o') == 13, "wstring lastIndexOf should find code points");

	uchar[] any = [(uchar)'x', (uchar)'H'];
	assert(span.indexOfAny(any) == 2, "wstring indexOfAny should find code points");
	uchar[] anyLast = [(uchar)'!', (uchar)'x'];
	assert(span.lastIndexOfAny(anyLast) == 14, "wstring lastIndexOfAny should find code points from the end");

	assert(text.startsWith(prefix), "wstring startsWith should accept UTF-16 prefixes");
	assert(span.startsWith((uchar)' '), "wstring startsWith should accept code point prefixes");
	assert(span.endsWith(suffix), "wstring endsWith should accept UTF-16 suffixes");
	assert(span.endsWith((uchar)' '), "wstring endsWith should accept code point suffixes");
	assert(text.compareTo(original) == 0, "wstring compareTo should compare equal strings");

	wstring face = "a\U0001F600b";
	assert(face[..].countUChars() == 3, "wstring countUChars should count surrogate pairs as one code point");
	assert(face[..].getUChar(1) == (uchar)128512, "wstring getUChar should decode surrogate pairs");
	assert(face[..].getUCharUnits(1) == 2, "wstring getUCharUnits should report surrogate pair width");

	assert(span.trim().length == 13, "wstring trim should remove leading and trailing whitespace");
	assert(span.trimStart().length == 15, "wstring trimStart should remove leading whitespace");
	assert(span.trimEnd().length == 15, "wstring trimEnd should remove trailing whitespace");

	wstring copied = span.toWString();
	wstring upper = span.toUppercase();
	wstring lower = span.toLowercase();
	wstring[] words = ["one", "two", "three"];
	wstring concatenated = words.join();
	wstring joined = words.join(comma);

	fixed wchar[17] explicitUpper = default;
	assert(span.toUppercase(buffer: explicitUpper) == 17, "wstring toUppercase should return required length for explicit buffers");
	assert(explicitUpper[..].compareTo(upperText) == 0, "wstring toUppercase should fill explicit buffers");

	assert(copied[..].compareTo(original) == 0, "toWString should copy UTF-16 text");
	assert(upper[..].compareTo(upperText) == 0, "wstring toUppercase should allocate uppercase text");
	assert(lower[..].compareTo(lowerText) == 0, "wstring toLowercase should allocate lowercase text");
	assert(concatenated[..].compareTo(concatenatedText) == 0, "wstring join should concatenate without separators by default");
	assert(joined[..].compareTo(joinedText) == 0, "wstring join should include explicit separators");

	const wchar[] embeddedNull = [(wchar)'a', (wchar)'b', (wchar)0, (wchar)'x', (wchar)'y'];
	const wchar[] ab = "ab";
	assert(embeddedNull.compareTo(ab) == 0, "wstring compareTo should stop at embedded null");
	assert(embeddedNull.countUChars() == 2, "wstring countUChars should stop at embedded null");
}
