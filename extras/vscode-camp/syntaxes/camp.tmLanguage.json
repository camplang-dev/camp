{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Camp",
  "scopeName": "source.camp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.camp",
          "match": "///.*$"
        },
        {
          "name": "comment.block.documentation.camp",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.camp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.camp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.camp",
          "begin": "\\$\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.camp"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.camp"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.camp",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.brace.camp",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.camp",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.camp"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.camp"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.camp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.camp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.camp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.camp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.camp",
          "match": "\\b0[xX][0-9a-fA-F_]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.binary.camp",
          "match": "\\b0[bB][01_]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.decimal.camp",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?[uUlL]*\\b"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.directive.camp",
          "match": "^\\s*#\\s*(?:build|within|define|undef|if|elif|else|endif)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.parameter.prep.camp",
          "match": "\\bprep\\b(?=\\s+(?:(?:const|constof|volatile|escaped|scoped|unscoped)\\s+)*(?:[A-Za-z_][A-Za-z0-9_:]*|char|wchar|achar)(?:\\s*[*?]|\\s*\\[\\])?\\s+[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "keyword.control.camp",
          "match": "\\b(?:if|else|do|while|for|foreach|in|return|break|continue|goto|try|catch|finally|throw|yield|await|postpone|upon|switch|case|default|delete|new|stackalloc|within)\\b"
        },
        {
          "name": "keyword.declaration.camp",
          "match": "\\b(?:using|namespace|as|export|internal|public|extern|inline|static|shadow|class|struct|interface|enum|newtype|params|alias|this|operator|constructor|destructor|virtual|abstract|override|sealed|escaped|scoped|unscoped|const|constof|volatile|fixed|unsafe|overload|implements|copyable|sizeof|vtableof|typenameof|classtype|thrown|out|in|delegate|fn|iter|once|async)\\b"
        },
        {
          "name": "keyword.other.camp",
          "match": "\\b(?:caller|sourceof)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.test.camp",
          "match": "\\b(?:assert|fail)\\b(?=\\s*\\()"
        },
        {
          "name": "constant.language.camp",
          "match": "\\b(?:true|false|null|base)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.camp",
          "match": "\\b(?:any|auto|void|bool|byte|sbyte|short|ushort|int|uint|long|ulong|nint|nuint|float|double|char|uchar|achar|wchar|string|astring|wstring|classtype)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.type.annotation.camp",
          "match": "(@(?:getshadow|setshadow)\\b)",
          "captures": {
            "1": {
              "name": "storage.type.annotation.shadow.camp"
            }
          }
        },
        {
          "name": "storage.type.annotation.camp",
          "match": "(@(?:test|testonly|skip)\\b)",
          "captures": {
            "1": {
              "name": "storage.type.annotation.test.camp"
            }
          }
        },
        {
          "name": "storage.type.annotation.camp",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.camp",
          "match": "\\b(?!(?:if|else|do|while|for|foreach|in|return|break|continue|goto|try|catch|finally|throw|yield|await|postpone|upon|switch|case|default|delete|new|stackalloc|within|using|namespace|as|export|internal|public|extern|inline|static|shadow|class|struct|interface|enum|newtype|params|alias|this|operator|constructor|destructor|virtual|abstract|override|sealed|escaped|scoped|unscoped|const|constof|volatile|fixed|unsafe|overload|implements|copyable|sizeof|vtableof|typenameof|caller|sourceof|classtype|thrown|out|delegate|fn|iter|once|async|true|false|null|base|any|auto|void|bool|byte|sbyte|short|ushort|int|uint|long|ulong|nint|nuint|float|double|char|uchar|achar|wchar|string|astring|wstring)\\b)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.camp",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.arrow.camp",
          "match": "=>"
        },
        {
          "name": "keyword.operator.bitwise.shift.camp",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.camp",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.camp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.camp",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.camp",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.camp",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.conditional.camp",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.camp",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.camp",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.camp",
          "match": ":"
        },
        {
          "name": "punctuation.separator.range.camp",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.accessor.dot.camp",
          "match": "\\."
        },
        {
          "name": "punctuation.section.block.begin.bracket.curly.camp",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.bracket.curly.camp",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parameters.begin.bracket.round.camp",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parameters.end.bracket.round.camp",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.bracket.square.camp",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.bracket.square.camp",
          "match": "\\]"
        }
      ]
    }
  }
}
