{
  "name": "vscode-camp",
  "displayName": "Camp Language Support",
  "description": "Syntax highlighting, language server support, and build/run commands for Camp.",
  "version": "0.0.1",
  "publisher": "camp",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:camp",
    "onLanguage:campbuild",
    "onCommand:camp.build",
    "onCommand:camp.run",
    "onCommand:camp.debug",
    "onCommand:camp.test.run",
    "onCommand:camp.test.cover",
    "onCommand:camp.test.debug",
    "onCommand:camp.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "camp",
        "aliases": [
          "Camp",
          "camp"
        ],
        "extensions": [
          ".camp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "campbuild",
        "aliases": [
          "Camp Build",
          "campbuild"
        ],
        "extensions": [
          ".campbuild"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "camp",
        "scopeName": "source.camp",
        "path": "./syntaxes/camp.tmLanguage.json"
      },
      {
        "language": "campbuild",
        "scopeName": "source.campbuild",
        "path": "./syntaxes/camp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Camp",
      "properties": {
        "camp.server.path": {
          "type": "string",
          "default": "camp-lsp",
          "description": "Path to the camp-lsp executable. Use an absolute path when camp-lsp is not on PATH."
        },
        "camp.server.trace": {
          "type": "boolean",
          "default": false,
          "description": "Enable Camp language server performance trace logging."
        },
        "camp.server.traceDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory for Camp language server performance trace files when camp.server.trace is enabled. When empty, traces are written under the extension global storage folder."
        },
        "camp.debugAdapter.path": {
          "type": "string",
          "default": "",
          "description": "Path to the camp-dap executable. When empty, derives camp-dap from camp.server.path."
        },
        "camp.debug.nativeBackend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "lldb",
            "gdb",
            "cdb"
          ],
          "description": "Native debugger backend used by Camp debug sessions."
        }
      }
    },
    "commands": [
      {
        "command": "camp.build",
        "title": "Camp: Build Current Project",
        "category": "Camp"
      },
      {
        "command": "camp.run",
        "title": "Camp: Run Current Project",
        "category": "Camp"
      },
      {
        "command": "camp.debug",
        "title": "Camp: Debug Current Project",
        "category": "Camp"
      },
      {
        "command": "camp.test.run",
        "title": "Camp: Run Test",
        "category": "Camp"
      },
      {
        "command": "camp.test.cover",
        "title": "Camp: Cover Test",
        "category": "Camp"
      },
      {
        "command": "camp.test.debug",
        "title": "Camp: Debug Test",
        "category": "Camp"
      },
      {
        "command": "camp.restartServer",
        "title": "Camp: Restart Language Server",
        "category": "Camp"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "camp.build",
          "when": "resourceLangId == camp || resourceLangId == campbuild",
          "group": "navigation@10"
        },
        {
          "command": "camp.run",
          "when": "resourceLangId == camp || resourceLangId == campbuild",
          "group": "navigation@11"
        },
        {
          "command": "camp.debug",
          "when": "resourceLangId == camp || resourceLangId == campbuild",
          "group": "navigation@12"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "camp"
      }
    ],
    "debuggers": [
      {
        "type": "camp",
        "label": "Camp",
        "languages": [
          "camp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "project"
            ],
            "properties": {
              "project": {
                "type": "string",
                "description": "Path to the .campbuild project or loose .camp source file to debug."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the Camp build and debug launch."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to the debugged program."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at program entry after launch."
              },
              "backend": {
                "type": "string",
                "enum": [
                  "auto",
                  "lldb",
                  "gdb",
                  "cdb"
                ],
                "default": "auto",
                "description": "Native debugger backend."
              },
              "testFilter": {
                "type": "string",
                "description": "Exact Camp test manifest ID to debug through the generated test harness."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Debug Camp",
            "type": "camp",
            "request": "launch",
            "project": "${workspaceFolder}/app.campbuild",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopOnEntry": false,
            "backend": "auto"
          }
        ]
      }
    ]
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository",
    "check": "node --check src/extension.js && node --check src/campPaths.js",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  }
}
