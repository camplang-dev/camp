// @ target test-abi-slot-compatible

struct Holder
{
	const wchar* text;
}

void assign(Holder* holder)
{
	holder.text = "Window";
}

void assignFace(Holder* holder)
{
	holder.text = "a😀b";
}

export int main()
{
	Holder holder = {};
	assign(&holder);
	assignFace(&holder);
	return holder.text == default ? 1 : 0;
}
