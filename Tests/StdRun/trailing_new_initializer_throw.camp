using Std;

struct Assertion
{
	escaped string message;
	escaped string sourcefile;
	uint sourceline;
}

export int main()
{
	try
	{
		assert(1 == 2);
	}
	catch (Assertion* assertion)
	{
		Console.writeLine(assertion.message);
		Console.writeLine(assertion.sourceline);
		within(default) delete assertion;
		return 0;
	}
	return 1;
}

void assert(bool condition, escaped string message = sourceof(condition), escaped string sourcefile = caller(sourcefile), uint sourceline = caller(sourceline), thrown Assertion*)
{
	if (!condition)
	{
		throw within(default) new Assertion() { .message = message, .sourcefile = sourcefile, .sourceline = sourceline };
	}
}
