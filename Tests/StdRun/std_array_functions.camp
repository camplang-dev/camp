using Std;

int compareInt(in int left, in int right)
{
	if (left < right)
		return -1;
	if (left > right)
		return 1;
	return 0;
}

export int main()
{
	int[] source = [3, 1, 2, 4];
	int[] destination = [0, 0, 0, 0];

	Array_copyTo<int>(source, destination);
	if (destination[0] != 3 || destination[1] != 1 || destination[2] != 2 || destination[3] != 4)
		return 1;

	Array_reverse<int>(destination);
	if (destination[0] != 4 || destination[1] != 2 || destination[2] != 1 || destination[3] != 3)
		return 2;

	Array_sort<int>(destination, compareInt);
	if (destination[0] != 1 || destination[1] != 2 || destination[2] != 3 || destination[3] != 4)
		return 3;

	if (Array_binarySearch<int>(destination, 3, compareInt) != 2)
		return 4;
	if (Array_binarySearch<int>(destination, 9, compareInt) != -1)
		return 5;

	Array_clear<int>(source);
	if (source[0] != 0 || source[1] != 0 || source[2] != 0 || source[3] != 0)
		return 6;

	Array_copyFrom<int>(source, destination);
	if (source[0] != 1 || source[1] != 2 || source[2] != 3 || source[3] != 4)
		return 7;

	return 0;
}
