using Std;

export int main()
{
	auto ints = new List<int>() finally delete;
	ints.add(3);
	ints.add(1);
	ints.add(2, 1);
	if (ints.Length != 3)
		return 1;
	if (ints.Capacity < 8)
		return 2;
	if (ints.Item[0] != 3 || ints.Item[1] != 2 || ints.Item[2] != 1)
		return 3;

	ints.setItem(0, 5);
	if (ints.getItem(0) != 5)
		return 4;

	ints.Item[1] = 4;
	if (ints.Item[1] != 4)
		return 5;

	if (ints.removeRange(1..2) != 1)
		return 6;
	if (ints.Length != 2)
		return 7;
	if (ints.remove(8) != 0)
		return 8;
	if (ints.remove(^1) != 1)
		return 9;
	if (ints.Length != 1)
		return 10;
	ints.clear(true);
	if (ints.Length != 0 || ints.Capacity != 0)
		return 11;

	for (int i = 0; i < 12; i++)
		ints.add(i);
	if (ints.Capacity <= 8)
		return 12;
	if (ints.Item[0] != 0 || ints.Item[11] != 11)
		return 13;

	auto words = new List<string>() finally delete;
	string one = "one";
	string two = "two";
	words.add(one);
	words.add(two);
	if (words.Length != 2)
		return 14;
	if (words.Item[0].Length != 3)
		return 15;

	auto copy = words.copyList() finally delete;
	if (copy == null)
		return 16;
	if (copy.Length != 2 || copy.Item[1].Length != 3)
		return 17;
	words.setItem(1, "changed");
	if (copy.Item[1].Length != 3)
		return 18;

	int[] inserted = [20, 21, 22];
	ints.clear();
	ints.add(10);
	ints.add(30);
	ints.addRange(inserted, 1);
	if (ints.Length != 5)
		return 19;
	if (ints.Item[0] != 10 || ints.Item[1] != 20 || ints.Item[3] != 22 || ints.Item[4] != 30)
		return 20;

	int[] copied = ints.copyArray(1..4);
	if (copied.length != 3 || copied.elements[0] != 20 || copied.elements[2] != 22)
		return 21;
	delete copied;

	int[] dest = [0, 0, 0, 0, 0];
	ints.copyTo(dest, 1, 1..4);
	if (dest.length != 5 || dest.elements[0] != 0 || dest.elements[1] != 20 || dest.elements[3] != 22 || dest.elements[4] != 0)
		return 22;

	int* address = ints.getAddressOf(1);
	if (address == null || *address != 20)
		return 23;

	ints.sort(compareInt);
	if (ints.binarySearch(22, compareInt) != 3)
		return 24;
	if (ints.binarySearch(99, compareInt) != -1)
		return 25;
	if (ints.binarySearch(22, compareInt, 1..) != 3)
		return 26;
	if (ints.binarySearch(22, compareInt, 1..5) != 3)
		return 27;

	int[] taken = ints.takeBuffer();
	if (taken.length != 5 || taken.elements[4] != 30)
		return 28;
	if (ints.Length != 0 || ints.Capacity != 0)
		return 29;
	delete taken;

	string[] moreWords = ["red", "blue"];
	words.addRange(moreWords);
	if (words.Length != 4 || words.Item[2].Length != 3 || words.Item[3].Length != 4)
		return 30;

	string[] wordBuffer = words.takeBuffer();
	if (wordBuffer.length != 4 || wordBuffer.elements[0].Length != 3 || wordBuffer.elements[3].Length != 4)
		return 31;
	if (words.Length != 0 || words.Capacity != 0)
		return 32;
	delete wordBuffer;

	auto lines = new List<const char[]>() finally delete;
	const char[] alpha = "one";
	const char[] beta = "two";
	lines.add(alpha);
	lines.add(beta);
	if (lengthOf(lines.getItem(0)) != 3)
		return 33;
	auto lineItem = lines.Item[1];
	if (lineItem.length != 3 || lineItem[0] != 't')
		return 34;
	if (lengthOf(lineItem.trim()) != 3)
		return 35;
	string gamma = "three";
	lines.add(gamma);
	auto lineItem2 = lines.Item[2];
	if (lineItem2.length != 5 || lineItem2[0] != 't')
		return 36;

	return 0;
}

int compareInt(in int left, in int right)
{
	if (left < right)
		return -1;
	if (left > right)
		return 1;
	return 0;
}

nuint lengthOf(const char[] value)
{
	return value.length;
}
