using Std;

int observed;

class Resumer
{
	void resumeAsync(escaped once void() continuation)
	{
		continuation();
	}
}

Resumer resumer;

async int addOne(int value, @awaitwith Resumer* resumer)
{
	return value + 1;
}

async int combine(int first, @awaitwith Resumer* resumer)
{
	int second = await addOne(first, resumer);
	int third = await addOne(second, resumer);
	return third + first;
}

void complete(void* context, int value)
{
	observed = value;
}

export int main()
{
	combine(4, &resumer, complete, null);
	Console.writeLine(observed);
	return observed == 10 ? 0 : 1;
}
