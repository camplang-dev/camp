using Std;

export int main()
{
	string text = "  Hello, hello!  ";
	const char[] span = text.Span;

	if (text.indexOf("Hello") != 2)
		return 1;
	const char[] helloLower = "hello";
	if (text.indexOf(helloLower, true) != 2)
		return 2;
	if (span.lastIndexOf("lo") != 12)
		return 3;
	if (span.indexOfChar((uchar)'H') != 2)
		return 4;
	if (text.indexOfChar('e') != 3)
		return 25;
	if (text.Span.indexOfChar('l') != 4)
		return 26;
	if (span.lastIndexOfChar((uchar)'o') != 13)
		return 5;

	uchar[] any = [(uchar)'x', (uchar)'H'];
	if (span.indexOfAnyChar(any) != 2)
		return 6;
	uchar[] anyLast = [(uchar)'!', (uchar)'x'];
	if (span.lastIndexOfAnyChar(anyLast) != 14)
		return 7;

	if (!text.startsWith("  He"))
		return 8;
	if (!span.startsWithChar((uchar)' '))
		return 9;
	if (!span.endsWith("!  "))
		return 10;
	if (!span.endsWithChar((uchar)' '))
		return 11;
	if (text.compareTo("  Hello, hello!  ") != 0)
		return 12;

	string accent = "caf\xC3\xA9";
	if (accent.Span.countChars() != 4)
		return 13;
	if (accent.Span.getChar(3) != (uchar)233)
		return 14;
	if (accent.Span.getCharUnits(3) != 2)
		return 15;

	if (span.trim().length != 13)
		return 16;
	if (span.trimStart().length != 15)
		return 17;
	if (span.trimEnd().length != 15)
		return 18;

	Allocator* allocator = null;
	string upper = null;
	string lower = null;
	string joined = null;
	string concatenated = null;
	string[] words = ["one", "two", "three"];
	within (allocator)
	{
		upper = span.uppercaseCopy();
		lower = span.lowercaseCopy();
		concatenated = words.concatCopy();
		joined = words.joinCopy(",");
	}

	if (upper.Span.compareTo("  HELLO, HELLO!  ") != 0)
		return 19;
	if (lower.Span.compareTo("  hello, hello!  ") != 0)
		return 20;
	if (concatenated.Span.compareTo("onetwothree") != 0)
		return 21;
	if (joined.Span.compareTo("one,two,three") != 0)
		return 22;

	const char[] embeddedNull = ['a', 'b', '\0', 'x', 'y'];
	if (embeddedNull.compareTo("ab") != 0)
		return 23;
	if (embeddedNull.countChars() != 2)
		return 24;

	return 0;
}
