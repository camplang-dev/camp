escaped async int(int value) missingNew()
{
	return (value, complete) => complete(value);
}

escaped async int(int value) missingComplete()
{
	return new delegate value => value + 1;
}

once void() onceTarget()
{
	return new delegate () => {};
}

fn int() fnTarget()
{
	return new delegate () => 1;
}

void scopedTarget(scoped delegate void() callback)
{
}

void badScoped()
{
	scopedTarget(new delegate () => {});
}
