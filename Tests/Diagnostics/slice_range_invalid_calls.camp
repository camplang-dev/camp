scoped const string slice(const string this, @range nuint index = 0, nuint count = ^0)
{
	return this;
}

const string noRange(const string this, nuint index, nuint count)
{
	return this;
}

nuint getLength(const string this)
{
	return 10;
}

void main(const string text)
{
	text.noRange(1..2);
	text.slice(1, ^2);
}
