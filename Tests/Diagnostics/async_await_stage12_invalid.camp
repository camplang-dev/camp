extern async void asyncVoid();
extern void multiSuccess(once void(int x, int y) complete = default);
extern void notOnce(delegate void() complete = default);

class Resumer
{
	void resumeAsync(escaped once void() continuation)
	{
	}
}

async void awaitMulti(@awaitwith Resumer* resumer)
{
	await multiSuccess();
}

void awaitOutside()
{
	await asyncVoid();
}
