interface IRequired
{
	int required(int value);
	int optional(int value) = null;
}

class MissingRequired: IRequired
{
}

int wrongDefault(int value)
{
	return value;
}

interface IWrongDefault
{
	int value(int value) = wrongDefault;
	int invalidExpression(int value) = wrongDefault(1);
}

interface IBaseOptional
{
	int inheritedOptional(int value) = null;
	int inheritedRequired(int value);
}

class BaseOptional: IBaseOptional
{
	int inheritedRequired(int value): IBaseOptional
	{
		return value;
	}
}

class DerivedOptional: BaseOptional
{
	int inheritedOptional(int value): IBaseOptional
	{
		return value;
	}
}
