void use(Escapes* value)
{
}

struct MissingField
{
	int x;
	int y;

	MissingField()
	{
		this.x = 1;
	}
}

struct Escapes
{
	int x;
	int y;

	Escapes()
	{
		this.x = 1;
		use(this);
		this.y = 2;
	}
}

struct CallsMethod
{
	int x;
	int y;

	CallsMethod()
	{
		this.x = 1;
		this.validate();
		this.y = 2;
	}

