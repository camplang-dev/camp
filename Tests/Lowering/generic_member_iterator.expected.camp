class Box<T>
{
	Box_iterateIter<T> iterate()
	{
		return {.__state = 0, .__iter_this = this};
	}
}
void main(Box<int>* box)
{
	Box_iterateIter<int> __local0 = Box_iterate(box);
	fn bool(void*, int*) it = Box_iterateIter_iter;
	void* it_context = (void*)&__local0;
}

fixed struct Box_iterateIter<T>
{
	int __state;
	Box<T>* __iter_this;

	bool next(T* current)
	{
		if (this.__state == -1)
			return false;
		this.__state = -1;
		return false;
		this.__state = -1;
		return false;
	}

	void op_delete()
	{
		if (this.__state != -1)
		{
			this.__state = -1;
		}
	}

	void destroy()
	{
		Box_iterateIter_op_delete(this);
	}

	static bool op_iter(void* ctx, T* current)
	{
		Box_iterateIter* state = (Box_iterateIter*)ctx;
		if (current == null)
		{
			Box_iterateIter_op_delete(state);
			return false;
		}
		return Box_iterateIter_next(state, current);
	}
}
