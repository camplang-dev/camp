scoped const int[] slice(const int[] this, @range nuint index = 0, nuint count = ^0)
{
	const int[] sliceResult = {};
	sliceResult.elements = this.elements;
	sliceResult.length = count;
	return sliceResult;
}

int getAt(const int[] this, @index nuint index)
{
	return this[index];
}

void consume(const int[] values)
{
}

void main()
{
	int[] values = [1, 2, 3, 4, 5, 6];
	consume(values.slice(2..5));
	consume(values.slice(..5));
	consume(values.slice(2..));
	consume(values.slice(..));
	consume(values.slice(2..^1));
	consume(values.slice(^5..^1));
	consume(values.slice(5));
	consume(values.slice());
	int last = values.getAt(^1);
}
