valuesIter values()
{
	return {.__state = 0};
}

fixed struct valuesIter
{
	int __state;

	bool next(int* current)
	{
		if (this.__state == -1)
			return false;
		if (this.__state == 1)
			goto __iter_resume1;
		if (this.__state == 2)
			goto __iter_resume2;
		*current = 1;
		this.__state = 1;
		return true;
		__iter_resume1:
		;
		*current = 2;
		this.__state = 2;
		return true;
		__iter_resume2:
		;
		this.__state = -1;
		return false;
	}

	void destroy()
	{
	}
}
