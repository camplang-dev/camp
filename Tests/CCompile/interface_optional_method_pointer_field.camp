export extern void* malloc(nuint size);
export extern void free(void* ptr);

export interface IHost
{
	int onValue() = default;
	int onTransform(int value, delegate int(int value) transform) = default;
}

export escaped class Widget
{
	IHost* host;

	export void setHost(escaped IHost* host)
	{
		this.host = host;
	}

	export int read()
	{
		if (this.host != null && this.host.onValue.call != null)
			return this.host.onValue();
		return 0;
	}

	export int transform(int value)
	{
		if (this.host != null && this.host.onTransform.call != null)
			return this.host.onTransform(value, current => current + this.read());
		return value;
	}
}
