constof(source) int* firstElement(const int[] source)
{
	return source.elements;
}

void assignStorage(const int[] source, int* mutablePtr, const int* constPtr, out int total)
{
	constof(source) int* fromMutable = mutablePtr;
	const int* widened = fromMutable;
	constof(source) int* fromSameAnchor = firstElement(source);
	constof(source) int* fromCast = (constof(source) int*)constPtr;
	int* explicitlyMutable = (int*)fromSameAnchor;
	auto common = true ? fromSameAnchor : constPtr;
	const int* commonConst = common;

	total = *fromMutable
		+ *widened
		+ *fromSameAnchor
		+ *fromCast
		+ *explicitlyMutable
		+ *commonConst;
}

export int main()
{
	int[] values = [10, 20, 30];
	int fallback = 5;
	int total = 0;
	assignStorage(values, &values[1], &fallback, out total);
	return total == 75 ? 0 : 1;
}
