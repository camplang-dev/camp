const char[] trimTo(const char* value, nuint length)
{
	return { value, length };
}

int acceptSpan(const char[] value)
{
	return value.length == 5 ? 0 : 5;
}

int compareInt(void* context, in int left, in int right)
{
	if (left < right)
		return -1;
	if (left > right)
		return 1;
	return 0;
}

export int main()
{
	const char* raw = "hello";
	const char[] span = { raw, 3 };
	if (span.length != 3 || span[0] != 'h')
		return 1;

	const char[] named = { .length = 2, .elements = raw };
	if (named.length != 2 || named[1] != 'e')
		return 2;

	const char[] returned = trimTo(raw, 4);
	if (returned.length != 4)
		return 3;

	int? maybe = { 42, true };
	if (!maybe.specified || maybe.value != 42)
		return 4;

	delegate int(in int, in int) comparer = { compareInt, null };
	int left = 1;
	int right = 2;
	if (comparer(left, right) >= 0)
		return 5;

	return acceptSpan({ raw, 5 });
}
