struct iter byte chunks()
{
	fixed byte[4] scratch = [1, 2, 3, 4];
	yield scratch[0];
	scratch[0] = 5;
	yield scratch[1];
}

export int main()
{
	int total = 0;
	chunksIter iterator = chunks();
	byte value = 0;
	while (chunksIter_next(&iterator, &value))
	{
		total += (int)value;
	}
	delete iterator;
	return total;
}
