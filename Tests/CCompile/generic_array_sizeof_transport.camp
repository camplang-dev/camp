nint binarySearch<T: any>(const T[] values, in T value, delegate int(in T left, in T right) compare, sizeof(T))
{
	nuint low = 0;
	nuint high = values.length;

	while (low < high)
	{
		nuint mid = low + ((high - low) / 2);
		int order = compare(values[mid], value);

		if (order < 0)
		{
			low = mid + 1;
		}
		else if (order > 0)
		{
			high = mid;
		}
		else
		{
			return (nint)mid;
		}
	}

	return -1;
}

int compareInt(in int left, in int right)
{
	if (left < right)
		return -1;
	if (left > right)
		return 1;
	return 0;
}

export int main()
{
	int[] values = [1, 3, 5, 7];
	int needle = 5;
	return (int)binarySearch<int>(values, needle, compareInt);
}
