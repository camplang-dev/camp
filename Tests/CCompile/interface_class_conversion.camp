extern void* malloc(nuint size);
extern void free(void* ptr);

interface IValue
{
	int value();
}

class Counter: IValue
{
	int count;

	Counter(int count = 0)
	{
		this.count = count;
	}

	int value()
	{
		return this.count;
	}
}

int readValue(IValue* counter)
{
	return counter.value();
}

IValue* asValue(Counter* counter)
{
	return counter;
}

int main()
{
	auto c = new Counter(10);
	int v = readValue(c);
	IValue* assigned = c;
	v += readValue(assigned);
	v += readValue((IValue*)c);
	v += readValue(asValue(c));
	delete c;
	return v - 40;
}
