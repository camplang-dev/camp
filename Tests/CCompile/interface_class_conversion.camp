extern void* malloc(nuint size);
extern void free(void* ptr);

interface IValue
{
	int value();
	int transform(int input, delegate int(int value) apply);
}

class Counter: IValue
{
	int count;

	Counter(int count = 0)
	{
		this.count = count;
	}

	int value()
	{
		return this.count;
	}

	int transform(int input, delegate int(int value) apply)
	{
		return apply(input + this.count);
	}
}

int readValue(IValue* counter)
{
	return counter.value();
}

int readTransformed(IValue* counter)
{
	return counter.transform(5, value => value + 1);
}

IValue* asValue(Counter* counter)
{
	return counter;
}

int main()
{
	auto c = new Counter(10);
	int v = readValue(c);
	IValue* assigned = c;
	v += readValue(assigned);
	v += readValue((IValue*)c);
	v += readValue(asValue(c));
	v += readTransformed(c);
	delete c;
	return v - 56;
}
