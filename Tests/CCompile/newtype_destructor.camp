export int destroyed;

export newtype Handle: nint
{
	export ~Handle()
	{
		destroyed = (int)(nint)this;
	}
	
	export int value() => (int)(nint)this;
}

export int main()
{
	Handle handle = (Handle)42;
	
	if (handle.value() != 42)
		return 1;
	
	delete handle;
	if (destroyed != 42)
		return 2;
	
	Handle* pointer = &handle;
	delete *pointer;
	if (destroyed != 42)
		return 3;
	
	return 0;
}
