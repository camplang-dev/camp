extern void* malloc(nuint size);
extern void free(void* ptr);

class iter int range(int first, int last)
{
	for (int i = first; i <= last; i++)
		yield i;
}

struct iter int applyPredicate(iter int inner, fn bool(int) predicate)
{
	foreach (int value in inner)
	{
		if (predicate(value))
			yield value;
	}
}

struct iter int applyPredicateExplicit(iter int inner, fn bool(int) predicate)
{
	int value = 0;
	finally inner(null);
	while (inner(&value))
	{
		if (predicate(value))
			yield value;
	}
}

bool isEven(int number) => number % 2 == 0;

export void run()
{
	foreach (auto number1 in applyPredicate(range(2, 10), isEven))
	{
	}

	foreach (auto number2 in applyPredicateExplicit(range(22, 30), isEven))
	{
	}
}
