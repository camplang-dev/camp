extern escaped void* malloc(nuint size);
extern void free(escaped void* ptr);

enum Err
{
	ERR_OK = 0,
	ERR_BAD
}

void fail(thrown Err error)
{
	throw Err.ERR_BAD;
}

escaped delegate int(int) makeBlockAdder(int offset)
{
	return (int value) =>
	{
		int doubled = value * 2;
		try
		{
			return doubled + offset;
		}
		finally
		{
			int ignored = doubled;
		}
	};
}

escaped delegate nuint() makeSpanLength(escaped const char[] span)
{
	return () => span.length;
}

class Box
{
	int value;

	int add(escaped this, int amount)
	{
		return this.value + amount;
	}
}

nuint countWhere<T: copyable>(T[] this, escaped delegate bool(in T item) predicate, sizeof(T))
{
	nuint count = 0;
	for (nuint i = 0; i < this.length; i++)
	{
		if (predicate(this[i]))
			count++;
	}
	return count;
}

struct iter int filter(int[] this, escaped delegate bool(in int item) predicate)
{
	for (nuint i = 0; i < this.length; i++)
	{
		int item = this[i];
		if (predicate(item))
			yield item;
	}
}

int invoke(escaped delegate int(int) callback, int value)
{
	return callback(value);
}

int invoke0(escaped delegate int() callback)
{
	return callback();
}

export int main()
{
	auto adder = makeBlockAdder(3);
	int total = adder(7);
	delete adder.context;

	auto length = makeSpanLength({ "hello", 5 });
	total = total + (int)length();
	delete length.context;

	auto box = new Box();
	box.value = 20;
	total = total + invoke(box.add, 2);
	delete box;

	int threshold = 2;
	auto values = [1, 2, 3, 4];
	total = total + (int)values.countWhere(item => item > threshold);

	foreach (auto item in values.filter(item => item > threshold))
		total = total + item;

	try
	{
		fail();
	}
	catch (Err e)
	{
		total = total + invoke0(() => e == Err.ERR_BAD ? 5 : 0);
	}

	return total == 58 ? 0 : 1;
}
