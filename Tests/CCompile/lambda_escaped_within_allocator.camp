extern escaped void* malloc(nuint size);
extern void free(escaped void* ptr);

class Arena
{
	escaped void* alloc(nuint size)
	{
		return malloc(size);
	}

	void free(escaped void* ptr)
	{
		free(ptr);
	}
}

class Box
{
	int value;
}

escaped delegate int() make(escaped Arena* arena, int value)
{
	return within (arena) new delegate () =>
	{
		int result = value;
		delete delegate;
		return result;
	};
}

escaped delegate int() makeWithBodyAllocation(escaped Arena* arena, int value)
{
	return within (arena) new delegate () =>
	{
		auto copied = new Box();
		copied.value = value;
		int result = copied.value;
		delete copied;
		delete delegate;
		return result;
	};
}

void use(escaped Arena* arena)
{
	auto callback = make(arena, 5);
	callback();
	auto allocating = makeWithBodyAllocation(arena, 6);
	allocating();
}
