internal struct InternalValue
{
	int value;

	internal int getValue()
	{
		return this.value;
	}
}

export struct ExportedValue
{
	int value;

	export int getValue()
	{
		return this.value;
	}

	internal int getHiddenValue()
	{
		return this.value + publicOffset;
	}
}

internal int publicOffset = 7;
export int exportedOffset = 11;

internal int internalAdd(InternalValue* value)
{
	return value.getValue() + publicOffset;
}

export int exportedAdd(ExportedValue* value)
{
	return value.getValue() + value.getHiddenValue() + exportedOffset;
}

export int run()
{
	InternalValue internal = { .value = 3 };
	ExportedValue exported = { .value = 5 };
	return internalAdd(&internal) + exportedAdd(&exported);
}
