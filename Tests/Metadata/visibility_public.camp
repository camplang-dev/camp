// @emit-metadata public
namespace Docs;

/// Exported value.
export int ExportedValue;

/// Public helper.
internal int PublicValue;

/// Private helper.
int PrivateValue;

/// Exported class.
export abstract class ExportedClass
{
	/// Included in internal metadata.
	int exportedClassField;
}

/// Public class.
internal abstract class PublicClass
{
	/// Included in internal metadata.
	int publicClassField;
}

/// Private class.
abstract class PrivateClass
{
	/// Omitted from internal metadata.
	int privateClassField;
}
