// @emit-metadata public
namespace Docs;

/// Exported value.
export int ExportedValue;

/// Public helper.
public int PublicValue;

/// Private helper.
int PrivateValue;

/// Exported class.
export abstract class ExportedClass
{
	/// Included in public metadata.
	int exportedClassField;
}

/// Public class.
public abstract class PublicClass
{
	/// Included in public metadata.
	int publicClassField;
}

/// Private class.
abstract class PrivateClass
{
	/// Omitted from public metadata.
	int privateClassField;
}
