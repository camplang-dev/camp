// @emit-metadata all
namespace Docs;

/// Exported value.
export int ExportedValue;

/// Artifact-public value.
public int PublicValue;

/// Internal value.
internal int InternalValue;

/// File-local value.
int LocalValue;

/// Exported class.
export abstract class ExportedClass
{
	/// Exported class field.
	int exportedClassField;
}

/// Artifact-public class.
public abstract class PublicClass
{
	/// Artifact-public class field.
	int publicClassField;
}

/// Internal class.
internal abstract class InternalClass
{
	/// Internal class field.
	int internalClassField;
}

/// File-local class.
abstract class LocalClass
{
	/// File-local class field.
	int localClassField;
}
