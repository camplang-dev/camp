export as Docs;

/// A sample exported type.
export struct Widget
{
	/// Stored count.
	int count;

	/// Gets the count.
	int getCount() => this.count;

	/// Sets the count.
	void setCount(int value)
	{
		this.count = value;
	}

	/// Gets a value by index.
	/// - index: The value index.
	nuint getAt(nuint index) => index;
}

/// Example mode values.
export enum Mode
{
	/// First mode.
	First = 4,
	/// Second mode.
	Second,
	/// Combined mode.
	Combined = 12
}

/// Exported class layout.
export abstract class ExportedClass
{
	/// Hidden in export metadata.
	int hiddenField;
}

/// Finds [Widget] values.
///
/// - T: Element type.
/// - this: Values to search.
/// - value: Value to find.
/// - start: First index to search.
/// - count: Number of values to inspect.
/// @returns The matching index, or -1.
export extern nint find<T: any>(
	const T[] this,
	in T value,
	@range nuint start = 0,
	nuint count = ^0,
	sizeof(T));
