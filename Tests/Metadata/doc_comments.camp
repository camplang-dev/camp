export as Docs;

extern void* malloc(nuint size);
extern void free(void* ptr);

/// Function callback.
export newtype fn _cdecl int Callback(int value);

/// Formatter callback.
export newtype delegate nuint Formatter(char[] buffer = default);

/// Reader callback.
export newtype iter int Reader();

/// Handle value.
export newtype Handle: nint;

/// A sample exported type.
export struct Widget
{
	/// Stored count.
	int count;

	/// Gets the count.
	int getCount() => this.count;

	/// Sets the count.
	void setCount(int value)
	{
		this.count = value;
	}

	/// Gets a value by index.
	/// - index: The value index.
	nuint getAt(nuint index) => index;
}

/// Child target container.
/// - value: Value field docs.
/// - getValue: Value getter docs.
export struct ChildTargets
{
	int value;
	int getValue() => this.value;
}

/// Example mode values.
/// - First: First child-target mode.
/// - Second: Second child-target mode.
export enum Mode
{
	First = 4,
	Second,
	/// Combined mode.
	Combined = 12
}

/// Exported class layout.
export abstract class ExportedClass
{
	/// Hidden in export metadata.
	int hiddenField;

	/// Abstract method.
	export abstract void run();

	/// Static method.
	export static int getDefault() => 0;
}

/// Drawable interface.
export interface Drawable
{
	void draw();
}

/// Drawable struct.
export struct Shape : Drawable
{
	void draw()
	{
	}
}

/// Clickable interface.
export interface Clickable
{
	void click();
}

/// Exported concrete button.
export class Button : Clickable
{
	/// Hidden in export metadata.
	int state;

	void click()
	{
	}
}

/// Widget alias.
export alias WidgetAlias = Widget;

/// Primitive alias.
export alias IntAlias = int;

/// Callable alias.
export alias HelperAlias = helper;

/// Helper function.
export extern void helper();

/// Uses `[NotALink]`, `@summary`, `- value:`, and `%s`.
/// @example
/// ```camp
/// /// [NotASymbol]
/// printf("%s", text);
/// ```
export extern void literalDocs();

/// Finds [Widget] values.
///
/// - T: Element type.
/// - this: Values to search.
/// - value: Value to find.
/// - start: First index to search.
/// - count: Number of values to inspect.
/// @returns The matching index, or -1.
export extern nint find<T: any>(
	const T[] this,
	in T value,
	@range nuint start = 0,
	nuint count = ^0,
	sizeof(T));
