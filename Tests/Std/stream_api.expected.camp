using Std;

export extern fn bool(void*, nuint*, byte*, nuint) getWriter(out void* result_context);
export void writeSample(fn bool(void*, nuint*, char*, nuint) writer, void* writer_context, thrown IoError error)
{
	CharWriter_writeLine(writer, writer_context, "sample", 6, catch error);
	if (error != default)
		return;
}
